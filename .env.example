# Clerk: obtain these from the Clerk Dashboard. The secret is a Worker secret
# in deployed environments (`wrangler secret put CLERK_SECRET_KEY`), not a
# committed `wrangler.jsonc` variable.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional Clerk routing overrides for a custom/satellite domain.
# PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Existing AI configuration remains a Worker secret in production.
OPENROUTER_MODEL=openrouter/auto
