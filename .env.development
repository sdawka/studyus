# Dev-only environment. Vite loads .env.[mode]; `astro dev` runs in
# development mode and `astro build` runs in production, so anything here is
# automatically absent from a production build.
#
# Docs annotation overlay (TEMPORARY — see docs/product/annotations.md).
# Set to 'true' to render the toggle button + overlay island. Unset/false ships
# nothing: the guard folds to false at build time and the island is tree-shaken.
PUBLIC_DOCS_OVERLAY=true
