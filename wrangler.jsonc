{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyus",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studyus",
      "database_id": "e98f7951-5b81-43a1-a8f4-4ace7bf56778",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "studyus-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEARNER_AGENT",
        "class_name": "LearnerAgent"
      }
    ]
  },
  "exports": {
    "LearnerAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "OPENROUTER_MODEL": "openrouter/auto"
  },
  "observability": {
    "traces": {
      "enabled": true
    }
  }
}
