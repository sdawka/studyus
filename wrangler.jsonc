{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyus",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studyus",
      "database_id": "e98f7951-5b81-43a1-a8f4-4ace7bf56778",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "studyus-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEARNER_AGENT",
        "class_name": "LearnerAgent"
      }
    ]
  },
  "exports": {
    "LearnerAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "OPENROUTER_MODEL": "openrouter/auto",
    "AI_FEATURES_ENABLED": "false",
    "ANALYTICS_ENABLED": "true",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "observability": {
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "staging.studyus.app",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studyus-staging",
          "database_id": "3fa2bcce-5f22-4f5f-b51b-e57dc394d36b",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "studyus-staging-uploads"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LEARNER_AGENT",
            "class_name": "LearnerAgent"
          }
        ]
      },
      "vars": {
        "OPENROUTER_MODEL": "openrouter/auto",
        "AI_FEATURES_ENABLED": "false",
        "ANALYTICS_ENABLED": "true",
        "POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "observability": {
        "traces": {
          "enabled": false
        }
      },
      "triggers": {
        "crons": []
      },
      "ratelimits": [
        {
          "name": "DEMO_INGEST_LIMITER",
          "namespace_id": "2026090702",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    },
    "agent-e2e": {
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studyus-agent-e2e",
          "database_id": "93a381d0-53dc-4101-b9b1-3c41ec1950c6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "studyus-agent-e2e-uploads"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LEARNER_AGENT",
            "class_name": "LearnerAgent"
          }
        ]
      },
      "vars": {
        "OPENROUTER_MODEL": "openrouter/auto",
        "AI_FEATURES_ENABLED": "false",
        "ANALYTICS_ENABLED": "false",
        "POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "observability": {
        "traces": {
          "enabled": false
        }
      },
      "triggers": {
        "crons": []
      },
      "ratelimits": [
        {
          "name": "DEMO_INGEST_LIMITER",
          "namespace_id": "2026090702",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ]
    }
  },
  "ratelimits": [
    {
      "name": "DEMO_INGEST_LIMITER",
      "namespace_id": "2026090701",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
