{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyus",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studyus",
      "database_id": "e98f7951-5b81-43a1-a8f4-4ace7bf56778",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "studyus-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LEARNER_AGENT",
        "class_name": "LearnerAgent"
      }
    ]
  },
  "exports": {
    "LearnerAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "OPENROUTER_MODEL": "openrouter/auto",
    "AI_FEATURES_ENABLED": "true",
    "ANALYTICS_ENABLED": "true",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "observability": {
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "staging": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "staging.studyus.app",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "studyus-staging",
          "database_id": "3fa2bcce-5f22-4f5f-b51b-e57dc394d36b",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "UPLOADS",
          "bucket_name": "studyus-staging-uploads"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "LEARNER_AGENT",
            "class_name": "LearnerAgent"
          }
        ]
      },
      "vars": {
        "OPENROUTER_MODEL": "openrouter/auto",
        "AI_FEATURES_ENABLED": "false",
        "ANALYTICS_ENABLED": "true",
        "POSTHOG_HOST": "https://us.i.posthog.com"
      },
      "observability": {
        "traces": {
          "enabled": true
        }
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
