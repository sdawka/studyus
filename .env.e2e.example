# Copy this file to .env.e2e.local. Use keys from a Clerk development
# instance only; the test harness rejects production keys.
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# A stable dedicated user. Clerk reserves +clerk_test for automated tests.
E2E_CLERK_USER_EMAIL=student+clerk_test@example.com

# Must match scripts/seed.ts. Override E2E_SEED_USER_ID only if the local
# fixture uses a nonstandard ID.
E2E_SEED_USER_EMAIL=student@example.com
# E2E_SEED_USER_ID=
# E2E_CLERK_USER_PASSWORD=Studyus-E2E-2026!
