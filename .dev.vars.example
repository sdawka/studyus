OPENROUTER_API_KEY=
# Behavioral analytics is enabled in wrangler.jsonc. Local delivery still requires
# a PostHog project token and the developer-user exclusion below.
POSTHOG_PROJECT_TOKEN=
# Comma-separated local users.id values; never Clerk ids or email addresses.
ANALYTICS_EXCLUDED_USER_IDS=
SEED_USER_EMAIL=student@example.com
SEED_USER_PASSWORD=studyus
