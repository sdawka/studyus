---
import { daysUntil, deadlineUrgency, formatShortDate } from '../../lib/plannerDates';

interface DueItem {
  id: string;
  title: string;
  dueDate: number;
  courseCode: string | null;
  courseHue: number | null;
}
interface Props {
  items: DueItem[];
}
const { items } = Astro.props;
const now = new Date();
---

<section class="card">
  <div class="card-head">
    <h2>Deadlines</h2>
    <a class="link-more" href="/planner">Plan a session →</a>
  </div>
  {items.length === 0 ? (
    <p class="empty">No deadlines coming up.</p>
  ) : (
    <div class="task-list">
      {items.map((item) => {
        const days = daysUntil(item.dueDate, now);
        const u = deadlineUrgency(days);
        return (
          <div class="task-row">
            <span class="task-dot" style={`--course-h:${item.courseHue ?? 220}`}></span>
            <span class="task-body">
              <span class="task-title">{item.title}</span>
              <span class="task-meta">{item.courseCode ? `${item.courseCode} · ` : ''}{formatShortDate(item.dueDate)}</span>
            </span>
            <span class={`pill ${u.cls}`}>{u.label}</span>
          </div>
        );
      })}
    </div>
  )}
</section>

<style>
  .link-more {
    font-size: 12.5px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 560;
    white-space: nowrap;
  }
  .link-more:hover {
    color: var(--accent-ink);
  }
  .task-list {
    display: grid;
    /* Same invariant as TodayTasks' .rows: without minmax(0,1fr) the implicit
       auto track grows to the widest row's max-content and overflows the rail
       instead of ellipsizing titles. */
    grid-template-columns: minmax(0, 1fr);
  }
  .task-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 4px;
    border-bottom: 1px solid var(--hairline);
  }
  .task-row:last-child {
    border-bottom: none;
  }
  .task-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--course);
    flex-shrink: 0;
  }
  .task-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .task-title {
    font-weight: 560;
    font-size: 14px;
  }
  .task-meta {
    font-size: 12px;
    color: var(--muted);
    margin-top: 1px;
  }
</style>
