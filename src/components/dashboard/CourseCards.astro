---
import { hueFor } from '../../lib/courseHue';

interface CourseCardData {
  id: string;
  slug: string;
  code: string;
  title: string;
  color: string | null;
  weightedGrade: number | null;
  openTasks: number;
  nextDueLabel: string | null;
}
interface Props {
  courses: CourseCardData[];
}
const { courses } = Astro.props;
---

<section class="card">
  <div class="card-head">
    <h2>Your courses</h2>
  </div>
  {courses.length === 0 ? (
    <p class="empty">No courses yet.</p>
  ) : (
    <div class="course-grid">
      {courses.map((c) => {
        const hue = hueFor(c);
        return (
          <a class="course-card" href={`/courses/${c.slug}`} style={`--course-h:${hue}`}>
            <div class="head">
              <div class="ident">
                <span class="code">{c.code}</span>
                <span class="title card-title">{c.title}</span>
              </div>
              {c.weightedGrade !== null && <span class="pill pill-idle grade-pill num">{c.weightedGrade}%</span>}
            </div>

            <p class="meta">
              {c.openTasks} task{c.openTasks === 1 ? '' : 's'} open
              {c.nextDueLabel ? ` · next due ${c.nextDueLabel}` : ''}
            </p>
          </a>
        );
      })}
    </div>
  )}
</section>

<style>
  .course-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: var(--space-3, 12px);
  }
  .course-card {
    border: 1px solid var(--hairline);
    border-top: 4px solid var(--course);
    border-radius: var(--radius-md);
    padding: var(--space-4, 14px);
    background: var(--surface-2);
    text-decoration: none;
    color: var(--text);
    display: grid;
    gap: var(--space-3, 12px);
    transition: box-shadow var(--motion-base, 0.15s) var(--ease), transform var(--motion-base, 0.15s) var(--ease);
  }
  .course-card:hover {
    box-shadow: var(--shadow-pop);
    transform: translateY(-1px);
  }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-2, 8px);
    /* .head is itself a grid item of .course-card; without this, its
       default min-width:auto lets the nowrap title's content size grow
       the row past the card's actual (fixed) track width. */
    min-width: 0;
  }
  /* The grade pill is fixed-content — it must never shrink to make room;
     all shrink pressure in .head goes to .ident so the title truncates
     instead of squeezing or clipping the pill. */
  .grade-pill {
    flex-shrink: 0;
  }
  .ident {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .code {
    font: 650 10.5px/1 var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--course-ink);
  }
  .title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .meta {
    font-size: 12px;
    color: var(--muted);
  }

  /* PHONE — main content-box ≤ 480px. Swaps the grid for a horizontal
     snap row: grid-auto-columns min(260px, 82%) leaves an intentional
     next-card peek as the scroll affordance instead of a hard-cropped
     edge. */
  @container (max-width: 480px) {
    .course-grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(260px, 82%);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 4px;
    }
    .course-card {
      scroll-snap-align: start;
    }
  }
</style>
