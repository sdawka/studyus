---
// Closing handoff: the same ranked concept produced by the study loop arrives
// here as a concrete action. Scroll peels away lower-priority cards and leaves
// one tappable next move; reduced motion renders the resolved stack.
---
<section class="final rd-section">
  <!-- Decorative floating sparkle cluster. Entirely aria-hidden, CSS-only. -->
  <div class="final-stickers" aria-hidden="true">
    <span class="fs fs-star-big" style="--dur: 5.2s; --delay: 0s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 2C53.5 33 67 46.5 98 50C67 53.5 53.5 67 50 98C46.5 67 33 53.5 2 50C33 46.5 46.5 33 50 2Z"/>
      </svg>
    </span>
    <span class="fs fs-star-sm" style="--dur: 4.4s; --delay: 0.6s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 6C53 34 66 47 94 50C66 53 53 66 50 94C47 66 34 53 6 50C34 47 47 34 50 6Z"/>
      </svg>
    </span>
    <span class="fs fs-plus" style="--dur: 6s; --delay: 0.3s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 4L58 42L96 50L58 58L50 96L42 58L4 50L42 42Z"/>
      </svg>
    </span>
    <span class="fs fs-plus-sm" style="--dur: 4.9s; --delay: 1s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 4L58 42L96 50L58 58L50 96L42 58L4 50L42 42Z"/>
      </svg>
    </span>
  </div>

  <div class="rd-container final-inner" data-reveal="scale">
    <div class="final-handoff" data-final-handoff data-reveal-item aria-hidden="true">
      <div class="handoff-card handoff-card--back" data-handoff-card="back">
        <span>ECON 210</span><strong>Price elasticity</strong><small>on track</small>
      </div>
      <div class="handoff-card handoff-card--mid" data-handoff-card="mid">
        <span>CS 301</span><strong>B-tree balancing</strong><small>stale · 9d</small>
      </div>
      <div class="handoff-card handoff-card--next rd-interactive" data-handoff-card="next" data-tilt-card data-topic-cycle data-topic-offset="4">
        <span class="handoff-rank">Open next</span>
        <div><small data-topic-field="courseShort">PSYC 305</small><strong data-topic-field="topic">Working-memory interference</strong></div>
        <span class="handoff-go">Begin <b>→</b></span>
      </div>
    </div>
    <div class="final-flourish" aria-hidden="true">
      <svg viewBox="0 0 180 26" width="180" height="26" role="presentation">
        <defs>
          <linearGradient id="final-flourish-grad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--rd-accent)" />
            <stop offset=".5" stop-color="var(--rd-grape)" />
            <stop offset="1" stop-color="var(--rd-spring)" />
          </linearGradient>
        </defs>
        <path data-final-flourish d="M4 20C28 4 46 4 66 16C86 28 106 6 128 10C146 13 160 8 176 14" />
      </svg>
    </div>
    <h2 class="final-title rd-h2" data-reveal-item>
      Open the right thing <span class="rd-em">next.</span><br />Every study day.
    </h2>
    <p class="final-reassure" data-reveal-item>
      Free to start. No credit card. No guilt mechanics.
    </p>
    <div class="final-ctas" data-reveal-item>
      <a class="rd-btn rd-btn-primary" href="/try">Try Studyus</a>
      <a class="rd-btn rd-btn-ghost" href="/sign-up">
        Create an account
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: clip;
    text-align: center;
    padding-block: clamp(72px, 13vw, 148px);
  }
  .final-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .final-handoff {
    position: relative;
    width: min(92vw, 560px);
    height: clamp(168px, 24vw, 214px);
    margin-bottom: clamp(30px, 5vw, 56px);
    perspective: 1200px;
  }
  .final-flourish {
    width: 180px;
    height: 26px;
    margin: 0 auto clamp(10px, 1.6vw, 18px);
  }
  .final-flourish svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .final-flourish path { fill: none; stroke: url(#final-flourish-grad); stroke-width: 5; stroke-linecap: round; }
  .handoff-card {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(88%, 440px);
    min-height: 96px;
    padding: 18px 20px;
    border-radius: var(--rd-r-md);
    background: oklch(99.5% 0.006 90);
    border: 1.5px solid oklch(52% 0.06 305 / 0.16);
    box-shadow: var(--rd-shadow-card);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    transform-origin: 50% 100%;
  }
  .handoff-card--back { transform: translateX(-50%) translateY(-58px) rotate(-7deg) scale(.88); opacity: .5; }
  .handoff-card--mid { transform: translateX(-50%) translateY(-30px) rotate(5deg) scale(.94); opacity: .72; }
  .handoff-card--next {
    transform: translateX(-50%);
    border: 2px solid var(--rd-accent);
    box-shadow: var(--rd-shadow-pop), 0 22px 54px -24px oklch(52% .2 2 / .65);
  }
  .handoff-card > span:first-child:not(.handoff-rank),
  .handoff-card > small { font-size: 10px; font-weight: 900; color: var(--rd-ink-faint); text-transform: uppercase; }
  .handoff-card > strong { font-family: var(--rd-display); font-size: 18px; }
  .handoff-rank { padding: 6px 10px; border-radius: 999px; color: var(--rd-on-accent); background: var(--rd-accent); font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .handoff-card--next div { display: flex; flex-direction: column; text-align: left; min-width: 0; }
  .handoff-card--next div small { color: var(--rd-ink-faint); font-size: 10px; font-weight: 900; letter-spacing: .08em; }
  .handoff-card--next div strong { font-family: var(--rd-display); font-size: clamp(18px, 2.4vw, 23px); line-height: 1.05; }
  .handoff-go { color: var(--rd-accent-deep); font-size: 12px; font-weight: 900; white-space: nowrap; }
  .handoff-go b { display: inline-block; font-size: 18px; margin-left: 3px; }
  .final-title {
    /* the biggest, most confident headline on the page */
    font-size: clamp(38px, 6.6vw, 76px);
    max-width: 16ch;
    text-wrap: balance;
  }
  .final-reassure {
    margin: 24px 0 0;
    font-family: var(--rd-body);
    font-weight: 700;
    font-size: clamp(15px, 1.6vw, 17px);
    color: var(--rd-ink-soft);
  }
  .final-ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .final-ctas .arrow {
    transition: transform 0.24s var(--rd-ease-bounce);
  }
  .final-ctas .rd-btn-ghost:hover .arrow {
    transform: translateX(4px);
  }
  .final-ctas .rd-btn-primary {
    transition: transform .28s var(--rd-ease-bounce), box-shadow .28s ease;
  }
  .final-ctas .rd-btn-primary:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 18px 34px -14px oklch(52% .2 2 / .55);
  }
  .final-ctas .rd-btn-primary:active {
    transform: translateY(-1px) scale(.98);
    box-shadow: 0 8px 18px -10px oklch(52% .2 2 / .5);
    transition-duration: .12s;
  }

  /* ============ floating candy sparkles ============ */
  .final-stickers {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .fs {
    position: absolute;
    display: grid;
    place-items: center;
    animation: fs-float var(--dur, 5s) ease-in-out var(--delay, 0s) infinite alternate;
  }
  .fs svg { display: block; }
  .fs-star-big {
    width: clamp(46px, 6vw, 78px);
    aspect-ratio: 1;
    top: 14%;
    left: 8%;
    filter: drop-shadow(0 10px 16px oklch(52% 0.2 2 / 0.32));
  }
  .fs-star-big path { fill: var(--rd-accent); }
  .fs-star-sm {
    width: clamp(24px, 3vw, 40px);
    aspect-ratio: 1;
    top: 22%;
    right: 12%;
    filter: drop-shadow(0 8px 12px oklch(70% 0.15 55 / 0.4));
  }
  .fs-star-sm path { fill: var(--rd-tangerine); }
  .fs-plus {
    width: clamp(28px, 3.6vw, 48px);
    aspect-ratio: 1;
    bottom: 16%;
    right: 16%;
    filter: drop-shadow(0 8px 12px oklch(70% 0.14 155 / 0.4));
  }
  .fs-plus path { fill: var(--rd-spring); }
  .fs-plus-sm {
    width: clamp(20px, 2.6vw, 34px);
    aspect-ratio: 1;
    bottom: 22%;
    left: 14%;
    filter: drop-shadow(0 8px 12px oklch(58% 0.19 300 / 0.34));
  }
  .fs-plus-sm path { fill: var(--rd-grape); }

  @keyframes fs-float {
    from { transform: translateY(6px) rotate(-5deg); }
    to   { transform: translateY(-9px) rotate(5deg); }
  }

  @media (max-width: 560px) {
    .final-ctas { width: 100%; gap: 10px; }
    .final-ctas .rd-btn { width: 100%; justify-content: center; }
    .final-handoff { width: 92%; height: 190px; }
    .handoff-card { width: 96%; padding: 16px; gap: 9px; }
    .handoff-card--back { transform: translateX(-50%) translateY(-50px) rotate(-5deg) scale(.9); }
    .handoff-card--mid { transform: translateX(-50%) translateY(-25px) rotate(4deg) scale(.95); }
    .handoff-rank { display: none; }
    .handoff-go { font-size: 11px; }
    /* pull the sparkles to the corners so they never crowd the copy */
    .fs-star-big { top: 4%; left: 2%; }
    .fs-star-sm { top: 6%; right: 4%; }
    .fs-plus { bottom: 8%; right: 4%; }
    .fs-plus-sm { bottom: 12%; left: 4%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fs { animation: none; }
    .final-ctas .arrow { transition: none; }
    .final-ctas .rd-btn-ghost:hover .arrow { transform: none; }
    .final-ctas .rd-btn-primary { transition: none; }
    .final-ctas .rd-btn-primary:hover,
    .final-ctas .rd-btn-primary:active { transform: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initMarketingMotion, reducedMotion, svgDraw, pointerTilt } from '../../../lib/marketing/motion';

  initMarketingMotion();

  // Both helpers already branch on reducedMotion internally.
  svgDraw('[data-final-flourish]', { start: 'top 82%', duration: .8, ease: 'power2.out' });
  pointerTilt('[data-tilt-card]', { max: 7, scale: 1 });

  if (!reducedMotion) {
    gsap.registerPlugin(ScrollTrigger);
    const handoff = document.querySelector<HTMLElement>('[data-final-handoff]');
    const back = document.querySelector<HTMLElement>('[data-handoff-card="back"]');
    const mid = document.querySelector<HTMLElement>('[data-handoff-card="mid"]');
    const next = document.querySelector<HTMLElement>('[data-handoff-card="next"]');
    if (handoff && back && mid && next) {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: handoff,
          start: 'top 88%',
          end: 'center 48%',
          scrub: 0.55,
        },
      });
      tl.from(back, { xPercent: -90, y: 80, rotation: -24, opacity: 0, duration: .8 }, 0)
        .from(mid, { xPercent: 90, y: 90, rotation: 22, opacity: 0, duration: .8 }, .08)
        .from(next, { y: 150, scale: .68, rotation: -7, opacity: 0, duration: .9, ease: 'back.out(1.6)' }, .16)
        .to(back, { x: -190, y: -80, rotation: -16, opacity: .18, duration: .55 }, .88)
        .to(mid, { x: 190, y: -58, rotation: 14, opacity: .22, duration: .55 }, .9)
        .to(next, { y: -12, scale: 1.06, duration: .48, ease: 'power2.out' }, .94)
        .to('.handoff-go b', { x: 7, repeat: 1, yoyo: true, duration: .16 }, 1.2);
    }
  }
</script>
