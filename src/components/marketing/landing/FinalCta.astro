---
import FlipBook from './FlipBook.astro';
// Landing REDESIGN Phase 2 — the closing call-to-action. The emotional peak:
// a giant Fraunces headline reusing the hero's candy-italic "next." treatment,
// a primary CTA → /login and a secondary → /compare, plus a short reassurance
// line. Floating candy sparkle motifs (inline SVG, aria-hidden, CSS-only gentle
// float) echo the hero. Sits transparent over the .rd mesh, uses --rd-* tokens,
// and the shared `data-reveal` / `data-reveal-item` entrance. No bespoke <script>.
---
<section class="final rd-section">
  <!-- Decorative floating sparkle cluster. Entirely aria-hidden, CSS-only. -->
  <div class="final-stickers" aria-hidden="true">
    <span class="fs fs-star-big" style="--dur: 5.2s; --delay: 0s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 2C53.5 33 67 46.5 98 50C67 53.5 53.5 67 50 98C46.5 67 33 53.5 2 50C33 46.5 46.5 33 50 2Z"/>
      </svg>
    </span>
    <span class="fs fs-star-sm" style="--dur: 4.4s; --delay: 0.6s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 6C53 34 66 47 94 50C66 53 53 66 50 94C47 66 34 53 6 50C34 47 47 34 50 6Z"/>
      </svg>
    </span>
    <span class="fs fs-plus" style="--dur: 6s; --delay: 0.3s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 4L58 42L96 50L58 58L50 96L42 58L4 50L42 42Z"/>
      </svg>
    </span>
    <span class="fs fs-plus-sm" style="--dur: 4.9s; --delay: 1s">
      <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
        <path d="M50 4L58 42L96 50L58 58L50 96L42 58L4 50L42 42Z"/>
      </svg>
    </span>
  </div>

  <div class="rd-container final-inner" data-reveal="scale">
    <div class="final-book" data-reveal-item><FlipBook /></div>
    <h2 class="final-title rd-h2" data-reveal-item>
      Open the right thing <span class="rd-em">next.</span><br />Every study day.
    </h2>
    <p class="final-reassure" data-reveal-item>
      Free to start. No credit card. No streaks to babysit.
    </p>
    <div class="final-ctas" data-reveal-item>
      <a class="rd-btn rd-btn-primary" href="/login">Start studying smarter</a>
      <a class="rd-btn rd-btn-ghost" href="/compare">
        See how it compares
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: clip;
    text-align: center;
    padding-block: clamp(72px, 13vw, 148px);
  }
  .final-inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .final-book { margin-bottom: clamp(22px, 3.4vw, 38px); }
  .final-title {
    /* the biggest, most confident headline on the page */
    font-size: clamp(38px, 6.6vw, 76px);
    max-width: 16ch;
    text-wrap: balance;
  }
  .final-reassure {
    margin: 24px 0 0;
    font-family: var(--rd-body);
    font-weight: 700;
    font-size: clamp(15px, 1.6vw, 17px);
    color: var(--rd-ink-soft);
  }
  .final-ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
  .final-ctas .arrow {
    transition: transform 0.24s var(--rd-ease-bounce);
  }
  .final-ctas .rd-btn-ghost:hover .arrow {
    transform: translateX(4px);
  }

  /* ============ floating candy sparkles ============ */
  .final-stickers {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .fs {
    position: absolute;
    display: grid;
    place-items: center;
    animation: fs-float var(--dur, 5s) ease-in-out var(--delay, 0s) infinite alternate;
  }
  .fs svg { display: block; }
  .fs-star-big {
    width: clamp(46px, 6vw, 78px);
    aspect-ratio: 1;
    top: 14%;
    left: 8%;
    filter: drop-shadow(0 10px 16px oklch(52% 0.2 2 / 0.32));
  }
  .fs-star-big path { fill: var(--rd-accent); }
  .fs-star-sm {
    width: clamp(24px, 3vw, 40px);
    aspect-ratio: 1;
    top: 22%;
    right: 12%;
    filter: drop-shadow(0 8px 12px oklch(70% 0.15 55 / 0.4));
  }
  .fs-star-sm path { fill: var(--rd-tangerine); }
  .fs-plus {
    width: clamp(28px, 3.6vw, 48px);
    aspect-ratio: 1;
    bottom: 16%;
    right: 16%;
    filter: drop-shadow(0 8px 12px oklch(70% 0.14 155 / 0.4));
  }
  .fs-plus path { fill: var(--rd-spring); }
  .fs-plus-sm {
    width: clamp(20px, 2.6vw, 34px);
    aspect-ratio: 1;
    bottom: 22%;
    left: 14%;
    filter: drop-shadow(0 8px 12px oklch(58% 0.19 300 / 0.34));
  }
  .fs-plus-sm path { fill: var(--rd-grape); }

  @keyframes fs-float {
    from { transform: translateY(6px) rotate(-5deg); }
    to   { transform: translateY(-9px) rotate(5deg); }
  }

  @media (max-width: 560px) {
    .final-ctas { width: 100%; gap: 10px; }
    .final-ctas .rd-btn { width: 100%; justify-content: center; }
    /* pull the sparkles to the corners so they never crowd the copy */
    .fs-star-big { top: 4%; left: 2%; }
    .fs-star-sm { top: 6%; right: 4%; }
    .fs-plus { bottom: 8%; right: 4%; }
    .fs-plus-sm { bottom: 12%; left: 4%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fs { animation: none; }
    .final-ctas .arrow { transition: none; }
    .final-ctas .rd-btn-ghost:hover .arrow { transform: none; }
  }
</style>
