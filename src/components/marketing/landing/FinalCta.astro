<section class="final">
  <div class="mk-container final-inner">
    <h2 class="reveal">
      Know what's <span class="mk-highlight">next.</span><br />Every day.
    </h2>
    <p class="reveal" style="--reveal-delay: 80ms">
      Free to start. No credit card, no streak to protect.
    </p>
    <div class="final-ctas reveal" style="--reveal-delay: 140ms">
      <a class="mk-btn mk-btn-primary" href="/login">Get started</a>
      <a class="mk-btn mk-btn-ghost" href="/compare">See how it compares →</a>
    </div>
  </div>
</section>

<style>
  .final {
    padding-block: clamp(64px, 11vw, 128px);
    text-align: center;
  }
  .final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h2 {
    font-size: clamp(34px, 5.4vw, 60px);
  }
  .mk-highlight {
    background: var(--mk-accent-soft);
    color: var(--mk-accent-ink);
    padding: 0 0.14em;
    border-radius: 4px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .final p {
    margin-top: 18px;
    color: var(--mk-muted);
    font-size: 16px;
  }
  .final-ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }
</style>
