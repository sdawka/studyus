---
// Marketing landing REDESIGN — Hero (Phase 1). Premium-playful pastel Y2K.
//
// Sits inside the `.rd` pastel canvas (Landing.astro). Uses the shared token
// system (src/styles/marketing-rd.css) + the shared motion engine
// (src/lib/marketing/motion.ts). Fraunces display / Nunito body come from the
// `.rd` wrapper. All sticker motifs below are hand-authored inline SVG/HTML —
// no external assets.
//
// Motion contract: the <script> imports gsap + ScrollTrigger + SplitText and
// { initMarketingMotion, reducedMotion }. Every hidden pre-animation state is
// set with GSAP `.set()` at the top of the script — NEVER in CSS — so the
// reduced-motion path renders the hero fully visible and static.
---
<section class="hero-rd" data-hero>
  <div class="rd-container hero-rd-inner">
    <!-- Decorative floating sticker cluster. Entirely aria-hidden. -->
    <div class="hero-rd-stickers rd-tilt" aria-hidden="true">
      <!-- soft grape blob, deep behind, bottom-left -->
      <div class="hero-rd-sticker rd-interactive st-blob st-blob-grape" data-rot="-8" data-depth="6">
        <svg viewBox="0 0 200 200" width="100%" height="100%" role="presentation">
          <path d="M46,-59C58,-49,64,-31,67,-13C69,5,66,24,56,38C46,53,29,63,10,68C-9,73,-30,72,-46,62C-62,52,-73,33,-76,13C-79,-8,-72,-30,-59,-45C-46,-60,-27,-68,-7,-70C13,-72,32,-69,46,-59Z" transform="translate(100 100)"/>
        </svg>
      </div>

      <!-- soft mint blob behind the mini-card, top-right -->
      <div class="hero-rd-sticker rd-interactive st-blob st-blob-mint" data-rot="10" data-depth="8">
        <svg viewBox="0 0 200 200" width="100%" height="100%" role="presentation">
          <path d="M52,-63C65,-52,71,-33,72,-15C73,4,67,22,57,38C46,54,30,67,10,72C-11,77,-33,73,-49,61C-66,49,-76,29,-77,9C-78,-11,-70,-32,-56,-44C-42,-57,-21,-62,0,-62C21,-62,39,-73,52,-63Z" transform="translate(100 100)"/>
        </svg>
      </div>

      <!-- big candy 4-point sparkle, top-left -->
      <div class="hero-rd-sticker rd-interactive st-shape st-star-big" data-rot="-12" data-depth="18">
        <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
          <path d="M50 2C53.5 33 67 46.5 98 50C67 53.5 53.5 67 50 98C46.5 67 33 53.5 2 50C33 46.5 46.5 33 50 2Z"/>
        </svg>
      </div>

      <!-- small tangerine sparkle winking beside "next." -->
      <div class="hero-rd-sticker rd-interactive st-shape st-star-sm" data-rot="6" data-depth="26">
        <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
          <path d="M50 6C53 34 66 47 94 50C66 53 53 66 50 94C47 66 34 53 6 50C34 47 47 34 50 6Z"/>
        </svg>
      </div>

      <!-- spring plus-spark, lower-right accent -->
      <div class="hero-rd-sticker rd-interactive st-shape st-plus" data-rot="-4" data-depth="22">
        <svg viewBox="0 0 100 100" width="100%" height="100%" role="presentation">
          <path d="M50 4L58 42L96 50L58 58L50 96L42 58L4 50L42 42Z"/>
        </svg>
      </div>

      <!-- app-chaos chip: calendar -->
      <div class="hero-rd-sticker rd-interactive st-chip st-chip-cal" data-rot="-7" data-depth="14">
        <span class="chip-emoji">📅</span>
        <span class="chip-dot"></span>
      </div>

      <!-- app-chaos chip: group chat -->
      <div class="hero-rd-sticker rd-interactive st-chip st-chip-chat" data-rot="8" data-depth="12">
        <span class="chip-emoji">💬</span>
        <span class="chip-dot"></span>
      </div>

      <!-- the "what's next" mini-card sticker: the product, in a nutshell.
           Also the pointerTilt target — the one surface in the hero you can
           reach out and tip toward you. -->
      <div class="hero-rd-sticker rd-interactive st-card" data-rot="5" data-depth="20" data-tilt-card>
        <span class="card-label">Next up</span>
        <div class="card-row">
          <span class="card-rank">1</span>
          <span class="card-body">
            <span class="card-course">CHEM 220</span>
            <span class="card-topic">Resonance structures</span>
          </span>
          <span class="card-pill-wrap">
            <span class="card-pill">Weak · 38%</span>
            <!-- scroll-drawn annotation circle: the reason this card is "next up" -->
            <svg class="pill-scribble" viewBox="0 0 120 44" preserveAspectRatio="none" aria-hidden="true">
              <path d="M10 22C10 8 30 3 60 3C92 3 112 9 112 22C112 36 90 41 60 41C28 41 10 35 10 22Z" />
            </svg>
          </span>
        </div>
        <span class="card-bar"><span style="--fill: 38%"></span></span>
      </div>
    </div>

    <!-- The actual hero copy, centered over the cluster. -->
    <div class="hero-rd-copy">
      <p class="rd-kicker">
        <span class="kicker-dot" aria-hidden="true"></span>
        For students juggling lectures, deadlines &amp; five apps
      </p>
      <h1 class="hero-rd-title">Know what to study next.<br />Actually <span class="rd-em">remember it.</span></h1>
      <p class="hero-rd-dek">studyus turns weak concepts, stale topics, and real deadlines into one clear next move — so you study the right thing, every time.</p>
      <div class="hero-rd-ctas">
        <a class="rd-btn rd-btn-primary" href="/try">Try studyus in 2 minutes</a>
        <a class="rd-btn rd-btn-ghost" href="/sign-up">Create an account</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-rd {
    position: relative;
    z-index: 2;
    min-height: 94svh;
    display: grid;
    align-items: center;
    padding-block: clamp(84px, 15vh, 168px);
    overflow: clip;
  }
  .hero-rd-inner { position: relative; }

  /* ---- copy: centered, giant, confident ---- */
  .hero-rd-copy {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: min(92vw, 880px);
    margin-inline: auto;
  }
  .rd-kicker .kicker-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }
  .hero-rd-title {
    font-size: clamp(38px, 6.4vw, 84px);
    margin: 20px 0 0;
    max-width: none;
    text-wrap: balance;
  }
  .hero-rd-dek {
    margin: 26px auto 0;
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.5;
    font-weight: 600;
    color: var(--rd-ink-soft);
    max-width: 42ch;
  }
  .hero-rd-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 34px;
  }

  /* Line-mask for the headline word reveal (SplitText adds .split-line). */
  .hero-rd-title :global(.split-line) { overflow: hidden; }

  /* ============ floating sticker cluster ============ */
  .hero-rd-stickers {
    position: absolute;
    inset: -6% -2%;
    z-index: 1;
    pointer-events: none;
  }
  .hero-rd-sticker {
    position: absolute;
  }

  /* soft color blobs — deepest layer, no box, drop-shadow tint */
  .st-blob {
    box-shadow: none;
    filter: blur(0.5px) drop-shadow(0 22px 30px oklch(40% 0.1 305 / 0.18));
    opacity: 0.9;
  }
  .st-blob svg { display: block; }
  .st-blob-grape {
    width: clamp(180px, 24vw, 320px);
    aspect-ratio: 1;
    left: -7%;
    bottom: -2%;
  }
  .st-blob-grape path { fill: oklch(88% 0.09 305); }
  .st-blob-mint {
    width: clamp(150px, 20vw, 260px);
    aspect-ratio: 1;
    right: -3%;
    top: -8%;
  }
  .st-blob-mint path { fill: oklch(90% 0.09 165); }

  /* candy sparkle shapes — crisp accents with gummy drop-shadow */
  .st-shape {
    box-shadow: none;
    display: grid;
    place-items: center;
  }
  .st-shape svg { display: block; }
  .st-star-big {
    width: clamp(52px, 7vw, 92px);
    aspect-ratio: 1;
    top: 4%;
    left: 2%;
    filter: drop-shadow(0 10px 16px oklch(52% 0.2 2 / 0.32));
  }
  .st-star-big path { fill: var(--rd-accent); }
  .st-star-sm {
    width: clamp(26px, 3.4vw, 44px);
    aspect-ratio: 1;
    top: 34%;
    right: 12%;
    filter: drop-shadow(0 8px 12px oklch(70% 0.15 55 / 0.4));
  }
  .st-star-sm path { fill: var(--rd-tangerine); }
  .st-plus {
    width: clamp(30px, 3.8vw, 50px);
    aspect-ratio: 1;
    bottom: 12%;
    right: 24%;
    filter: drop-shadow(0 8px 12px oklch(70% 0.14 155 / 0.4));
  }
  .st-plus path { fill: var(--rd-spring); }

  /* app-chaos chips — tilted white rounded squares holding an emoji + a
     little candy notification dot (the "five apps buzzing at once" mess) */
  .st-chip {
    width: clamp(52px, 6vw, 68px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: oklch(99% 0.005 90);
    border-radius: var(--rd-r-md);
    box-shadow: var(--rd-shadow-sticker);
    border: 1.5px solid oklch(100% 0 0 / 0.7);
  }
  .st-chip .chip-emoji {
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1;
    filter: saturate(1.05);
  }
  .st-chip .chip-dot {
    position: absolute;
    top: -5px;
    right: -5px;
    width: 15px;
    height: 15px;
    border-radius: 999px;
    background: var(--rd-accent);
    border: 2.5px solid oklch(99% 0.005 90);
  }
  .st-chip-cal { left: 3%; bottom: 16%; }
  .st-chip-chat { right: 2%; bottom: 4%; }
  .st-chip-chat .chip-dot { background: var(--rd-grape); }

  /* the "what's next" product sticker — a real ranked task, in miniature */
  .st-card {
    width: clamp(206px, 22vw, 246px);
    top: -4%;
    right: -2%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 15px 15px;
    background: oklch(99.5% 0.003 90);
    border-radius: var(--rd-r-md);
    border: 1.5px solid oklch(100% 0 0 / 0.75);
    box-shadow: var(--rd-shadow-card);
  }
  .st-card .card-label {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--rd-grape);
  }
  .st-card .card-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
  }
  .st-card .card-rank {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--rd-accent);
    color: var(--rd-on-accent);
    font-family: var(--rd-display);
    font-weight: 600;
    font-size: 15px;
    box-shadow: var(--rd-shadow-pop);
  }
  .st-card .card-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .st-card .card-course {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--rd-ink-faint);
  }
  .st-card .card-topic {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--rd-ink);
    line-height: 1.15;
  }
  .st-card .card-pill-wrap {
    position: relative;
    display: inline-flex;
  }
  .st-card .card-pill {
    font-size: 10px;
    font-weight: 800;
    padding: 3px 7px;
    border-radius: 999px;
    background: oklch(65% 0.2 2 / 0.14);
    color: var(--rd-accent-deep);
    white-space: nowrap;
  }
  /* Scroll-drawn scribble that circles the "why this card" stat. Sized to
     overshoot the pill a little, like a hand-drawn annotation. */
  .st-card .pill-scribble {
    position: absolute;
    inset: -7px -9px;
    width: calc(100% + 18px);
    height: calc(100% + 14px);
    pointer-events: none;
  }
  .st-card .pill-scribble path {
    fill: none;
    stroke: var(--rd-accent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.85;
  }
  .st-card .card-bar {
    display: block;
    height: 5px;
    border-radius: 999px;
    background: oklch(52% 0.06 305 / 0.14);
    overflow: hidden;
  }
  .st-card .card-bar span {
    display: block;
    height: 100%;
    width: var(--fill);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--rd-accent), var(--rd-tangerine));
  }

  /* ============ responsive ============ */
  @media (max-width: 1040px) {
    .st-card { right: -1%; width: clamp(196px, 26vw, 230px); }
    .st-star-sm { right: 8%; }
    .st-plus { right: 20%; }
  }
  @media (max-width: 820px) {
    .hero-rd { min-height: auto; padding-block: clamp(64px, 12vh, 120px); }
    .hero-rd-copy { max-width: min(100%, 680px); }
    .hero-rd-title { max-width: 12ch; margin-inline: auto; }
    /* the crowded product card + chips would collide with copy — drop the
       heavy ones, keep the airy sparkles/blobs for joy */
    .st-card, .st-chip { display: none; }
    .st-blob-grape { left: -18%; bottom: -6%; width: clamp(160px, 40vw, 220px); }
    .st-blob-mint { right: -14%; top: -6%; width: clamp(140px, 36vw, 200px); }
    .st-star-big { top: 2%; left: -1%; }
    .st-star-sm { top: 8%; right: 4%; }
    .st-plus { bottom: 6%; right: 6%; }
  }
  @media (max-width: 480px) {
    .hero-rd-ctas { gap: 10px; }
    .hero-rd-ctas .rd-btn { flex: 1 1 auto; justify-content: center; }
    .st-star-big { width: 44px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  import {
    initMarketingMotion,
    reducedMotion,
    pointerParallax,
    pointerTilt,
    svgDraw,
  } from '../../../lib/marketing/motion';

  initMarketingMotion();

  // Reduced motion: run nothing, set nothing. The markup + CSS above already
  // render the hero fully visible and in final position, so bailing here is the
  // complete static path.
  if (!reducedMotion) {
    gsap.registerPlugin(ScrollTrigger, SplitText);

    const root = document.querySelector<HTMLElement>('[data-hero]');
    if (root) {
      const q = gsap.utils.selector(root);
      const kicker = q('.rd-kicker');
      const title = q('.hero-rd-title')[0] as HTMLElement;
      const dek = q('.hero-rd-dek');
      const ctas = q('.hero-rd-ctas');
      const stickers = q('.hero-rd-sticker');

      const restRot = (_i: number, el: Element) =>
        Number((el as HTMLElement).dataset.rot) || 0;

      // --- pre-animation hidden state (GSAP only, never CSS) ---
      gsap.set([kicker, dek, ctas], { autoAlpha: 0, y: 26 });
      gsap.set(stickers, {
        autoAlpha: 0,
        scale: 0.35,
        rotate: (i, el) => restRot(i, el) * -0.6 - 14,
        transformOrigin: '50% 50%',
      });

      // Split the headline into masked lines of words for a per-word rise.
      const split = new SplitText(title, {
        type: 'lines,words',
        linesClass: 'split-line',
      });
      gsap.set(split.words, { yPercent: 118, rotate: 5 });

      // --- page-load entrance timeline ---
      const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
      tl.to(kicker, { autoAlpha: 1, y: 0, duration: 0.55 })
        .to(
          split.words,
          {
            yPercent: 0,
            rotate: 0,
            duration: 0.9,
            stagger: 0.045,
            ease: 'power4.out',
          },
          '-=0.25'
        )
        .to(dek, { autoAlpha: 1, y: 0, duration: 0.6 }, '-=0.55')
        .to(ctas, { autoAlpha: 1, y: 0, duration: 0.6 }, '-=0.45')
        .to(
          stickers,
          {
            autoAlpha: 1,
            scale: 1,
            rotate: restRot,
            duration: 0.8,
            ease: 'back.out(1.8)',
            stagger: { each: 0.08, from: 'random' },
            onComplete: startAmbient,
          },
          '-=0.55'
        );

      // The "why this card" scribble draws on right after the sticker cluster
      // lands — a hand-drawn circle finishing the thought "this is next up."
      svgDraw('.pill-scribble path', {
        timeline: tl,
        position: '-=0.1',
        duration: 0.55,
        ease: 'power2.out',
      });

      // --- ambient: lively continuous float on each sticker (y + rotate),
      // plus a twinkle (scale pulse) on the candy sparkles. Bigger amplitude
      // than a typical "calm" float — the hero should feel alive. ---
      function startAmbient() {
        stickers.forEach((el, i) => {
          const rest = Number((el as HTMLElement).dataset.rot) || 0;
          gsap.to(el, {
            y: `+=${gsap.utils.random(-26, -12)}`,
            rotate: rest + gsap.utils.random(-7, 7),
            duration: gsap.utils.random(1.9, 3),
            ease: 'sine.inOut',
            yoyo: true,
            repeat: -1,
            delay: i * 0.09,
          });
        });
        // Twinkle the sparkle shapes on their own cadence.
        gsap.utils.toArray<HTMLElement>('.st-shape').forEach((el, i) => {
          gsap.to(el, {
            scale: gsap.utils.random(1.14, 1.26),
            duration: gsap.utils.random(1, 1.6),
            ease: 'sine.inOut',
            yoyo: true,
            repeat: -1,
            delay: i * 0.2,
            transformOrigin: '50% 50%',
          });
        });
      }

      // --- pointer parallax: stickers drift on the x axis by their depth.
      // (x only — ambient owns y/rotate, so the two never fight.) Desktop-only
      // (hover-capable pointers) via the shared helper — no more jitter from
      // touch drags firing pointermove, which the old hand-rolled listener
      // didn't guard against.
      pointerParallax(root, { items: '.hero-rd-sticker', axis: 'x' });

      // --- pointer tilt: the "Next up" mini-card tips toward the pointer,
      // the one surface in the hero that invites a reach. ---
      pointerTilt('[data-tilt-card]', { max: 8, scale: 1.03 });

      // --- scroll parallax: the whole cluster drifts up as the hero leaves ---
      gsap.to('.hero-rd-stickers', {
        y: -70,
        ease: 'none',
        scrollTrigger: {
          trigger: root,
          start: 'top top',
          end: 'bottom top',
          // Smoothed scrub (not `true`): with Lenis, an unsmoothed scrub
          // micro-corrects every frame and reads as a faint vibration. A small
          // catch-up value eases toward the scroll position and kills it.
          scrub: 0.5,
        },
      });
    }
  }
</script>
