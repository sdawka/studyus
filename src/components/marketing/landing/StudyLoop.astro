---
// Signature lower-page scroll story. One pinned scene turns the product's
// learning model into a visible sequence: memory fades, recall restores it,
// spacing stretches retention, and the system concentrates attention on one
// next concept. Desktop scrubs the story; mobile/reduced-motion render every
// beat in readable document flow with the final lab state visible.
---
<section class="study-loop rd-section" data-study-loop aria-labelledby="study-loop-title">
  <div class="loop-runway" data-loop-runway>
    <div class="loop-stage" data-loop-stage>
      <div class="rd-container loop-grid">
        <div class="loop-copy">
          <p class="rd-kicker"><span class="kdot"></span>The study loop</p>
          <div class="loop-beats">
            <article class="loop-beat" data-loop-beat="0">
              <span class="beat-index">01 · Notice</span>
              <h2 id="study-loop-title" class="rd-h2">Memory fades. Studyus <span class="rd-em">notices</span>.</h2>
              <p>Your mastery signal gets quieter as a concept goes stale. Studyus catches the drop before the exam does.</p>
            </article>
            <article class="loop-beat" data-loop-beat="1">
              <span class="beat-index">02 · Retrieve</span>
              <h2 class="rd-h2">A tiny recall brings it <span class="rd-em">back</span>.</h2>
              <p>One well-timed question beats another hour of rereading. The answer is retrieved, not merely recognized.</p>
            </article>
            <article class="loop-beat" data-loop-beat="2">
              <span class="beat-index">03 · Space</span>
              <h2 class="rd-h2">Each return lasts <span class="rd-em">longer</span>.</h2>
              <p>The next check moves from tomorrow to four days to twelve. Less repetition, better timed.</p>
            </article>
            <article class="loop-beat" data-loop-beat="3">
              <span class="beat-index">04 · Focus</span>
              <h2 class="rd-h2">Calendars move blocks. Studyus moves <span class="rd-em">attention</span>.</h2>
              <p>Deadlines, weakness, and forgetting collapse into one useful decision: what deserves your mind next.</p>
              <a class="rd-btn rd-btn-ghost loop-compare" href="/compare">See the honest comparison <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>

        <div class="memory-lab rd-card" data-memory-lab aria-label="Animated model of memory fading and recovering">
          <div class="lab-topline">
            <span class="lab-course">BIO 110 · Photosynthesis</span>
            <span class="lab-status" data-lab-status>going stale</span>
          </div>

          <div class="memory-meter">
            <div class="meter-copy">
              <span>Memory strength</span>
              <strong data-strength>38%</strong>
            </div>
            <div class="meter-track"><span data-meter-fill></span></div>
          </div>

          <div class="curve-wrap" aria-hidden="true">
            <svg class="curve" viewBox="0 0 620 220" preserveAspectRatio="none" role="presentation">
              <defs>
                <linearGradient id="curve-fade" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="var(--rd-grape)" />
                  <stop offset="1" stop-color="var(--rd-accent)" />
                </linearGradient>
                <linearGradient id="curve-rise" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="var(--rd-accent)" />
                  <stop offset="1" stop-color="var(--rd-spring)" />
                </linearGradient>
              </defs>
              <path class="curve-grid" d="M20 36H600 M20 94H600 M20 152H600 M20 204H600" />
              <path class="curve-line curve-decay" data-decay d="M24 34 C150 42 238 92 320 166 C370 204 430 205 596 207" />
              <path class="curve-line curve-recovery" data-recovery d="M320 166 C344 100 374 58 414 46 C462 34 514 52 596 76" />
              <line class="recall-beam" data-recall-beam x1="320" y1="18" x2="320" y2="198" />
              <circle class="recall-hit" data-recall-hit cx="320" cy="166" r="10" />
            </svg>
            <div class="curve-caption caption-start">learned</div>
            <div class="curve-caption caption-low">about to forget</div>
          </div>

          <div class="recall-card" data-recall-card>
            <span class="recall-label">Quick recall</span>
            <p>What is produced besides ATP?</p>
            <div class="recall-answer" data-recall-answer>
              <span>NADPH</span><strong>✓</strong>
            </div>
          </div>

          <div class="spacing" data-spacing>
            <p class="spacing-label">Next checks stretch as memory strengthens</p>
            <div class="spacing-line">
              <span class="checkpoint is-now" data-checkpoint><i></i><b>now</b></span>
              <span class="checkpoint" data-checkpoint><i></i><b>1 day</b></span>
              <span class="checkpoint" data-checkpoint><i></i><b>4 days</b></span>
              <span class="checkpoint" data-checkpoint><i></i><b>12 days</b></span>
            </div>
          </div>

          <div class="proof-row" data-proof-row>
            <span><strong>+25%</strong> retention</span>
            <span><strong>d = 0.78</strong> effect size</span>
            <span><strong>1</strong> next concept</span>
          </div>

          <div class="focus-card" data-focus-card>
            <span class="focus-badge">Open next</span>
            <div>
              <small>CHEM 220</small>
              <strong>Resonance structures</strong>
            </div>
            <span class="focus-reason">weak · due Fri</span>
          </div>
        </div>
      </div>
      <div class="loop-progress" aria-hidden="true"><span data-loop-progress></span></div>
    </div>
  </div>
</section>

<style>
  .study-loop { padding-block: 0; }
  .loop-runway { position: relative; }
  .loop-stage { position: relative; padding-block: clamp(72px, 12vh, 132px); }
  .loop-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(440px, 1.14fr);
    gap: clamp(38px, 7vw, 96px);
    align-items: center;
  }
  .loop-copy { min-width: 0; }
  .kdot { width: 8px; height: 8px; border-radius: 50%; background: var(--rd-accent); box-shadow: 0 0 0 4px oklch(65% 0.2 2 / .16); }
  .loop-beats { margin-top: 18px; }
  .loop-beat + .loop-beat { margin-top: clamp(44px, 8vw, 88px); }
  .beat-index {
    display: block; margin-bottom: 12px; font-size: 11px; font-weight: 900;
    letter-spacing: .13em; text-transform: uppercase; color: var(--rd-grape);
  }
  .loop-beat h2 { margin: 0; max-width: 12ch; }
  .loop-beat p {
    margin: 22px 0 0; max-width: 42ch; color: var(--rd-ink-soft);
    font-size: clamp(16px, 1.5vw, 18px); font-weight: 600; line-height: 1.58;
  }
  .loop-compare { margin-top: 24px; }

  .memory-lab {
    position: relative; min-width: 0; padding: clamp(22px, 3vw, 34px);
    overflow: hidden; transform: rotate(.6deg);
  }
  .lab-topline, .meter-copy, .proof-row, .focus-card { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
  .lab-course, .lab-status, .meter-copy span, .spacing-label {
    font-size: 11px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase;
  }
  .lab-course { color: var(--rd-grape); }
  .lab-status { color: var(--rd-accent-deep); background: var(--rd-blush); padding: 5px 10px; border-radius: 999px; }
  .memory-meter { margin-top: 22px; }
  .meter-copy span { color: var(--rd-ink-faint); }
  .meter-copy strong { font-family: var(--rd-display); font-size: 24px; color: var(--rd-accent-deep); }
  .meter-track { height: 9px; margin-top: 9px; overflow: hidden; border-radius: 999px; background: oklch(52% .06 305 / .12); animation: meter-breathe 2.8s ease-in-out infinite; }
  .meter-track span { display: block; width: 38%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--rd-accent), var(--rd-tangerine)); }
  @keyframes meter-breathe {
    0%, 100% { box-shadow: 0 0 0 0 oklch(65% .2 2 / 0); }
    50% { box-shadow: 0 0 14px 2px oklch(65% .2 2 / .35); }
  }

  .curve-wrap { position: relative; height: clamp(180px, 25vw, 230px); margin-top: 16px; }
  .curve { width: 100%; height: 100%; overflow: visible; }
  .curve-grid { fill: none; stroke: oklch(52% .06 305 / .1); stroke-width: 1; stroke-dasharray: 3 8; }
  .curve-line { fill: none; stroke-width: 6; stroke-linecap: round; }
  .curve-decay { stroke: url(#curve-fade); }
  .curve-recovery { stroke: url(#curve-rise); }
  .recall-beam { stroke: var(--rd-tangerine); stroke-width: 3; stroke-dasharray: 5 6; }
  .recall-hit { fill: var(--rd-tangerine); filter: drop-shadow(0 0 8px oklch(75% .15 55 / .65)); }
  .curve-caption { position: absolute; bottom: 0; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--rd-ink-faint); }
  .caption-start { left: 1%; }
  .caption-low { left: 46%; }

  .recall-card {
    position: absolute; top: 31%; left: 18%; width: min(64%, 330px); padding: 16px 18px;
    border-radius: var(--rd-r-md); background: oklch(99.5% .006 90); box-shadow: var(--rd-shadow-sticker);
    border: 1.5px solid oklch(52% .06 305 / .16); transform: rotate(-2deg);
  }
  .recall-label { font-size: 10px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; color: var(--rd-grape); }
  .recall-card p { margin: 7px 0 0; font-family: var(--rd-display); font-size: 19px; font-weight: 600; line-height: 1.12; }
  .recall-answer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; padding: 9px 11px; border-radius: 10px; background: var(--rd-spring); }
  .recall-answer span { font-family: var(--rd-display); font-size: 18px; font-weight: 600; }
  .recall-answer strong { color: oklch(38% .12 155); font-size: 20px; }

  .spacing { margin-top: 14px; }
  .spacing-label { color: var(--rd-ink-faint); }
  .spacing-line { position: relative; display: flex; justify-content: space-between; margin-top: 18px; }
  .spacing-line::before { content: ''; position: absolute; left: 7px; right: 7px; top: 7px; height: 2px; background: linear-gradient(90deg, var(--rd-accent), var(--rd-grape), var(--rd-spring)); }
  .checkpoint { position: relative; display: grid; justify-items: center; gap: 7px; z-index: 1; }
  .checkpoint i { width: 15px; height: 15px; border-radius: 50%; background: oklch(99% .01 90); border: 3px solid var(--rd-grape); box-shadow: 0 0 0 4px oklch(58% .19 300 / .1); }
  .checkpoint.is-now i { border-color: var(--rd-accent); animation: checkpoint-now-pulse 1.8s ease-in-out infinite; }
  .checkpoint b { font-size: 10px; color: var(--rd-ink-faint); }
  @keyframes checkpoint-now-pulse {
    0%, 100% { box-shadow: 0 0 0 4px oklch(65% .2 2 / .1); }
    50% { box-shadow: 0 0 0 8px oklch(65% .2 2 / .22); }
  }

  .proof-row { margin-top: 26px; padding-top: 20px; border-top: 1.5px solid oklch(52% .06 305 / .12); }
  .proof-row span { color: var(--rd-ink-soft); font-size: 11px; font-weight: 700; }
  .proof-row strong { display: block; color: var(--rd-grape); font-family: var(--rd-display); font-size: 20px; line-height: 1; }

  .focus-card {
    position: absolute; inset: auto 24px 24px; padding: 16px 18px; border-radius: var(--rd-r-md);
    background: oklch(99.5% .005 90); border: 2px solid var(--rd-accent);
    box-shadow: var(--rd-shadow-pop), var(--rd-shadow-card);
  }
  .focus-badge { padding: 6px 10px; border-radius: 999px; color: var(--rd-on-accent); background: var(--rd-accent); font-size: 10px; font-weight: 900; text-transform: uppercase; }
  .focus-card div { display: flex; flex-direction: column; min-width: 0; }
  .focus-card small { color: var(--rd-ink-faint); font-size: 10px; font-weight: 900; letter-spacing: .08em; }
  .focus-card div strong { font-family: var(--rd-display); font-size: 19px; line-height: 1.05; }
  .focus-reason { color: var(--rd-accent-deep); font-size: 11px; font-weight: 900; white-space: nowrap; }

  .loop-progress { display: none; }
  .study-loop.is-motion .loop-runway { min-height: 420vh; }
  .study-loop.is-motion .loop-stage { min-height: 100svh; display: grid; align-items: center; overflow: hidden; }
  .study-loop.is-motion .loop-beats { position: relative; min-height: clamp(330px, 42vh, 430px); }
  .study-loop.is-motion .loop-beat { position: absolute; inset: 0; margin: 0; }
  .study-loop.is-motion .loop-progress { display: block; position: absolute; left: 50%; bottom: 28px; width: min(280px, 36vw); height: 4px; transform: translateX(-50%); border-radius: 999px; background: oklch(52% .06 305 / .12); overflow: hidden; }
  .study-loop.is-motion .loop-progress span { display: block; width: 100%; height: 100%; transform-origin: left; background: linear-gradient(90deg, var(--rd-accent), var(--rd-grape), var(--rd-spring)); }

  @media (max-width: 860px) {
    .loop-grid { grid-template-columns: 1fr; }
    .memory-lab { width: 100%; max-width: 620px; }
    .loop-beat h2 { max-width: 15ch; }
  }
  @media (max-width: 520px) {
    .memory-lab { padding: 22px; transform: none; }
    .curve-wrap { height: 170px; }
    .recall-card { position: relative; inset: auto; width: 100%; margin-top: -22px; transform: none; }
    .focus-card { position: relative; inset: auto; margin-top: 22px; flex-wrap: wrap; }
    .proof-row { align-items: flex-start; }
    .proof-row strong { font-size: 17px; }
    .focus-reason { white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) {
    .study-loop .loop-runway { min-height: 0; }
    .meter-track { animation: none; }
    .checkpoint.is-now i { animation: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initMarketingMotion, reducedMotion, svgDraw, matchMotion } from '../../../lib/marketing/motion';

  initMarketingMotion();

  if (!reducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    const root = document.querySelector<HTMLElement>('[data-study-loop]');
    const lab = document.querySelector<HTMLElement>('[data-memory-lab]');
    const decay = document.querySelector<SVGPathElement>('[data-decay]');
    const recovery = document.querySelector<SVGPathElement>('[data-recovery]');
    const checkpoints = gsap.utils.toArray<HTMLElement>('[data-checkpoint]');
    const recall = document.querySelector<HTMLElement>('[data-recall-card]');
    const proof = document.querySelector<HTMLElement>('[data-proof-row]');
    const focus = document.querySelector<HTMLElement>('[data-focus-card]');

    matchMotion({
      // Flagship pinned scene: memory fades, a recall restores it, spacing
      // stretches the cadence, and everything compresses into one focus card.
      desktop: () => {
        const runway = document.querySelector<HTMLElement>('[data-loop-runway]');
        const stage = document.querySelector<HTMLElement>('[data-loop-stage]');
        const progress = document.querySelector<HTMLElement>('[data-loop-progress]');
        const beam = document.querySelector<SVGLineElement>('[data-recall-beam]');
        const hit = document.querySelector<SVGCircleElement>('[data-recall-hit]');
        const answer = document.querySelector<HTMLElement>('[data-recall-answer]');
        const spacing = document.querySelector<HTMLElement>('[data-spacing]');
        const meter = document.querySelector<HTMLElement>('[data-meter-fill]');
        const strength = document.querySelector<HTMLElement>('[data-strength]');
        const status = document.querySelector<HTMLElement>('[data-lab-status]');
        const beats = gsap.utils.toArray<HTMLElement>('[data-loop-beat]');
        if (!root || !runway || !stage || !lab) return;
        root.classList.add('is-motion');

        gsap.set(beats.slice(1), { autoAlpha: 0, y: 36 });
        gsap.set([beam, hit, recall, spacing, proof, focus], { autoAlpha: 0 });
        gsap.set(answer, { scaleY: 0, transformOrigin: 'top' });
        gsap.set(checkpoints, { scale: 0, y: 12 });
        gsap.set(meter, { width: '38%' });
        if (progress) gsap.set(progress, { scaleX: 0 });

        const counter = { value: 38 };
        const renderStrength = () => { if (strength) strength.textContent = Math.round(counter.value) + '%'; };

        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: runway,
            start: 'top top',
            end: 'bottom bottom',
            pin: stage,
            scrub: 0.65,
            invalidateOnRefresh: true,
          },
        });
        if (progress) tl.to(progress, { scaleX: 1, duration: 4 }, 0);
        if (decay) svgDraw(decay, { timeline: tl, position: 0, duration: .72, from: .1 });
        tl.to(lab, { rotate: -1.2, y: -8, duration: .3 }, .18);

        // Beat 1 -> 2: the recall intervention lands exactly at the low point.
        tl.to(beats[0], { autoAlpha: 0, y: -34, duration: .2 }, .75)
          .to(beats[1], { autoAlpha: 1, y: 0, duration: .24 }, .9)
          .to([beam, hit], { autoAlpha: 1, duration: .12 }, .82)
          .fromTo(recall, { autoAlpha: 0, x: 70, rotate: 7, scale: .82 }, { autoAlpha: 1, x: 0, rotate: -2, scale: 1, ease: 'back.out(1.8)', duration: .34 }, .92)
          .to(answer, { scaleY: 1, ease: 'back.out(1.6)', duration: .28 }, 1.2);
        if (recovery) svgDraw(recovery, { timeline: tl, position: 1.18, duration: .56, ease: 'power2.out' });
        tl.to(counter, { value: 86, duration: .5, onUpdate: renderStrength }, 1.18)
          .to(meter, { width: '86%', duration: .5 }, 1.18);
        tl.call(() => { if (status) status.textContent = 'recalled'; }, [], 1.3);

        // Beat 2 -> 3: recall card folds away and the spacing cadence takes over.
        tl.to(beats[1], { autoAlpha: 0, y: -34, duration: .2 }, 1.72)
          .to(beats[2], { autoAlpha: 1, y: 0, duration: .24 }, 1.88)
          .to(recall, { autoAlpha: 0, y: -34, scale: .88, duration: .24 }, 1.78)
          .to([beam, hit], { autoAlpha: 0, duration: .15 }, 1.8)
          .to(spacing, { autoAlpha: 1, duration: .2 }, 1.9)
          .to(checkpoints, { scale: 1, y: 0, ease: 'back.out(2)', stagger: .12, duration: .3 }, 1.98)
          .to(proof, { autoAlpha: 1, y: 0, duration: .24 }, 2.36);

        // Beat 3 -> 4: all evidence compresses into one ranked next action.
        tl.to(beats[2], { autoAlpha: 0, y: -34, duration: .2 }, 2.82)
          .to(beats[3], { autoAlpha: 1, y: 0, duration: .24 }, 2.98)
          .to([decay, recovery, spacing, proof], { autoAlpha: .18, duration: .35 }, 2.86)
          .fromTo(focus, { autoAlpha: 0, y: 90, scale: .7, rotate: -6 }, { autoAlpha: 1, y: 0, scale: 1, rotate: 0, ease: 'back.out(1.9)', duration: .48 }, 3.02)
          .to(lab, { rotate: 0, y: 0, scale: 1.035, ease: 'power2.out', duration: .35 }, 3.1);
        tl.call(() => { if (status) status.textContent = 'next move ready'; }, [], 3.2);

        return () => {
          tl.scrollTrigger?.kill();
          tl.kill();
          root.classList.remove('is-motion');
        };
      },
      // Mobile: beats stay in normal document flow (no pin, no scrub runway —
      // the pinned scene is the highest overflow/jank risk on touch). The lab
      // card gets one lightweight, non-pinned wake-up instead of the full
      // scrubbed narrative, so it still feels alive without cramming the
      // desktop scene into a phone viewport.
      mobile: () => {
        if (!lab) return;
        gsap.set(checkpoints, { scale: 0, y: 10 });
        gsap.set([recall, proof, focus], { autoAlpha: 0, y: 18 });

        const tl = gsap.timeline({
          scrollTrigger: { trigger: lab, start: 'top 78%', once: true },
        });
        if (decay) svgDraw(decay, { timeline: tl, position: 0, duration: .6, from: .1 });
        if (recovery) svgDraw(recovery, { timeline: tl, position: .3, duration: .5, ease: 'power2.out' });
        tl.to(recall, { autoAlpha: 1, y: 0, duration: .35 }, .3)
          .to(checkpoints, { scale: 1, y: 0, ease: 'back.out(2)', stagger: .08, duration: .28 }, .4)
          .to(proof, { autoAlpha: 1, y: 0, duration: .3 }, .6)
          .to(focus, { autoAlpha: 1, y: 0, duration: .35, ease: 'back.out(1.7)' }, .65);
      },
    });
  }
</script>
