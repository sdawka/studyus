---
// Landing REDESIGN Phase 2 — "what to open next". Sits transparent over the .rd
// pastel mesh, uses --rd-* tokens, Fraunces heading (.rd-h2 + .rd-em candy
// italic accent), a .rd-kicker eyebrow, and a gummy .rd-card readiness vignette.
// Entrance is the shared scroll reveal (data-reveal / data-reveal-item). The
// readiness ring and "Weakest in course" annotation circle are drawn statically
// to their final value/shape so the card reads complete with zero motion
// (reduced-motion safe by construction) — <script> only layers the count-up,
// the circle draw-on, and pointer tilt on top.
const pct = 38;
const r = 44;
const c = 2 * Math.PI * r;
const offset = c * (1 - pct / 100);
---
<section class="feat-next rd-section">
  <div class="rd-container feat-inner" data-reveal>
    <div class="feat-copy" data-reveal-item>
      <p class="rd-kicker"><span class="kdot"></span>What to open next</p>
      <h2 class="rd-h2">It picks the exact <span class="rd-em">concept</span>, not just a time slot.</h2>
      <p class="lead">
        Every course breaks into ideas you'll actually get tested on. We check
        your mastery, when it's due, and what's slipping — then show you the
        one thing to hit first.
      </p>
      <p class="lead lead-punch">
        No vague “study for two hours.” Just: open this, now — it's weak and the
        exam clock is moving.
      </p>
    </div>

    <div class="feat-vignette rd-tilt" data-reveal-item aria-hidden="true">
      <div class="rd-card ring-card rd-interactive" data-tilt-card data-topic-cycle data-topic-offset="2">
        <p class="card-label">What's next</p>
        <div class="card-body">
          <div class="ring-wrap">
            <svg class="ring" width="112" height="112" viewBox="0 0 112 112" role="presentation">
              <defs>
                <linearGradient id="fn-ring" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="var(--rd-accent)" />
                  <stop offset="1" stop-color="var(--rd-grape)" />
                </linearGradient>
              </defs>
              <circle class="ring-bg" cx="56" cy="56" r={r} fill="none" stroke-width="9" />
              <circle
                class="ring-fg"
                cx="56"
                cy="56"
                r={r}
                fill="none"
                stroke-width="9"
                stroke-linecap="round"
                stroke-dasharray={c}
                stroke-dashoffset={offset}
                transform="rotate(-90 56 56)"
              />
              <text x="56" y="62" text-anchor="middle" class="ring-num">{pct}%</text>
            </svg>
            <span class="ring-spark" aria-hidden="true">✦</span>
          </div>
          <div class="card-detail">
            <span class="card-course rd-course-chip" data-topic-field="courseShort">ECON 230</span>
            <span class="card-topic" data-topic-field="topic">Consumer surplus</span>
            <span class="chip-wrap">
              <span class="chip chip-weak" data-topic-field="status">Weak · 38%</span>
              <svg class="chip-ring" viewBox="0 0 148 40" preserveAspectRatio="none" aria-hidden="true">
                <path
                  class="chip-ring-path"
                  d="M6 21 C 6 8, 26 3, 74 3 C 124 3, 142 9, 142 21 C 142 34, 120 38, 74 38 C 24 38, 6 32, 6 21 Z"
                  fill="none"
                  stroke-width="2.5"
                  stroke-linecap="round"
                />
              </svg>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feat-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }
  .feat-next h2 { margin: 16px 0 0; }
  .lead {
    margin: 22px 0 0;
    font-size: clamp(16px, 1.6vw, 18.5px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--rd-ink-soft);
    max-width: 46ch;
  }
  .lead-punch { color: var(--rd-ink); font-weight: 700; }

  /* Readiness vignette — gummy frosted card floating over the mesh, tipped a
     touch so it feels tactile. Straightens on hover with the bounce ease. */
  .ring-card {
    transform: rotate(-1.5deg);
    transition: transform 0.32s var(--rd-ease-bounce);
  }
  .feat-vignette:hover .ring-card { transform: rotate(0deg) translateY(-3px); }

  .card-label {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rd-grape);
    margin: 0 0 18px;
  }
  .card-body {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .ring-wrap { position: relative; flex: 0 0 auto; }
  .ring-bg { stroke: oklch(52% 0.06 305 / 0.14); }
  .ring-fg { stroke: url(#fn-ring); }
  .ring-num {
    font-family: var(--rd-display);
    font-size: 23px;
    font-weight: 600;
    fill: var(--rd-ink);
  }
  .ring-spark {
    position: absolute;
    top: -4px;
    right: -4px;
    font-size: 18px;
    color: var(--rd-tangerine);
    filter: drop-shadow(0 2px 4px oklch(75% 0.15 55 / 0.5));
  }

  .card-detail { display: flex; flex-direction: column; gap: 8px; }
  .card-course {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rd-ink-faint);
  }
  .card-topic {
    font-family: var(--rd-display);
    font-size: 19px;
    font-weight: 600;
    color: var(--rd-ink);
    line-height: 1.1;
  }
  /* Candy status chip — matches the pastel field rather than the --mk pill. */
  .chip {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 6px 11px;
    border-radius: var(--rd-r-pill);
    margin-top: 2px;
  }
  .chip-weak {
    color: var(--rd-on-accent);
    background: var(--rd-accent);
    box-shadow: var(--rd-shadow-sticker);
  }

  /* Annotation circle — a loose hand-drawn loop that draws itself around
     the weak chip, the "it picks the exact concept" beat. See <script>. */
  .chip-wrap {
    position: relative;
    display: inline-flex;
    align-self: flex-start;
  }
  .chip-ring {
    position: absolute;
    inset: -5px -9px;
    width: calc(100% + 18px);
    height: calc(100% + 10px);
    pointer-events: none;
  }
  .chip-ring-path {
    stroke: var(--rd-grape);
  }

  @media (max-width: 860px) {
    .feat-inner { grid-template-columns: 1fr; gap: 30px; }
    .feat-vignette { width: 100%; max-width: 400px; }
  }
  @media (max-width: 560px) {
    /* The desktop tilt steals 3–4px from one mobile gutter and makes the card
       look accidentally pressed against the glass. Keep mobile edges parallel. */
    .ring-card,
    .feat-vignette:hover .ring-card { transform: none; }
  }
  @media (max-width: 420px) {
    .card-body { gap: 16px; }
    .ring { width: 92px; height: 92px; flex: 0 0 92px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring-card { transition: none; transform: rotate(-1.5deg); }
    .feat-vignette:hover .ring-card { transform: rotate(-1.5deg); }
  }
</style>

<script>
  // Draw the readiness ring on + count the % up when the card scrolls in,
  // circle the weak chip, and tilt the card toward the pointer on desktop.
  // Reduced motion skips the ring/counter — it's server-rendered to its
  // final value; svgDraw() and pointerTilt() already no-op on their own.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { svgDraw, pointerTilt, initMarketingMotion, reducedMotion } from '../../../lib/marketing/motion';

  initMarketingMotion();

  svgDraw('.chip-ring-path', { trigger: '.ring-card', start: 'top 78%' });
  pointerTilt('[data-tilt-card]', { max: 8, scale: 1.02 });

  if (!reducedMotion) {
    gsap.registerPlugin(ScrollTrigger);
    const ring = document.querySelector<SVGCircleElement>('.ring-fg');
    const num = document.querySelector('.ring-num');
    if (ring && num) {
      const circumference = parseFloat(ring.getAttribute('stroke-dasharray') ?? '0');
      const targetOffset = parseFloat(ring.getAttribute('stroke-dashoffset') ?? '0');
      const targetPct = Math.round((1 - targetOffset / circumference) * 100);
      const counter = { v: 0 };
      // start empty
      gsap.set(ring, { attr: { 'stroke-dashoffset': circumference } });
      num.textContent = '0%';
      ScrollTrigger.create({
        trigger: '.ring-card',
        start: 'top 82%',
        once: true,
        onEnter: () => {
          gsap.to(ring, {
            attr: { 'stroke-dashoffset': targetOffset },
            duration: 1.25,
            ease: 'power2.out',
          });
          gsap.to(counter, {
            v: targetPct,
            duration: 1.25,
            ease: 'power2.out',
            onUpdate: () => {
              num.textContent = Math.round(counter.v) + '%';
            },
          });
        },
      });
    }
  }
</script>
