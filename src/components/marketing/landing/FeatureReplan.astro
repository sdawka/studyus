---
// Landing REDESIGN Phase 2 — "when the plan slips". Sits transparent over the
// .rd pastel mesh, uses --rd-* tokens, Fraunces heading (.rd-h2 + .rd-em candy
// italic accent), a .rd-kicker eyebrow, and a gummy .rd-card week vignette.
// Entrance is the shared scroll reveal (data-reveal / data-reveal-item) — no
// bespoke <script>. The "moved" task is shown in its final resting slot with a
// ghost of where it was, so the idea reads complete with zero motion.
const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const missed = 2; // Wednesday — the sick day
---
<section class="feat-replan rd-section">
  <div class="rd-container feat-inner" data-reveal>
    <div class="feat-vignette" data-reveal-item aria-hidden="true">
      <div class="rd-card week-card">
        <p class="card-label">This week</p>
        <div class="week">
          {days.map((d, i) => (
            <div class:list={['day', { missed: i === missed }]}>
              <span class="day-label">{d}</span>
              {i === missed && <span class="day-flag">Sick day</span>}
            </div>
          ))}
        </div>
        <div class="chip-track">
          <div class="task-chip ghost">Problem set 4</div>
          <svg class="move-arc" viewBox="0 0 120 44" preserveAspectRatio="none" role="presentation">
            <path d="M8 30 C 40 2, 80 2, 112 26" fill="none" stroke-width="2.5"
              stroke-dasharray="4 5" stroke-linecap="round" />
            <path d="M104 18 L114 26 L102 30 Z" />
          </svg>
          <div class="task-chip live">Problem set 4</div>
        </div>
        <p class="week-note">Moved to Friday's real opening — before the deadline.</p>
      </div>
    </div>

    <div class="feat-copy" data-reveal-item>
      <p class="rd-kicker"><span class="kdot"></span>When it slips</p>
      <h2 class="rd-h2">When the week slips, the plan <span class="rd-em">moves</span>.</h2>
      <p class="lead">
        Miss a day and most planners just turn red. Studyus slides the unfinished
        work into the next real opening — before the deadline catches you.
      </p>
      <p class="lead lead-punch">
        No broken chains. No punishment UI. Just a plan that assumes real student
        weeks go sideways.
      </p>
    </div>
  </div>
</section>

<style>
  .feat-inner {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }
  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }
  .feat-replan h2 { margin: 16px 0 0; }
  .lead {
    margin: 22px 0 0;
    font-size: clamp(16px, 1.6vw, 18.5px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--rd-ink-soft);
    max-width: 46ch;
  }
  .lead-punch { color: var(--rd-ink); font-weight: 700; }

  /* Week vignette — gummy frosted card, tipped a touch for tactility. */
  .week-card {
    transform: rotate(1.5deg);
    transition: transform 0.32s var(--rd-ease-bounce);
  }
  .feat-vignette:hover .week-card { transform: rotate(0deg) translateY(-3px); }

  .card-label {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rd-grape);
    margin: 0 0 16px;
  }

  .week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 7px;
  }
  .day {
    aspect-ratio: 1;
    border-radius: var(--rd-r-sm);
    background: oklch(100% 0 0 / 0.55);
    border: 1.5px solid oklch(52% 0.06 305 / 0.14);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }
  .day-label {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 13px;
    color: var(--rd-ink-soft);
  }
  .day.missed {
    border-style: dashed;
    border-color: var(--rd-accent);
    background: var(--rd-blush);
  }
  .day.missed .day-label { color: var(--rd-accent-deep); text-decoration: line-through; }
  .day-flag {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 7.5px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--rd-accent-deep);
  }

  /* Reschedule track: a faded "was here" ghost + solid candy chip in its new
     slot, joined by a dashed arc — the "moves" idea, fully static. */
  .chip-track {
    position: relative;
    margin-top: 16px;
    height: 40px;
  }
  .task-chip {
    position: absolute;
    top: 4px;
    width: calc((100% / 7) * 2 - 7px);
    padding: 8px 8px;
    font-family: var(--rd-body);
    font-size: 11px;
    font-weight: 800;
    text-align: center;
    border-radius: var(--rd-r-sm);
  }
  .task-chip.ghost {
    transform: translateX(calc(2 * (100% / 7)));
    background: oklch(92% 0.03 305 / 0.6);
    color: var(--rd-ink-faint);
    border: 1.5px dashed oklch(52% 0.06 305 / 0.3);
  }
  .task-chip.live {
    transform: translateX(calc(4.5 * (100% / 7)));
    background: var(--rd-spring);
    color: var(--rd-ink);
    box-shadow: var(--rd-shadow-sticker);
  }
  .move-arc {
    position: absolute;
    top: 0;
    left: calc(2.4 * (100% / 7));
    width: calc(2.4 * (100% / 7));
    height: 40px;
    overflow: visible;
  }
  .move-arc path[fill='none'] { stroke: var(--rd-grape); }
  .move-arc path:not([fill='none']) { fill: var(--rd-grape); }

  .week-note {
    margin: 18px 0 0;
    font-family: var(--rd-body);
    font-size: 12.5px;
    font-weight: 700;
    color: var(--rd-ink-faint);
  }

  @media (max-width: 860px) {
    .feat-inner { grid-template-columns: 1fr; gap: 30px; }
    .feat-vignette { width: 100%; max-width: 400px; order: -1; }
  }
  @media (max-width: 420px) {
    .week { gap: 5px; }
    .day { min-width: 0; }
    .day-flag { font-size: 7px; }
    .task-chip { padding-inline: 6px; font-size: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .week-card { transition: none; transform: rotate(1.5deg); }
    .feat-vignette:hover .week-card { transform: rotate(1.5deg); }
  }
</style>

<script>
  // "The plan moves": the live task-chip glides from the sick-day slot to
  // Friday's opening with an arced hop and a bounce landing, as the card scrolls
  // in. Reduced motion skips it — the chip is server-rendered in its final slot.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initMarketingMotion, reducedMotion } from '../../../lib/marketing/motion';

  initMarketingMotion();

  if (!reducedMotion) {
    gsap.registerPlugin(ScrollTrigger);
    const track = document.querySelector<HTMLElement>('.chip-track');
    const live = document.querySelector<HTMLElement>('.task-chip.live');
    const arc = document.querySelector<SVGElement>('.move-arc');
    if (track && live) {
      // 2.5 columns of travel: ghost slot (2) -> live slot (4.5).
      const delta = () => (track.offsetWidth / 7) * 2.5;
      ScrollTrigger.create({
        trigger: track,
        start: 'top 84%',
        once: true,
        onEnter: () => {
          if (arc) gsap.from(arc, { opacity: 0, duration: 0.45, ease: 'power1.out' });
          gsap
            .timeline()
            .from(live, { x: -delta(), opacity: 0, scale: 0.85, duration: 0.9, ease: 'power2.inOut' })
            .to(
              live,
              {
                keyframes: [
                  { y: -30, duration: 0.45, ease: 'power2.out' },
                  { y: 0, duration: 0.45, ease: 'bounce.out' },
                ],
              },
              0,
            );
        },
      });
    }
  }
</script>
