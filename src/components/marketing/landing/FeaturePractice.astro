---
// Landing REDESIGN Phase 2 — the "why it works" beat (spaced retrieval).
// Restyled into the .rd pastel system: transparent over the mesh, --rd-* tokens,
// Fraunces heading (.rd-h2 + .rd-em candy accent), a .rd-kicker eyebrow, and a
// gummy .rd-card recall vignette. Shared scroll entrance via data-reveal /
// data-reveal-item (see src/lib/marketing/motion.ts). No bespoke <script>.
---
<section class="practice rd-section">
  <div class="rd-container practice-inner" data-reveal>
    <div class="practice-copy" data-reveal-item>
      <p class="rd-kicker"><span class="kdot"></span>Why it works</p>
      <h2 class="rd-h2">Practice before you <span class="rd-em">forget</span>.</h2>
      <p class="lead">
        Cramming feels productive. Spaced retrieval works better — one of the few
        study techniques with real evidence behind it, not just study-influencer
        advice.
      </p>
      <p class="body">
        Studyus drops in short recall checks right when forgetting is about to
        win — not whenever an app wants another notification.
      </p>
    </div>

    <div class="recall rd-card" data-reveal-item aria-hidden="true">
      <div class="recall-head">
        <span class="recall-tag">Recall check</span>
        <span class="recall-due">due now</span>
      </div>
      <p class="recall-topic">Light-dependent reactions</p>
      <p class="recall-q">What's produced besides ATP?</p>
      <div class="recall-answer">
        <span class="recall-a-label">Recalled</span>
        <span class="recall-a-val">NADPH <span class="tick">✓</span></span>
      </div>
      <p class="recall-next">Next check in 4 days</p>
    </div>
  </div>
</section>

<style>
  .practice-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }
  .practice h2 { margin: 16px 0 0; }
  .lead {
    margin: 22px 0 0;
    font-size: clamp(16px, 1.6vw, 18.5px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--rd-ink-soft);
    max-width: 48ch;
  }
  .body {
    margin: 16px 0 0;
    font-size: clamp(15px, 1.5vw, 17px);
    font-weight: 500;
    line-height: 1.6;
    color: var(--rd-ink-soft);
    max-width: 48ch;
  }

  /* Recall vignette — a completed retrieval card on a gummy surface. */
  .recall { display: flex; flex-direction: column; gap: 10px; }
  .recall-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .recall-tag {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rd-on-accent);
    background: var(--rd-accent);
    padding: 5px 11px;
    border-radius: var(--rd-r-pill);
    box-shadow: var(--rd-shadow-sticker);
  }
  .recall-due {
    font-family: var(--rd-body);
    font-weight: 700;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--rd-ink-faint);
  }
  .recall-topic {
    margin: 6px 0 0;
    font-family: var(--rd-display);
    font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 600;
    line-height: 1.05;
    color: var(--rd-ink);
  }
  .recall-q {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--rd-ink-soft);
  }
  .recall-answer {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
    padding: 12px 14px;
    background: var(--rd-spring);
    border-radius: var(--rd-r-md);
  }
  .recall-a-label {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: oklch(38% 0.09 155);
  }
  .recall-a-val {
    font-family: var(--rd-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--rd-ink);
  }
  .tick { color: oklch(48% 0.15 155); }
  .recall-next {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--rd-ink-faint);
  }

  @media (max-width: 860px) {
    .practice-inner { grid-template-columns: 1fr; gap: 28px; }
    .recall { width: 100%; max-width: 420px; }
  }
</style>
