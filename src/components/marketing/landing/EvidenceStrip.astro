---
// Landing REDESIGN Phase 2 — the evidence strip (research stats + citation).
// Restyled into the .rd pastel system: transparent over the mesh, --rd-* tokens,
// Fraunces heading (.rd-h2 + .rd-em candy accent), and the ledger becomes a row
// of gummy .rd-card stat tiles with big Fraunces numbers and a candy accent.
// The citation stays plain and legible — it's a real reference. Shared scroll
// entrance via data-reveal / data-reveal-item. No bespoke <script>.
// `display` is the static/reduced-motion value; the count-up script tweens
// `value` (with prefix/suffix/decimals) up to it when the tile scrolls in.
const stats = [
  { value: 25, decimals: 0, prefix: '+', suffix: '%', display: '+25%', tone: 'accent', label: 'better retention from spaced retrieval than last-minute cramming' },
  { value: 0.78, decimals: 2, prefix: 'd = ', suffix: '', display: 'd = 0.78', tone: 'grape', label: 'effect size, meta-analysis of spaced vs. massed practice' },
  { value: 1, decimals: 0, prefix: '', suffix: '', display: '1', tone: 'tangerine', label: 'simple principle: test yourself, then come back before you forget' },
];
---
<section class="evidence rd-section">
  <div class="rd-container" data-reveal>
    <p class="rd-kicker" data-reveal-item><span class="kdot"></span>The evidence</p>
    <h2 class="rd-h2" data-reveal-item>Evidence beats <span class="rd-em">study vibes</span>.</h2>

    <div class="tiles" data-reveal-item>
      {stats.map((s) => (
        <div class={`tile rd-card tone-${s.tone}`}>
          <span
            class="tile-num"
            data-count-to={s.value}
            data-decimals={s.decimals}
            data-prefix={s.prefix}
            data-suffix={s.suffix}
          >{s.display}</span>
          <span class="tile-label">{s.label}</span>
        </div>
      ))}
    </div>

    <p class="citation" data-reveal-item>
      <span class="cite-src">Source</span>
      Pan, S. C., &amp; Rickard, T. C. (2018), <em>Journal of Educational Psychology</em> — spaced retrieval beats massed study.
    </p>
  </div>
</section>

<style>
  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }
  .evidence h2 { margin: 16px 0 0; }

  .tiles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2.2vw, 24px);
    margin: clamp(32px, 5vw, 48px) 0 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  /* candy top-rule keyed to each tile's tone */
  .tile-num {
    font-family: var(--rd-display);
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .tone-accent .tile-num { color: var(--rd-accent); }
  .tone-grape .tile-num { color: var(--rd-grape); }
  .tone-tangerine .tile-num { color: oklch(58% 0.16 55); }
  .tile-label {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--rd-ink-soft);
    max-width: 30ch;
  }

  .citation {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin: clamp(24px, 3vw, 32px) 0 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--rd-ink-faint);
    max-width: 62ch;
  }
  .cite-src {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rd-grape);
    border: 1.5px solid oklch(58% 0.19 300 / 0.3);
    padding: 2px 8px;
    border-radius: var(--rd-r-pill);
  }
  .citation em { font-style: italic; }

  @media (max-width: 720px) {
    .tiles { grid-template-columns: 1fr; }
    .tile-label { max-width: 42ch; }
  }
</style>

<script>
  // Count-up: each stat number ticks from 0 to its value when it scrolls in.
  // Reduced motion skips this entirely — the DOM already holds the final value.
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initMarketingMotion, reducedMotion } from '../../../lib/marketing/motion';

  initMarketingMotion();

  if (!reducedMotion) {
    gsap.registerPlugin(ScrollTrigger);
    const nums = document.querySelectorAll<HTMLElement>('.tile-num[data-count-to]');
    nums.forEach((el) => {
      const to = parseFloat(el.dataset.countTo ?? '0');
      const dec = parseInt(el.dataset.decimals ?? '0', 10);
      const pre = el.dataset.prefix ?? '';
      const suf = el.dataset.suffix ?? '';
      const counter = { v: 0 };
      const render = () => {
        el.textContent = pre + counter.v.toFixed(dec) + suf;
      };
      render(); // start at 0 so nothing flashes the final value pre-scroll
      gsap.to(counter, {
        v: to,
        duration: 1.1,
        ease: 'power2.out',
        onUpdate: render,
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });
  }
</script>
