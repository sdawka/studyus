---
// Landing REDESIGN Phase 2 — the problem beat. Reference pattern for the other
// restyled sections: sits transparent over the .rd mesh, uses --rd-* tokens,
// Fraunces headings (.rd-h2 + .rd-em candy italic accent), a .rd-kicker eyebrow,
// gummy pastel surfaces, and `data-reveal` / `data-reveal-item` for the shared
// scroll entrance (see src/lib/marketing/motion.ts). No bespoke <script>.
const scattered = [
  { label: 'Google Calendar', tone: 'blush', rot: -6 },
  { label: 'Notion doc, p.14', tone: 'sky', rot: 4 },
  { label: 'Class group chat', tone: 'mint', rot: -2 },
  { label: 'Moved syllabus PDF', tone: 'lilac', rot: 7 },
  { label: 'Sticky on the monitor', tone: 'tangerine', rot: -8 },
];
---
<section class="problem rd-section">
  <div class="rd-container problem-inner" data-reveal>
    <div class="scatter" aria-hidden="true" data-reveal-item>
      {scattered.map((tag) => (
        <span class={`tag tone-${tag.tone}`} style={`--rot: ${tag.rot}deg`}>{tag.label}</span>
      ))}
    </div>
    <div class="problem-copy" data-reveal-item>
      <p class="rd-kicker"><span class="kdot"></span>The problem</p>
      <h2 class="rd-h2">Five apps, one group chat, and <span class="rd-em">zero</span> real plan.</h2>
      <p class="lead">
        The assignment's in one app. The reminder's in a muted chat. The syllabus
        changed again. Nothing connects — so your study plan quietly falls apart.
      </p>
      <p class="fix">
        <span class="fix-tag">The fix</span>
        one place that turns the scatter into your next study move.
      </p>
    </div>
  </div>
</section>

<style>
  .problem-inner {
    display: grid;
    grid-template-columns: minmax(0, 400px) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: center;
  }
  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }
  .problem h2 { margin: 16px 0 0; }
  .lead {
    margin: 22px 0 0;
    font-size: clamp(16px, 1.6vw, 18.5px);
    font-weight: 600;
    line-height: 1.6;
    color: var(--rd-ink-soft);
    max-width: 46ch;
  }
  .fix {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
    margin: 22px 0 0;
    font-size: clamp(16px, 1.6vw, 18.5px);
    font-weight: 700;
    color: var(--rd-ink);
    max-width: 44ch;
  }
  .fix-tag {
    font-family: var(--rd-body);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rd-on-accent);
    background: var(--rd-accent);
    padding: 5px 11px;
    border-radius: var(--rd-r-pill);
    box-shadow: var(--rd-shadow-sticker);
  }

  /* the five-apps scatter — gummy pastel chips that straighten on hover */
  .scatter {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 12px;
    padding: 8px;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--rd-body);
    font-weight: 700;
    font-size: 13.5px;
    color: var(--rd-ink);
    border-radius: 6px 13px 11px 13px;
    padding: 10px 14px;
    transform: rotate(var(--rot));
    box-shadow: var(--rd-shadow-sticker);
    transition: transform 0.24s var(--rd-ease-bounce);
  }
  .scatter:hover .tag { transform: rotate(0deg); }
  .tone-blush { background: var(--rd-blush); }
  .tone-sky { background: var(--rd-sky); }
  .tone-mint { background: var(--rd-mint); }
  .tone-lilac { background: var(--rd-lilac); }
  .tone-tangerine { background: oklch(88% 0.09 60); }

  @media (max-width: 780px) {
    .problem-inner { grid-template-columns: 1fr; gap: 26px; }
    .scatter { order: 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tag { transition: none; }
    .scatter:hover .tag { transform: rotate(var(--rot)); }
  }
</style>
