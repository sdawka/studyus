<section class="teaser">
  <div class="mk-container teaser-inner">
    <p class="teaser-line reveal">
      Calendars schedule time. Studyus schedules attention.
    </p>
    <a class="mk-btn mk-btn-ghost reveal" style="--reveal-delay: 80ms" href="/compare">
      See how it compares →
    </a>
  </div>
</section>

<style>
  .teaser {
    padding-block: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--mk-hairline);
    border-bottom: 1px solid var(--mk-hairline);
  }
  .teaser-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .teaser-line {
    font-family: var(--mk-font-display);
    font-size: clamp(18px, 2.2vw, 24px);
    max-width: 30ch;
  }
</style>
