---
// The authenticity beat: naming who should NOT switch. Framed as advice,
// not a hedge — the point is that a page willing to say this is more
// believable everywhere else on it.
const exceptions = [
  {
    who: "You've got a mature, med-school-grade Anki deck",
    why: 'Ten thousand cards and a tuned workflow beat a fresh start. Finish the block, switch between semesters if at all.',
  },
  {
    who: 'Your team needs a shared wiki, not a study plan',
    why: "Docs, databases, and a group knowledge base are Notion's job. We don't do that, on purpose.",
  },
  {
    who: 'You just want a fast personal to-do list',
    why: "If school is one line item among many in your life, Todoist is lighter and it's genuinely good at that.",
  },
];
---
<section id="honest" class="honest mk-container">
  <p class="honest-eyebrow reveal">When not to pick us</p>
  <h2 class="honest-title reveal">Sometimes the other app is the right call.</h2>

  <div class="honest-list">
    {exceptions.map((e, i) => (
      <div class="honest-row reveal" style={`--reveal-delay: ${i * 70}ms;`}>
        <p class="honest-who">{e.who}</p>
        <p class="honest-why">{e.why}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .honest {
    padding-block: clamp(56px, 9vw, 96px);
  }

  .honest-eyebrow {
    font-family: var(--mk-font-mono);
    font-size: 12.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mk-faint);
    margin-bottom: 14px;
  }

  .honest-title {
    font-size: clamp(24px, 3.4vw, 36px);
    max-width: 22ch;
    margin-bottom: 36px;
  }

  .honest-list {
    border-top: 1px solid var(--mk-hairline);
  }

  .honest-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 8px 40px;
    padding-block: 22px;
    border-bottom: 1px solid var(--mk-hairline);
  }

  .honest-who {
    font-family: var(--mk-font-display);
    font-weight: 560;
    font-size: 17px;
  }

  .honest-why {
    color: var(--mk-muted);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .honest-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
