---
// The authenticity beat: naming who should NOT switch. Framed as advice,
// not a hedge — the point is that a page willing to say this is more
// believable everywhere else on it.
const exceptions = [
  {
    who: "You've got a mature, med-school-grade Anki deck",
    why: 'Ten thousand cards and a tuned workflow beat a fresh start. Finish the block, switch between semesters if at all.',
  },
  {
    who: 'Your team needs a shared wiki, not a study plan',
    why: "Docs, databases, and a group knowledge base are Notion's job. We don't do that, on purpose.",
  },
  {
    who: 'You just want a fast personal to-do list',
    why: "If school is one line item among many in your life, Todoist is lighter and it's genuinely good at that.",
  },
];
---
<section id="honest" class="honest rd-section">
  <div class="rd-container">
    <p class="rd-kicker" data-reveal><span class="kdot"></span>When not to pick us</p>
    <h2 class="honest-title rd-h2">Sometimes the other app is the right call.</h2>

    <div class="honest-list" data-reveal>
      {exceptions.map((e) => (
        <div class="honest-row rd-card" data-reveal-item>
          <p class="honest-who">{e.who}</p>
          <p class="honest-why">{e.why}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .honest {
    padding-block: clamp(56px, 9vw, 100px);
  }

  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }

  .honest-title {
    margin-top: 16px;
    max-width: 22ch;
    margin-bottom: 36px;
  }

  .honest-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .honest-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 8px 40px;
    align-items: center;
  }

  .honest-who {
    font-family: var(--rd-display);
    font-weight: 640;
    font-size: 18px;
    color: var(--rd-ink);
  }

  .honest-why {
    color: var(--rd-ink-soft);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .honest-row {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
