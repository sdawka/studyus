---
// Compact spec-sheet table for people who just want the grid. Kept honest:
// "Some" is a real value, not just yes/no, and studyus doesn't sweep every row.
type Cell = 'yes' | 'some' | 'no';

interface Row {
  name: string;
  courseAware: Cell;
  weightedDeadlines: Cell;
  whatsNext: Cell;
  spacedPractice: Cell;
  recovers: Cell;
  price: string;
  lead?: boolean;
}

const rows: Row[] = [
  {
    name: 'studyus',
    courseAware: 'yes',
    weightedDeadlines: 'yes',
    whatsNext: 'yes',
    spacedPractice: 'yes',
    recovers: 'yes',
    price: 'Start free',
    lead: true,
  },
  { name: 'MyStudyLife', courseAware: 'yes', weightedDeadlines: 'yes', whatsNext: 'no', spacedPractice: 'no', recovers: 'no', price: 'Free · $4.99/mo' },
  { name: 'Shovel', courseAware: 'yes', weightedDeadlines: 'yes', whatsNext: 'no', spacedPractice: 'no', recovers: 'no', price: 'Paid after trial' },
  { name: 'Todoist', courseAware: 'no', weightedDeadlines: 'no', whatsNext: 'no', spacedPractice: 'no', recovers: 'no', price: 'Free · $4/mo' },
  { name: 'Notion', courseAware: 'some', weightedDeadlines: 'some', whatsNext: 'no', spacedPractice: 'no', recovers: 'no', price: 'Free plan' },
  { name: 'Motion', courseAware: 'no', weightedDeadlines: 'no', whatsNext: 'no', spacedPractice: 'no', recovers: 'yes', price: '~$19/mo' },
  { name: 'Anki', courseAware: 'no', weightedDeadlines: 'no', whatsNext: 'some', spacedPractice: 'yes', recovers: 'no', price: 'Free' },
  { name: 'Quizlet', courseAware: 'no', weightedDeadlines: 'no', whatsNext: 'no', spacedPractice: 'some', recovers: 'no', price: 'Free · $35.99/yr' },
];

const columns: Array<[keyof Row, string]> = [
  ['courseAware', 'Course-aware planning'],
  ['weightedDeadlines', 'Weighted deadlines'],
  ['whatsNext', 'What to study next'],
  ['spacedPractice', 'Spaced practice'],
  ['recovers', 'Recovers after a bad week'],
];

const glyph: Record<Cell, string> = { yes: '✓', some: 'some', no: '–' };
---
<section id="glance" class="glance rd-section">
  <div class="rd-container">
    <p class="rd-kicker" data-reveal><span class="kdot"></span>At a glance</p>
    <h2 class="glance-title rd-h2">The spec sheet, if you just want the grid.</h2>

    <div class="glance-table-wrap rd-card" data-reveal="scale">
      <table class="glance-table">
        <thead>
          <tr>
            <th scope="col">App</th>
            {columns.map(([, label]) => <th scope="col">{label}</th>)}
            <th scope="col">Price</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class={row.lead ? 'glance-row-lead' : undefined}>
              <th scope="row">{row.name}</th>
              {columns.map(([key]) => (
                <td class={`glance-cell glance-cell-${row[key] as Cell}`}>
                  <span aria-hidden="true">{glyph[row[key] as Cell]}</span>
                  <span class="glance-sr">
                    {row[key] === 'yes' ? 'Yes' : row[key] === 'some' ? 'Partially' : 'No'}
                  </span>
                </td>
              ))}
              <td class="glance-price">{row.price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .glance {
    padding-block: clamp(56px, 9vw, 100px);
  }

  .kdot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--rd-accent);
    box-shadow: 0 0 0 4px oklch(65% 0.2 2 / 0.16);
  }

  .glance-title {
    margin-top: 16px;
    max-width: 22ch;
    margin-bottom: 36px;
  }

  .glance-table-wrap {
    padding: 0;
    overflow-x: auto;
    /* Table legibility keeps its own scroll container — the page itself must
       never scroll horizontally, even at 360px. */
  }

  .glance-table {
    width: 100%;
    min-width: 780px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .glance-table th,
  .glance-table td {
    padding: 15px 18px;
    text-align: left;
    border-bottom: 1.5px solid oklch(52% 0.06 305 / 0.12);
    white-space: nowrap;
  }

  .glance-table thead th {
    font-family: var(--rd-body);
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--rd-ink-faint);
    white-space: normal;
  }

  .glance-table tbody th {
    font-family: var(--rd-display);
    font-weight: 640;
    color: var(--rd-ink);
  }

  .glance-row-lead {
    background: oklch(65% 0.2 2 / 0.1);
  }

  .glance-row-lead th {
    color: var(--rd-accent-deep);
  }

  .glance-table tbody tr:last-child td,
  .glance-table tbody tr:last-child th {
    border-bottom: none;
  }

  .glance-cell {
    font-family: var(--mk-font-mono);
    font-size: 13px;
  }

  .glance-cell-yes { color: var(--rd-accent-deep); font-weight: 700; }
  .glance-cell-some { color: var(--rd-ink-soft); }
  .glance-cell-no { color: var(--rd-ink-faint); }

  .glance-price {
    color: var(--rd-ink-soft);
    font-family: var(--mk-font-mono);
    font-size: 13px;
  }

  .glance-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .glance-table-wrap {
      border-radius: var(--rd-r-md);
    }
  }
</style>
