---
// Pure extraction from profile.astro's "Mastery by course" section — no
// behavior change, same markup/classes.
import MasteryBar from '../course/MasteryBar.astro';

interface Props {
  byCourse: Array<{ course_id: string; course_title: string; mastery: number }>;
  slugByCourse: Map<string, string>;
}
const { byCourse, slugByCourse } = Astro.props;
---
<section class="card">
  <h2>Mastery by course</h2>
  {byCourse.length === 0 ? (
    <p class="placeholder">No courses yet.</p>
  ) : (
    <ul class="course-mastery-list">
      {byCourse.map((c) => (
        <li>
          <a href={`/courses/${slugByCourse.get(c.course_id) ?? ''}`}>{c.course_title}</a>
          <span class="bar-wrap"><MasteryBar mastery={c.mastery} /></span>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  section.card { margin-bottom: 1.75rem; }
  .card h2 { font-size: 1.05rem; margin: 0 0 1rem; }
  .placeholder { color: var(--muted); font-size: 0.9rem; }
  .course-mastery-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.65rem; }
  .course-mastery-list li { display: flex; align-items: center; gap: 0.8rem; }
  .course-mastery-list a { flex: 0 0 auto; min-width: 0; max-width: 55%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.9rem; text-decoration: none; }
  .bar-wrap { flex: 1; }
</style>
