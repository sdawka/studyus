---
// Sticky header shell. Kept dumb — right-cluster interactivity (record
// event, scratchpad, todo, notifications, avatar menu) lives in the
// HeaderActions.svelte island; this file just fetches what the island needs
// server-side (user identity + course list for hue/course-select context)
// and mounts it.
import { env } from 'cloudflare:workers';
import { getDb } from '../../db/client';
import { listCourses } from '../../lib/services/courses';
import { toApi } from '../../lib/serialize';
import HeaderActions from './HeaderActions.svelte';

const user = Astro.locals.user!;
const initials = (user.name || user.email)
  .split(/\s+/)
  .map((p) => p[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const db = getDb(env.DB);
const courses = await listCourses(db, user.id);
// toApi is typed as `<T>(value: T): T` (see src/lib/serialize.ts) so its
// static type doesn't reflect the snake_case keys it produces at runtime —
// `c` is genuinely just a bag of unknowns here, so each field picked for
// the HeaderActions `Course[]` prop is shaped/coerced explicitly.
const apiCourses = toApi(courses).map((c: Record<string, unknown>) => ({
  id: String(c.id),
  code: String(c.code),
  slug: String(c.slug),
  title: String(c.title),
  color: c.color as string | number | null | undefined,
}));
---
<header class="app-header">
  <a class="brand-mini" href="/dashboard" title="Home" aria-label="studyus home">
    <span class="brand-mark">su</span>
  </a>
  <div class="center">
    <slot name="center" />
  </div>
  <div class="actions">
    <HeaderActions client:load userName={user.name || user.email} userInitials={initials} courses={apiCourses} />
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 30;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 20px;
    background: color-mix(in oklch, var(--surface) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .center { flex: 1; min-width: 0; display: flex; align-items: center; height: 100%; }
  .actions { display: flex; align-items: center; gap: 8px; flex: none; }

  /* Desktop: the sidebar already carries the "su" brand mark, so the
     header doesn't need its own. Mobile hides the sidebar entirely
     (docs/design/mobile-shell.md), so this is the only brand mark
     on-screen there — same visual language as Sidebar.astro's .brand-mark. */
  .brand-mini { display: none; }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--accent);
    color: var(--surface);
    font: 700 11px/1 var(--font-display);
  }

  @media (max-width: 767px) {
    .app-header {
      height: calc(var(--header-h) + env(safe-area-inset-top));
      padding-top: env(safe-area-inset-top);
    }
    .brand-mini { display: grid; flex: none; }
  }
</style>
