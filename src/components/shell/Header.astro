---
// Sticky header shell. Kept dumb — P2A wires up NotificationsBell,
// TodoDropdown, ScratchpadPopup, AvatarMenu as HeaderActions.svelte; this
// version keeps LogEventModal working (it renders its own trigger button)
// and stubs the rest as disabled placeholders so the feature set doesn't
// regress mid-build.
import LogEventModal from '../events/LogEventModal.svelte';
import Icon from './Icon.astro';

const user = Astro.locals.user!;
const initials = (user.name || user.email)
  .split(/\s+/)
  .map((p) => p[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---
<header class="app-header">
  <div class="center">
    <slot name="center" />
  </div>
  <div class="actions">
    <LogEventModal client:load />
    <button type="button" class="icon-btn" aria-disabled="true" title="coming in this build">
      <Icon name="bell" />
    </button>
    <button type="button" class="icon-btn" aria-disabled="true" title="coming in this build">
      <Icon name="check-square" />
    </button>
    <button type="button" class="icon-btn" aria-disabled="true" title="coming in this build">
      <Icon name="pencil" />
    </button>
    <a class="avatar" href="/profile" title={user.name || user.email}>{initials}</a>
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 30;
    height: 56px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 20px;
    background: color-mix(in oklch, var(--surface) 90%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }
  .center { flex: 1; min-width: 0; display: flex; align-items: center; height: 100%; }
  .actions { display: flex; align-items: center; gap: 8px; flex: none; }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    color: var(--muted);
  }
  .icon-btn:hover { background: var(--hover); }
  .icon-btn[aria-disabled='true'] { opacity: 0.4; cursor: default; }
  .icon-btn[aria-disabled='true']:hover { background: none; }

  .avatar {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font: 650 12px/1 var(--font-display);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
</style>
