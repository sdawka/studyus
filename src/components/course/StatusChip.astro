---
interface Props {
  status: string | null;
}
const { status } = Astro.props;
const labels: Record<string, string> = {
  'not-started': 'Not started',
  learning: 'Learning',
  review: 'Review',
  mastered: 'Mastered',
};
const s = status ?? 'not-started';
---
<span class={`status-chip status-${s}`}>{labels[s] ?? s}</span>

<style>
  .status-chip {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-not-started { background: var(--hairline); color: var(--muted); }
  .status-learning { background: var(--warn-soft); color: var(--warn); }
  .status-review { background: var(--accent-soft); color: var(--accent); }
  .status-mastered { background: var(--good-soft); color: var(--good); }
</style>
