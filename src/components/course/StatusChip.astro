---
interface Props {
  status: string | null;
}
const { status } = Astro.props;
const labels: Record<string, string> = {
  'not-started': 'Not started',
  learning: 'Learning',
  review: 'Review',
  mastered: 'Mastered',
};
const s = status ?? 'not-started';
---
<span class={`status-chip status-${s}`}>{labels[s] ?? s}</span>

<style>
  .status-chip {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .status-not-started { background: #f1f2f4; color: #6b7280; }
  .status-learning { background: #fef3c7; color: #92400e; }
  .status-review { background: #dbe6fb; color: #2b4f9e; }
  .status-mastered { background: #dcfce7; color: #166534; }
</style>
