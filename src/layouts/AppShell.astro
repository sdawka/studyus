---
interface Props {
  title: string;
}
const { title } = Astro.props;

const adminLinks = [
  { href: '/dashboard', label: 'Dashboard' },
  { href: '/calendar', label: 'Calendar' },
  { href: '/grades', label: 'Grades' },
];

const learningLinks = [
  { href: '/feed', label: 'Feed' },
  { href: '/courses', label: 'Courses' },
  { href: '/study', label: 'Study' },
  { href: '/notes', label: 'Notes' },
  { href: '/tasks', label: 'Tasks' },
  { href: '/profile', label: 'Profile' },
];

const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · StudyBuddy</title>
    <style>
      :root {
        --accent: #3f6fd8;
        --bg: #fafafa;
        --panel: #ffffff;
        --text: #1c1e21;
        --muted: #6b7280;
        --border: #e5e7eb;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        display: flex;
        min-height: 100vh;
      }
      nav.sidebar {
        width: 220px;
        flex-shrink: 0;
        background: var(--panel);
        border-right: 1px solid var(--border);
        padding: 1.5rem 1rem;
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
      }
      .brand {
        font-weight: 600;
        font-size: 1.1rem;
        padding: 0 0.5rem;
      }
      .nav-group h2 {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        margin: 0 0 0.5rem 0.5rem;
      }
      .nav-group ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }
      .nav-group a {
        display: block;
        padding: 0.5rem 0.5rem;
        border-radius: 8px;
        color: var(--text);
        text-decoration: none;
        font-size: 0.92rem;
      }
      .nav-group a:hover { background: #f0f2f5; }
      .nav-group a.active { background: var(--accent); color: white; }
      main {
        flex: 1;
        padding: 2.5rem 3rem;
        max-width: 960px;
      }
      main h1 { margin-top: 0; }
      .record-event-btn {
        margin-top: auto;
        background: var(--accent);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        font-size: 0.9rem;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <nav class="sidebar">
      <div class="brand">StudyBuddy</div>
      <div class="nav-group">
        <h2>Admin</h2>
        <ul>
          {adminLinks.map((link) => (
            <li><a href={link.href} class={currentPath === link.href ? 'active' : ''}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="nav-group">
        <h2>Learning</h2>
        <ul>
          {learningLinks.map((link) => (
            <li><a href={link.href} class={currentPath === link.href ? 'active' : ''}>{link.label}</a></li>
          ))}
        </ul>
      </div>
      <button class="record-event-btn" type="button" title="Coming soon">Record event</button>
    </nav>
    <main>
      <slot />
    </main>
  </body>
</html>
