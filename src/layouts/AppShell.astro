---
import '../styles/tokens.css';
import '../styles/fonts/compass.css';
import '../styles/fonts/focus.css';
import '../styles/fonts/campus.css';
import '../styles/themes/compass.css';
import '../styles/themes/focus.css';
import '../styles/themes/campus.css';
import '../styles/base.css';
import ThemeScript from '../components/shell/ThemeScript.astro';
import Sidebar from '../components/shell/Sidebar.astro';
import Header from '../components/shell/Header.astro';
import AddCourseModal from '../components/shell/AddCourseModal.svelte';
import BottomNav from '../components/shell/BottomNav.astro';
import Toast from '../components/shell/Toast.svelte';
import CalendarActivitySync from '../components/shell/CalendarActivitySync.svelte';
import AnalyticsBootstrap from '../components/AnalyticsBootstrap.astro';
import { resolveSettings } from '../lib/services/user';

interface Props {
  title: string;
}
const { title } = Astro.props;

const settings = resolveSettings(Astro.locals.user?.settings);
const themeAttr = settings.theme === 'compass' ? undefined : settings.theme;
const schemeAttr = settings.scheme === 'system' ? undefined : settings.scheme;
const sidebarAttr = settings.sidebar_collapsed ? 'collapsed' : undefined;
---
<!doctype html>
<html lang="en" data-theme={themeAttr} data-scheme={schemeAttr} data-sidebar={sidebarAttr}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · studyus</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- Media-keyed pair covers the OS-default (system scheme) case; when the
         user has an explicit data-scheme override, ThemeScript.astro (which
         runs before first paint) overwrites both metas' content with the
         resolved scheme's hex so status bar / task-switcher chrome matches
         the override rather than the OS setting. -->
    <meta name="theme-color" content="#f6f9fb" media="(prefers-color-scheme: light)" id="theme-color-light" />
    <meta name="theme-color" content="#0b0e10" media="(prefers-color-scheme: dark)" id="theme-color-dark" />
    <ThemeScript />
  </head>
  <body>
    <div class="shell">
      <Sidebar />
      <AddCourseModal client:idle />
      <div class="shell-main">
        <Header>
          <slot name="header-center" slot="center" />
        </Header>
        <main>
          <slot />
        </main>
      </div>
    </div>
    <BottomNav />
    <Toast client:load />
    <CalendarActivitySync userKey={Astro.locals.user!.id} client:load />
    <!-- Direct body child, after .shell. Route-modal layers (planner.astro,
         tasks.astro) and any future overlay render here instead of inside
         main's default slot — main has `container-type: inline-size`, which
         implies `contain: layout` and makes main the containing block (and
         stacking context) for every `position: fixed` descendant, so a
         fixed layer rendered inside main only covers main's box and paints
         under the sticky header instead of covering the viewport. See
         docs/design/mobile-shell.md for the full writeup. -->
    <slot name="overlay" />
    <AnalyticsBootstrap userId={Astro.locals.user!.id} analyticsOptOut={settings.analytics_opt_out} />
    <!-- The TEMPORARY docs annotation overlay used to mount here as a
         flag-guarded `client:idle` island. It does not any more: Astro
         registers `client:*` islands at build-analysis time, so the guard
         folded to false server-side but still emitted a 55.5K chunk of
         internal annotation prose into dist/. It is now injected by
         docsOverlayIntegration() in astro.config.mjs, which no-ops for
         `astro build` — see src/lib/docs-overlay/integration.mjs and
         docs/product/annotations.md. Nothing to remove here. -->
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w, 240px) 1fr;
    min-height: 100vh;
    min-height: 100dvh;
  }
  :global(html[data-sidebar='collapsed']) .shell {
    grid-template-columns: 60px 1fr;
  }
  .shell-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  main {
    flex: 1;
    padding: var(--content-pad-top) var(--content-pad-x) var(--content-pad-bottom);
    max-width: var(--content-max);
    width: 100%;
    margin-inline: auto;
    /* Gentle once-per-navigation entrance (Astro pages are full MPA
       navigations, so this doesn't replay on every in-page re-render).
       prefers-reduced-motion is handled globally in base.css, which zeroes
       animation-duration so this resolves instantly to its end state. */
    animation: page-enter 360ms var(--ease, cubic-bezier(0.22, 1, 0.36, 1)) both;
    /* Query container for page layout breakpoints (dashboard rail,
       week-strip columns, feed masonry). Pages query the actual content
       width here (content-box, padding-independent), not the viewport, so
       breakpoints fire correctly in both sidebar states — page-level rules
       comment their threshold as "main content-box ≤ Xpx".
       Rule of thumb (docs/design/mobile-shell.md has the full writeup):
       @container (vs this element) = page-content layout, unrelated to
       viewport size; @media (max-width: 767px) = shell chrome +
       viewport-fixed overlays only (bottom nav, sheets, route-layer mobile
       restyle) — it never reflows a page's internal grids, which stay on
       @container thresholds; @media (hover: none) / (pointer: fine) =
       touch affordances only, never layout. */
    container-type: inline-size;
  }

  @media (max-width: 767px) {
    .shell {
      grid-template-columns: 1fr;
    }
  }

  @keyframes page-enter {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
