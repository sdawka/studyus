---
// Wraps AppShell with the 6-tab course header. All six subroutes
// (index/concepts/notes/resources/practice/play, P2C) adopt this layout.
import AppShell from './AppShell.astro';
import { hueFor } from '../lib/courseHue';
import CourseContextSetter from '../components/shell/CourseContextSetter.svelte';

interface Course {
  id: string;
  slug: string;
  code: string;
  title: string;
  term: string | null;
  instructor: string | null;
  color: string | null;
}

interface Props {
  course: Course;
  active: 'overview' | 'concepts' | 'notes' | 'resources' | 'practice' | 'play';
}
const { course, active } = Astro.props;

const TABS: { id: Props['active']; label: string; href: string }[] = [
  { id: 'overview', label: 'Overview', href: `/courses/${course.slug}` },
  { id: 'concepts', label: 'Concepts', href: `/courses/${course.slug}/concepts` },
  { id: 'notes', label: 'Class notes', href: `/courses/${course.slug}/notes` },
  { id: 'resources', label: 'Resources', href: `/courses/${course.slug}/resources` },
  { id: 'practice', label: 'Practice', href: `/courses/${course.slug}/practice` },
  { id: 'play', label: 'Play', href: `/courses/${course.slug}/play` },
];

const courseH = hueFor(course);
---
<AppShell title={`${course.code} · ${course.title}`}>
  <CourseContextSetter client:load id={course.id} slug={course.slug} code={course.code} title={course.title} />

  <nav class="tab-bar" slot="header-center" aria-label="Course sections">
    {TABS.map((t) => (
      <a href={t.href} aria-current={t.id === active ? 'page' : undefined}>{t.label}</a>
    ))}
  </nav>

  <script>
    // Mobile only (docs/design/mobile-shell.md's plain-<script> convention —
    // literal query, not the isMobile store): keep the active course tab
    // visible when the strip doesn't fit the viewport.
    if (window.matchMedia('(max-width: 767px)').matches) {
      document
        .querySelector('.tab-bar a[aria-current="page"]')
        ?.scrollIntoView({ inline: 'center', block: 'nearest' });
    }
  </script>

  <div class="course-head" style={`--course-h: ${courseH}`}>
    <span class="code-badge">{course.code}</span>
    <h1>{course.title}</h1>
    <p class="meta">
      {course.term && <span>{course.term}</span>}
      {course.instructor && <span> · {course.instructor}</span>}
    </p>
  </div>

  <slot />
</AppShell>

<style>
  .tab-bar {
    display: flex;
    gap: 4px;
    height: 100%;
    align-items: center;
    overflow-x: auto;
  }
  .tab-bar a {
    position: relative;
    top: 1px;
    padding: 8px 4px;
    margin: 0 8px;
    font-size: 13.5px;
    font-weight: 550;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
  }
  .tab-bar a:hover { color: var(--text); }
  .tab-bar a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--accent);
  }

  .course-head { margin-bottom: 22px; }
  .code-badge {
    display: inline-flex;
    align-items: center;
    background: var(--course-soft);
    color: var(--course-ink);
    border-radius: var(--radius-sm);
    padding: 3px 9px;
    font: 650 11.5px/1 var(--font-mono);
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .course-head h1 { font-size: 24px; letter-spacing: -0.015em; margin: 2px 0 4px; }
  .course-head .meta { color: var(--muted); font-size: 13.5px; }

  /* main content-box ≤ 720px (docs/design/mobile-shell.md's @container
     convention — measured on main's content-box, padding-independent). */
  @container (max-width: 720px) {
    .course-head h1 { font-size: 20px; }
  }

  /* Shell chrome, not page content → @media, not @container (mobile-shell.md).
     Snap scrolling + edge-fade signal the strip scrolls; tap targets grow to
     the 44px minimum within the header's existing height (align-items:center
     on .tab-bar centers the taller link inside the unchanged 56px row). */
  @media (max-width: 767px) {
    .tab-bar {
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      mask-image: linear-gradient(
        to right,
        transparent 0,
        black 20px,
        black calc(100% - 20px),
        transparent 100%
      );
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0,
        black 20px,
        black calc(100% - 20px),
        transparent 100%
      );
    }
    .tab-bar a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      /* center, not start — matches the active-tab script's
         scrollIntoView({inline:'center'}); start fights proximity snapping
         into pulling the resting scroll position off-center. */
      scroll-snap-align: center;
    }
  }
</style>
