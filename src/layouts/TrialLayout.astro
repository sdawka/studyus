---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/nunito';
import '../styles/marketing-rd.css';

interface Props {
  title?: string;
}
const { title = 'Try studyus in two minutes' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Set up a semester and explore how studyus handles real student situations—no account required." />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
  </head>
  <body><slot /></body>
</html>

<style is:global>
  html, body { margin: 0; min-height: 100%; background: #f8f5ff; color: #241f2e; }
  *, *::before, *::after { box-sizing: border-box; }
  button, input, select, textarea { font: inherit; }
</style>
