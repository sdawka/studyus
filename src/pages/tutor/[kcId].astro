---
import { env } from 'cloudflare:workers';
import AppShell from '../../layouts/AppShell.astro';
import { getDb } from '../../db/client';
import { getKc } from '../../lib/services/kcs';
import { createConversation, getConversation } from '../../lib/services/tutor/conversations';
import ScaffoldChat from '../../components/tutor/ScaffoldChat.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const kcId = Astro.params.kcId!;

const kc = await getKc(db, userId, kcId);

const existingId = Astro.url.searchParams.get('c');
if (!existingId) {
  const created = await createConversation(db, userId, { kc_id: kcId });
  return Astro.redirect(`/tutor/${kcId}?c=${created.id}`);
}

const conversation = await getConversation(db, userId, existingId);

const initialMessages = conversation.messages.map((m) => ({
  id: m.id,
  role: m.role as 'user' | 'assistant',
  content: m.content,
}));

const MODE_LABELS: Record<string, string> = {
  recall: 'Spaced recall',
  classify: 'Classification practice',
  worked_example: 'Worked example',
  self_explain: 'Self-explanation',
  interactive_model: 'Interactive model',
};
---

<AppShell title={`Tutor · ${kc.name}`}>
  <div class="tutor-header">
    <h1>{kc.name}</h1>
    <span class="mode-badge">{MODE_LABELS[conversation.mode] ?? conversation.mode}</span>
    <p class="muted">Mastery: {kc.mastery}% · {kc.status}</p>
  </div>
  <ScaffoldChat conversationId={conversation.id} mode={conversation.mode} initialMessages={initialMessages} client:load />
</AppShell>

<style>
  .tutor-header {
    margin-bottom: 1.5rem;
  }
  .mode-badge {
    display: inline-block;
    background: #eef2ff;
    color: var(--accent, #3f6fd8);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .muted {
    color: #6b7280;
    font-size: 0.9rem;
  }
</style>
