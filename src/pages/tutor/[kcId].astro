---
import { env } from 'cloudflare:workers';
import AppShell from '../../layouts/AppShell.astro';
import { getDb } from '../../db/client';
import { getKc } from '../../lib/services/kcs';
import { createRuntimeConversation, getRuntimeConversation } from '../../lib/runtime/tutorRuntime';
import { toApi } from '../../lib/serialize';
import type { RuntimeConversation } from '../../lib/stores/learnerRuntime';
import { NotFoundError, notFound } from '../../lib/handleNotFound';
import ScaffoldChat from '../../components/tutor/ScaffoldChat.svelte';
import { getAiCapabilities } from '../../lib/ai/capabilities';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const kcId = Astro.params.kcId!;
const aiCapabilities = getAiCapabilities(env);

let kc;
try {
  kc = await getKc(db, userId, kcId);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}

const existingId = Astro.url.searchParams.get('c');
if (!existingId) {
  if (aiCapabilities.features.tutor) {
    const created = await createRuntimeConversation(db, env, userId, { kc_id: kcId });
    return Astro.redirect(`/tutor/${kcId}?c=${created.id}`);
  }
}

let conversation;
if (existingId) {
  try {
    conversation = await getRuntimeConversation(db, env, userId, existingId);
  } catch (err) {
    if (err instanceof NotFoundError) return notFound(Astro);
    throw err;
  }
}

const initialConversation = conversation ? toApi(conversation) as unknown as RuntimeConversation : null;

const MODE_LABELS: Record<string, string> = {
  recall: 'Spaced recall',
  classify: 'Classification practice',
  worked_example: 'Worked example',
  self_explain: 'Self-explanation',
  interactive_model: 'Interactive model',
};
---

<AppShell title={`Tutor · ${kc.name}`}>
  <div class="tutor-header">
    <h1>{kc.name}</h1>
    {conversation && <span class="mode-badge">{MODE_LABELS[conversation.mode] ?? conversation.mode}</span>}
    <p class="muted">Mastery: {kc.mastery}% · {kc.status}</p>
  </div>
  {initialConversation ? (
    <ScaffoldChat
      {initialConversation}
      kcId={kc.id}
      aiEnabled={aiCapabilities.features.tutor}
      aiUnavailableReason={aiCapabilities.reason}
      client:load
    />
  ) : (
    <div class="ai-gate" role="status" data-ai-feature="tutor">
      <strong>AI tutor unavailable</strong>
      <p>{aiCapabilities.reason === 'provider_not_configured' ? 'OpenRouter is not configured for this environment.' : 'AI tutoring is disabled in this environment.'}</p>
      <a href="/courses">Continue with non-AI study tools</a>
    </div>
  )}
</AppShell>

<style>
  .tutor-header {
    margin-bottom: 1.5rem;
  }
  .mode-badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .muted {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .ai-gate { max-width: 640px; padding: 1rem; border: 1px solid var(--warn); border-radius: var(--radius-md); background: var(--warn-soft); color: var(--warn-ink); }
  .ai-gate p { margin: 0.35rem 0 0.75rem; }
  .ai-gate a { color: inherit; font-weight: 600; }
</style>
