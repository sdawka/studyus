---
import AppShell from '../layouts/AppShell.astro';
import WeekView from '../components/dashboard/WeekView.svelte';
import TodayTasks from '../components/dashboard/TodayTasks.svelte';
import CourseCards from '../components/dashboard/CourseCards.astro';
import DeadlinesList from '../components/dashboard/DeadlinesList.astro';
import RecordEventCard from '../components/dashboard/RecordEventCard.astro';
import NextMoveCard from '../components/dashboard/NextMoveCard.svelte';
import { hueFor } from '../lib/courseHue';
import { toApi } from '../lib/serialize';
import { env } from 'cloudflare:workers';
import { getDb } from '../db/client';
import { listCourses } from '../lib/services/courses';
import { getCalendar } from '../lib/services/calendar';
import { getGradesSummary } from '../lib/services/grades';
import { listTasks } from '../lib/services/tasks';
import { sweepTasks } from '../lib/services/taskSweep';
import { getNextMove } from '../lib/services/nextMove';
import type { NextMoveResponse } from '../lib/schemas/nextMove';

const db = getDb(env.DB);
const user = Astro.locals.user!;
const userId = user.id;

const now = Date.now();
const weekFromNow = now + 7 * 24 * 60 * 60 * 1000;

// One explicit sweep up front, then every fetch below opts out of its own
// internal sweep (both getCalendar and listTasks otherwise run the full
// sweepTasks again) so the four independent reads can run in parallel
// instead of a serialized await chain.
await sweepTasks(db, userId, now);

const [userCourses, deadlines, gradesSummary, allTasks, nextMove] = await Promise.all([
  listCourses(db, userId),
  getCalendar(db, userId, now, weekFromNow, undefined, { sweep: false }),
  getGradesSummary(db, userId),
  listTasks(db, userId, { sweep: false }),
  getNextMove(db, userId, 25, now),
]);
const initialNextMove = toApi(nextMove) as NextMoveResponse;

const courseById = new Map(userCourses.map((c) => [c.id, c]));
const weightedGradeByCourse = new Map(gradesSummary.by_course.map((c) => [c.course_id, c.weighted_grade]));

// Per-course open-task count + earliest due date, for CourseCards' slim
// meta line — replaces the old KC/assessment progress queries now that
// task-open-count is the headline signal for a course, not mastery %.
const taskStatsByCourse = new Map<string, { count: number; nextDue: number | null }>();
for (const t of allTasks) {
  if (t.completed) continue;
  for (const c of t.courses) {
    const entry = taskStatsByCourse.get(c.id) ?? { count: 0, nextDue: null };
    entry.count += 1;
    if (t.dueDate !== null && (entry.nextDue === null || t.dueDate < entry.nextDue)) entry.nextDue = t.dueDate;
    taskStatsByCourse.set(c.id, entry);
  }
}

const courseCards = userCourses.map((c) => {
  const stats = taskStatsByCourse.get(c.id) ?? { count: 0, nextDue: null };
  return {
    id: c.id,
    slug: c.slug,
    code: c.code,
    title: c.title,
    color: c.color,
    weightedGrade: weightedGradeByCourse.get(c.id) ?? null,
    openTasks: stats.count,
    nextDueLabel: stats.nextDue !== null ? new Date(stats.nextDue).toLocaleDateString(undefined, { weekday: 'long' }) : null,
  };
});

const weekViewCourses = userCourses.map((c) => ({
  id: c.id,
  slug: c.slug,
  code: c.code,
  title: c.title,
  color: c.color !== null ? Number(c.color) : null,
}));

const todayTasksCourses = userCourses.map((c) => ({ id: c.id, code: c.code, hue: hueFor(c) }));

// Deadlines rail is assessments-only now (overdue-task nagging moved into
// TodayTasks/grade_entry tasks) — same DueItem row shape as before, just a
// narrower source feed.
type DueItem = { id: string; title: string; dueDate: number; courseCode: string | null; courseHue: number | null };
const deadlineItems: DueItem[] = deadlines
  .filter((item) => item.type === 'assessment_due')
  .map((item) => {
    const c = item.course_id ? courseById.get(item.course_id) : undefined;
    return { id: item.id, title: item.title, dueDate: Date.parse(item.date), courseCode: c?.code ?? null, courseHue: c ? hueFor(c) : null };
  })
  .sort((a, b) => a.dueDate - b.dueDate)
  .slice(0, 6);

const quickEventCourses = userCourses.map((c) => ({ id: c.id, code: c.code, title: c.title }));

// Page head: date + term kicker, a headline that names the most urgent
// item when there is one, quiet otherwise. Tasks-first: an overdue open
// task (never a past attend_class — missing a class isn't a broken
// commitment) beats a task due today, which beats the nearest assessment
// deadline.
const kicker = `${new Date(now).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })} · ${user.currentTerm ?? 'No term set'}`;

const startOfToday = new Date(now);
startOfToday.setHours(0, 0, 0, 0);
const startOfTomorrowMs = startOfToday.getTime() + 24 * 60 * 60 * 1000;

const overdueNonAttendTasks = allTasks
  .filter((t) => !t.completed && t.dueDate !== null && t.dueDate < now && t.type !== 'attend_class')
  .sort((a, b) => a.dueDate! - b.dueDate!);
const todaysOpenTasks = allTasks
  .filter((t) => !t.completed && t.dueDate !== null && t.dueDate >= startOfToday.getTime() && t.dueDate < startOfTomorrowMs)
  .sort((a, b) => a.dueDate! - b.dueDate!);
const mostUrgentTask = overdueNonAttendTasks[0] ?? todaysOpenTasks[0] ?? null;
const mostUrgentDeadline = deadlineItems[0];

let headline: string;
let sub: string;
if (userCourses.length === 0) {
  headline = "Let's get your first course set up.";
  sub = 'Add a course to start tracking grades, concepts, and what\'s due.';
} else if (mostUrgentTask) {
  const days = Math.round((mostUrgentTask.dueDate! - now) / 86400000);
  const weekday = new Date(mostUrgentTask.dueDate!).toLocaleDateString(undefined, { weekday: 'long' });
  const taskCourse = mostUrgentTask.courses[0] ? courseById.get(mostUrgentTask.courses[0].id) : undefined;
  const courseLabel = taskCourse ? ` — ${taskCourse.code} first` : '';
  headline = days < 0 ? `${mostUrgentTask.title} is overdue${courseLabel}.` : `${mostUrgentTask.title} ${weekday}${courseLabel}.`;
  sub = `${userCourses.length} course${userCourses.length === 1 ? '' : 's'} in progress.`;
} else if (mostUrgentDeadline) {
  const days = Math.round((mostUrgentDeadline.dueDate - now) / 86400000);
  const weekday = new Date(mostUrgentDeadline.dueDate).toLocaleDateString(undefined, { weekday: 'long' });
  const courseLabel = mostUrgentDeadline.courseCode ? ` — ${mostUrgentDeadline.courseCode} first` : '';
  headline = days < 0 ? `${mostUrgentDeadline.title} is overdue${courseLabel}.` : `${mostUrgentDeadline.title} ${weekday}${courseLabel}.`;
  sub = `${userCourses.length} course${userCourses.length === 1 ? '' : 's'} in progress.`;
} else {
  headline = "Here's your week at a glance.";
  sub = `${userCourses.length} course${userCourses.length === 1 ? '' : 's'} in progress — nothing urgent due.`;
}
---

<AppShell title="Dashboard">
  <div class="page-head">
    <p class="kicker">{kicker}</p>
    <h1>{headline}</h1>
    <p class="sub">{sub}</p>
  </div>

  <div class="grid">
    {userCourses.length === 0 ? (
      <div class="main">
        <div class="card setup-card">
          <h2>Add your first course</h2>
          <p>Once you add a course, your week at a glance, grade snapshot, and concept mastery will show up here.</p>
          <button type="button" class="btn btn-primary" id="setup-add-course">Add your first course</button>
        </div>
      </div>
    ) : (
      <div class="main">
        <div class="slot-today">
          <TodayTasks client:load initialTasks={toApi(allTasks)} courses={todayTasksCourses} />
        </div>
        <div class="slot-next-move">
          <NextMoveCard client:load initialResponse={initialNextMove} />
        </div>
        <div class="slot-week">
          <WeekView client:load initialItems={deadlines} courses={weekViewCourses} />
        </div>
        <div class="slot-courses">
          <CourseCards courses={courseCards} />
        </div>
      </div>
    )}

    <aside class="rail">
      <div class="slot-record">
        <RecordEventCard courses={quickEventCourses} />
      </div>
      <div class="slot-deadlines">
        <DeadlinesList items={deadlineItems} />
      </div>
    </aside>
  </div>
</AppShell>

<script>
  document.getElementById('setup-add-course')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-add-course'));
  });
</script>

<style>
  .page-head {
    margin-bottom: 26px;
  }
  .page-head h1 {
    font-size: 26px;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .page-head .sub {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 22px;
    align-items: start;
  }
  .main {
    display: grid;
    gap: 22px;
    min-width: 0;
  }
  .rail {
    display: grid;
    gap: 22px;
    /* .rail is a grid item in .grid's fixed 320px column; without this,
       its default min-width:auto lets child content (e.g. RecordEventCard's
       <select>) grow it past that column and off the page. */
    min-width: 0;
  }
  /* Same default-min-width:auto issue one level down: the .slot-record/
     .slot-deadlines wrapper divs (not RecordEventCard/DeadlinesList's
     .card sections directly — the slot wrapper is what's actually the
     grid item now) need the same override. */
  .rail > div {
    min-width: 0;
  }
  /* One level deeper still: QuickEventForm's <form> lays its two
     <label> fields out in a row, but the labels' default min-width:auto
     (driven by the "Course" select's longest option text) keeps them
     from shrinking to fit the 320px rail. Scoped to this page's rail
     rather than editing that component. */
  .rail :global(label) {
    min-width: 0;
  }
  .rail :global(select),
  .rail :global(input) {
    min-width: 0;
    max-width: 100%;
  }

  .setup-card p {
    color: var(--muted);
    font-size: 14px;
    margin: 8px 0 16px;
  }

  /* Queries the AppShell <main> content container (sidebar-aware, not
     the viewport) so the rail stacks based on actual available width
     in both sidebar states. Threshold is 1000px of *main's own rendered
     width* minus its 64px horizontal padding (32px each side) — @container
     always measures the container's content-box, not border-box, so the
     written value must subtract that padding to land the stack point
     where "main width < 1000px" actually reads as intended. */
  @container (max-width: 936px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  /* STACK — main content-box ≤ 720px. Reflows reading order for mobile:
     TodayTasks (hallway job — check things off) first, then Next Move,
     the week strip, deadlines, course cards, and the record-event form.
     .main/.rail already stack to one column above this (the 936 rule),
     so grid-template-columns is redeclared here to keep the block
     self-contained. display:contents on both promotes every .slot-*
     wrapper to a direct child of .grid so `order` can reflow them
     purely visually; DOM/reader order is untouched (today→week→courses
     in .main, record→deadlines in .rail per the JSX above), so screen
     readers and Tab order still see the original document structure. */
  @container (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .main,
    .rail {
      display: contents;
    }
    /* Same default-min-width:auto issue as .main/.rail above, one level
       down: once display:contents promotes the slot-* divs to direct
       items of .grid's single shared column, any one of them with
       unshrinkable content (e.g. CourseCards' snap row) would blow up
       that column's width for every row — including WeekView's, whose
       compact WeekGrid measures its own rendered width via bind:clientWidth
       and would misread the inflated width as room for more days. */
    .slot-week,
    .slot-today,
    .slot-next-move,
    .slot-courses,
    .slot-record,
    .slot-deadlines {
      min-width: 0;
    }
    .slot-today {
      order: 1;
    }
    .slot-next-move {
      order: 2;
    }
    .slot-week {
      order: 3;
    }
    .slot-deadlines {
      order: 4;
    }
    .slot-courses {
      order: 5;
    }
    .slot-record {
      order: 6;
    }

    .page-head {
      margin-bottom: 16px;
    }
    .page-head h1 {
      font-size: 21px;
    }
    .page-head .sub {
      font-size: 13.5px;
    }
  }
</style>
