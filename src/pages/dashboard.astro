---
import AppShell from '../layouts/AppShell.astro';
import WeekView from '../components/dashboard/WeekView.svelte';
import CourseCards from '../components/dashboard/CourseCards.astro';
import DueList from '../components/dashboard/DueList.astro';
import RecordEventCard from '../components/dashboard/RecordEventCard.astro';
import { hueFor } from '../lib/courseHue';
import { env } from 'cloudflare:workers';
import { and, eq, inArray } from 'drizzle-orm';
import { getDb } from '../db/client';
import { assessments, kcs } from '../db/schema';
import { listCourses } from '../lib/services/courses';
import { getCalendar } from '../lib/services/calendar';
import { getGradesSummary } from '../lib/services/grades';
import { listTasks } from '../lib/services/tasks';

const db = getDb(env.DB);
const user = Astro.locals.user!;
const userId = user.id;

const userCourses = await listCourses(db, userId, { includeMastery: true });
const courseById = new Map(userCourses.map((c) => [c.id, c]));

const now = Date.now();
const weekFromNow = now + 7 * 24 * 60 * 60 * 1000;
const deadlines = await getCalendar(db, userId, now, weekFromNow);

const gradesSummary = await getGradesSummary(db, userId);
const weightedGradeByCourse = new Map(gradesSummary.by_course.map((c) => [c.course_id, c.weighted_grade]));

const allTasks = await listTasks(db, userId);
const overdueTasks = allTasks.filter((t) => !t.completed && t.dueDate !== null && t.dueDate < now);

// Concepts-mastered counts + last-activity timestamp per course, for the
// course cards — listCourses only exposes an averaged mastery %, not the
// "N of M" breakdown or staleness this card wants.
const courseIds = userCourses.map((c) => c.id);
const courseKcs = courseIds.length
  ? await db
      .select({ courseId: kcs.courseId, status: kcs.status, lastEventAt: kcs.lastEventAt })
      .from(kcs)
      .where(inArray(kcs.courseId, courseIds))
  : [];
const kcCountsByCourse = new Map<string, { total: number; mastered: number; lastEventAt: number | null }>();
for (const kc of courseKcs) {
  const entry = kcCountsByCourse.get(kc.courseId) ?? { total: 0, mastered: 0, lastEventAt: null };
  entry.total += 1;
  if (kc.status === 'mastered') entry.mastered += 1;
  if (kc.lastEventAt !== null && (entry.lastEventAt === null || kc.lastEventAt > entry.lastEventAt)) {
    entry.lastEventAt = kc.lastEventAt;
  }
  kcCountsByCourse.set(kc.courseId, entry);
}

// Assessment completion counts per course — completed means a grade is
// recorded, or the due date has passed (ungraded-but-past-due still counts
// as "done" for this progress readout). Official assessments only (v1.3.1)
// — practice assessments have their own progress readout, PracticeCard.
const courseAssessments = courseIds.length
  ? await db
      .select({ courseId: assessments.courseId, dueDate: assessments.dueDate, gradeReceived: assessments.gradeReceived })
      .from(assessments)
      .where(and(inArray(assessments.courseId, courseIds), eq(assessments.kind, 'official')))
  : [];
const assessmentCountsByCourse = new Map<string, { total: number; completed: number }>();
for (const a of courseAssessments) {
  const entry = assessmentCountsByCourse.get(a.courseId) ?? { total: 0, completed: 0 };
  entry.total += 1;
  if (a.gradeReceived !== null || (a.dueDate !== null && a.dueDate < now)) entry.completed += 1;
  assessmentCountsByCourse.set(a.courseId, entry);
}

const STALE_MS = 7 * 24 * 60 * 60 * 1000;
const courseCards = userCourses.map((c) => {
  const kcCounts = kcCountsByCourse.get(c.id) ?? { total: 0, mastered: 0, lastEventAt: null };
  const assessmentCounts = assessmentCountsByCourse.get(c.id) ?? { total: 0, completed: 0 };
  return {
    id: c.id,
    slug: c.slug,
    code: c.code,
    title: c.title,
    color: c.color,
    status: c.status,
    weightedGrade: weightedGradeByCourse.get(c.id) ?? null,
    masteredKcs: kcCounts.mastered,
    totalKcs: kcCounts.total,
    stale: kcCounts.lastEventAt !== null && now - kcCounts.lastEventAt >= STALE_MS,
    assessmentsCompleted: assessmentCounts.completed,
    assessmentsTotal: assessmentCounts.total,
  };
});

const weekViewCourses = userCourses.map((c) => ({
  id: c.id,
  slug: c.slug,
  code: c.code,
  title: c.title,
  color: c.color !== null ? Number(c.color) : null,
}));

// Unified "due soon" list for the rail: overdue tasks plus this week's
// assessments/tasks from the calendar, sorted ascending, top few.
type DueItem = { id: string; title: string; dueDate: number; courseCode: string | null; courseHue: number | null };
const dueItems: DueItem[] = [];

for (const t of overdueTasks) {
  const c = t.courses[0] ? courseById.get(t.courses[0].id) : undefined;
  dueItems.push({ id: t.id, title: t.title, dueDate: t.dueDate!, courseCode: c?.code ?? null, courseHue: c ? hueFor(c) : null });
}
for (const item of deadlines) {
  if (item.type === 'task_due' && item.details.done) continue;
  const c = item.course_id ? courseById.get(item.course_id) : undefined;
  dueItems.push({ id: item.id, title: item.title, dueDate: Date.parse(item.date), courseCode: c?.code ?? null, courseHue: c ? hueFor(c) : null });
}
dueItems.sort((a, b) => a.dueDate - b.dueDate);
const dueListItems = dueItems.slice(0, 6);

const quickEventCourses = userCourses.map((c) => ({ id: c.id, code: c.code, title: c.title }));

// Page head: date + term kicker, a headline that names the most urgent
// item when there is one, quiet otherwise.
const kicker = `${new Date(now).toLocaleDateString(undefined, { weekday: 'long', month: 'long', day: 'numeric' })} · ${user.currentTerm ?? 'No term set'}`;

const mostUrgent = dueListItems[0];
let headline: string;
let sub: string;
if (userCourses.length === 0) {
  headline = "Let's get your first course set up.";
  sub = 'Add a course to start tracking grades, concepts, and what\'s due.';
} else if (mostUrgent) {
  const days = Math.round((mostUrgent.dueDate - now) / 86400000);
  const weekday = new Date(mostUrgent.dueDate).toLocaleDateString(undefined, { weekday: 'long' });
  const courseLabel = mostUrgent.courseCode ? ` — ${mostUrgent.courseCode} first` : '';
  headline = days < 0 ? `${mostUrgent.title} is overdue${courseLabel}.` : `${mostUrgent.title} ${weekday}${courseLabel}.`;
  sub = `${userCourses.length} course${userCourses.length === 1 ? '' : 's'} in progress.`;
} else {
  headline = "Here's your week at a glance.";
  sub = `${userCourses.length} course${userCourses.length === 1 ? '' : 's'} in progress — nothing urgent due.`;
}
---

<AppShell title="Dashboard">
  <div class="page-head">
    <p class="kicker">{kicker}</p>
    <h1>{headline}</h1>
    <p class="sub">{sub}</p>
  </div>

  <div class="grid">
    {userCourses.length === 0 ? (
      <div class="main">
        <div class="card setup-card">
          <h2>Add your first course</h2>
          <p>Once you add a course, your week at a glance, grade snapshot, and concept mastery will show up here.</p>
          <button type="button" class="btn btn-primary" id="setup-add-course">Add your first course</button>
        </div>
      </div>
    ) : (
      <div class="main">
        <WeekView client:load initialItems={deadlines} courses={weekViewCourses} />
        <CourseCards courses={courseCards} />
      </div>
    )}

    <aside class="rail">
      <RecordEventCard courses={quickEventCourses} />
      <DueList items={dueListItems} />
    </aside>
  </div>
</AppShell>

<script>
  document.getElementById('setup-add-course')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-add-course'));
  });
</script>

<style>
  .page-head {
    margin-bottom: 26px;
  }
  .page-head h1 {
    font-size: 26px;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .page-head .sub {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 14.5px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 22px;
    align-items: start;
  }
  .main {
    display: grid;
    gap: 22px;
    min-width: 0;
  }
  .rail {
    display: grid;
    gap: 22px;
    /* .rail is a grid item in .grid's fixed 320px column; without this,
       its default min-width:auto lets child content (e.g. RecordEventCard's
       <select>) grow it past that column and off the page. */
    min-width: 0;
  }
  /* Same default-min-width:auto issue one level down: RecordEventCard and
     DueList's root .card sections are themselves grid items of .rail's
     implicit grid, so they need the same override. */
  .rail > :global(.card) {
    min-width: 0;
  }
  /* One level deeper still: QuickEventForm's <form> lays its two
     <label> fields out in a row, but the labels' default min-width:auto
     (driven by the "Course" select's longest option text) keeps them
     from shrinking to fit the 320px rail. Scoped to this page's rail
     rather than editing that component. */
  .rail :global(label) {
    min-width: 0;
  }
  .rail :global(select),
  .rail :global(input) {
    min-width: 0;
    max-width: 100%;
  }

  .setup-card p {
    color: var(--muted);
    font-size: 14px;
    margin: 8px 0 16px;
  }

  /* Queries the AppShell <main> content container (sidebar-aware, not
     the viewport) so the rail stacks based on actual available width
     in both sidebar states. Threshold is 1000px of *main's own rendered
     width* minus its 64px horizontal padding (32px each side) — @container
     always measures the container's content-box, not border-box, so the
     written value must subtract that padding to land the stack point
     where "main width < 1000px" actually reads as intended. */
  @container (max-width: 936px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
