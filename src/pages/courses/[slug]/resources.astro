---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { resources as resourcesTable } from '../../../db/schema';
import { and, eq } from 'drizzle-orm';
import { getCourseBySlug } from '../../../lib/services/courses';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import ResourceCard from '../../../components/feed/ResourceCard.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
try {
  course = await getCourseBySlug(db, userId, slug);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}

const courseResources = await db
  .select()
  .from(resourcesTable)
  .where(and(eq(resourcesTable.courseId, course.id), eq(resourcesTable.userId, userId)));

const resourcesByKind: Record<string, typeof courseResources> = { canonical: [], feed: [], user_shared: [] };
for (const r of courseResources) {
  (resourcesByKind[r.kind] ??= []).push(r);
}
const KIND_LABELS: Record<string, string> = { canonical: 'Canonical', user_shared: 'Shared by you' };
const feedResources = resourcesByKind.feed;
---
<CourseLayout course={course} active="resources">
  {(['canonical', 'user_shared'] as const).map((kind) => (
    resourcesByKind[kind].length > 0 && (
      <div class="resource-group">
        <h3>{KIND_LABELS[kind]}</h3>
        <ul class="resource-list">
          {resourcesByKind[kind].map((r) => (
            <li>
              <a href={r.url} target="_blank" rel="noopener">{r.label}</a>
              {r.pinned && <span class="pin">pinned</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  ))}

  {feedResources.length > 0 && (
    <div class="resource-group feed-group">
      <h3>Feed</h3>
      <div class="resource-masonry">
        {feedResources.map((r) => (
          <ResourceCard
            client:load
            resource={{
              id: r.id,
              url: r.url,
              label: r.label,
              kind: r.kind,
              courseId: r.courseId,
              kcId: r.kcId,
              pinned: r.pinned,
              createdAt: r.createdAt ?? undefined,
            }}
            course={{ id: course.id, title: course.title, slug: course.slug, code: course.code, color: course.color }}
          />
        ))}
      </div>
    </div>
  )}

  {courseResources.length === 0 && <p class="placeholder">No resources for this course yet.</p>}
</CourseLayout>

<style>
  .placeholder { color: var(--muted); font-size: 0.9rem; }
  .resource-group { margin-bottom: 1.5rem; }
  .resource-group h3 { margin: 0 0 0.4rem 0; font-size: 0.95rem; }
  .resource-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .resource-list a { color: var(--accent); text-decoration: none; }
  .pin { margin-left: 0.5rem; font-size: 0.7rem; color: var(--muted); }
  .resource-masonry { columns: 2 240px; column-gap: 16px; width: 100%; }
  .resource-masonry > * { break-inside: avoid; margin-bottom: 16px; display: inline-block; width: 100%; }
  @media (max-width: 600px) { .resource-masonry { columns: 1; } }
</style>
