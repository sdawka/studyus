---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { kcs, resources as resourcesTable } from '../../../db/schema';
import { and, eq } from 'drizzle-orm';
import { getCourseBySlug } from '../../../lib/services/courses';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import { hueFor } from '../../../lib/courseHue';
import GroupedResource from '../../../components/course/GroupedResource.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
try {
  course = await getCourseBySlug(db, userId, slug);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}

const courseResources = await db
  .select()
  .from(resourcesTable)
  .where(and(eq(resourcesTable.courseId, course.id), eq(resourcesTable.userId, userId)));

const courseKcs = await db
  .select({ id: kcs.id, name: kcs.name })
  .from(kcs)
  .where(eq(kcs.courseId, course.id));
const kcById = new Map(courseKcs.map((kc) => [kc.id, kc.name]));

type ResourceEntry = {
  id: string;
  url: string;
  label: string;
  kind: string;
  pinned: boolean;
};
type ResourceContext = { id: string; name: string; href: string };
type ResourceGroup = { key: string; resources: ResourceEntry[]; contexts: ResourceContext[] };

// One card represents one destination. Every resource row remains in its
// group, so shared/official/feed provenance and every KC relationship stay
// visible on the card.
const groups = new Map<string, ResourceGroup>();
for (const resource of courseResources) {
  const group = groups.get(resource.url) ?? { key: resource.url, resources: [], contexts: [] };
  group.resources.push({
    id: resource.id,
    url: resource.url,
    label: resource.label,
    kind: resource.kind,
    pinned: resource.pinned,
  });
  if (resource.kcId) {
    const kcName = kcById.get(resource.kcId);
    if (kcName && !group.contexts.some((context) => context.id === resource.kcId)) {
      const kcHref = `/courses/${slug}/kc/${resource.kcId}`;
      group.contexts.push({ id: resource.kcId, name: kcName, href: kcHref });
    }
  }
  groups.set(resource.url, group);
}

const groupedResources = [...groups.values()];
const kcCount = groupedResources.reduce((count, group) => count + group.contexts.length, 0);
const total = courseResources.length;
const courseH = hueFor(course);

const resourcesByKind: Record<string, typeof courseResources> = { canonical: [], feed: [], user_shared: [] };
for (const resource of courseResources) (resourcesByKind[resource.kind] ??= []).push(resource);
const summaryParts = [
  resourcesByKind.canonical.length > 0 && `${resourcesByKind.canonical.length} official`,
  resourcesByKind.feed.length > 0 && `${resourcesByKind.feed.length} from the feed`,
  resourcesByKind.user_shared.length > 0 && `${resourcesByKind.user_shared.length} shared by you`,
].filter(Boolean);
---
<CourseLayout course={course} active="resources">
  <div class="resources-page" style={`--course-h: ${courseH}`}>
    <p class="summary-line">
      <strong class="num">{total}</strong> link{total === 1 ? '' : 's'} ·
      <strong>{groupedResources.length}</strong> unique destinations ·
      <strong>{kcCount}</strong> concept link{kcCount === 1 ? '' : 's'}
      {summaryParts.length > 0 && <span> · {summaryParts.join(' · ')}</span>}
    </p>

    <section class="resource-section" aria-labelledby="course-materials-title">
      <div class="section-head">
        <div>
          <span class="kicker">Course materials</span>
          <h1 id="course-materials-title">Resources, grouped by destination</h1>
        </div>
        <span class="count-pill pill pill-idle">{groupedResources.length}</span>
      </div>
      {groupedResources.length > 0 ? (
        <div class="resource-grid">
          {groupedResources.map((group) => (
            <GroupedResource client:visible resources={group.resources} contexts={group.contexts} />
          ))}
        </div>
      ) : (
        <p class="empty">No resources yet — save a link to this course from the Feed.</p>
      )}
    </section>
  </div>
</CourseLayout>

<style>
  .resources-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .summary-line {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .summary-line strong {
    color: var(--text);
    margin-left: 0.2rem;
  }

  .resource-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .section-head h1 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }

  .count-pill {
    min-width: 20px;
    justify-content: center;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: var(--space-3);
  }

  .empty {
    color: var(--muted);
    font-size: 0.9rem;
  }

  @media (max-width: 560px) {
    .summary-line { line-height: 1.7; }
    .resource-grid { grid-template-columns: 1fr; }
  }
</style>
