---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { resources as resourcesTable } from '../../../db/schema';
import { and, eq } from 'drizzle-orm';
import { getCourseBySlug } from '../../../lib/services/courses';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import { hueFor } from '../../../lib/courseHue';
import ResourceCard from '../../../components/feed/ResourceCard.svelte';
import ResourceTile from '../../../components/course/ResourceTile.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
try {
  course = await getCourseBySlug(db, userId, slug);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}

const courseResources = await db
  .select()
  .from(resourcesTable)
  .where(and(eq(resourcesTable.courseId, course.id), eq(resourcesTable.userId, userId)));

const resourcesByKind: Record<string, typeof courseResources> = { canonical: [], feed: [], user_shared: [] };
for (const r of courseResources) {
  (resourcesByKind[r.kind] ??= []).push(r);
}
const canonicalResources = resourcesByKind.canonical;
const userSharedResources = resourcesByKind.user_shared;
const feedResources = resourcesByKind.feed;
const total = courseResources.length;
const courseH = hueFor(course);

const summaryParts = [
  canonicalResources.length > 0 && `${canonicalResources.length} official`,
  feedResources.length > 0 && `${feedResources.length} from the feed`,
  userSharedResources.length > 0 && `${userSharedResources.length} shared by you`,
].filter(Boolean);
---
<CourseLayout course={course} active="resources">
  <div class="resources-page" style={`--course-h: ${courseH}`}>
    {total > 0 && (
      <p class="summary-line">
        <strong class="num">{total}</strong> resource{total === 1 ? '' : 's'}
        {summaryParts.length > 0 && <span> · {summaryParts.join(' · ')}</span>}
      </p>
    )}

    <section class="resource-section">
      <div class="section-head">
        <span class="kicker">Course materials</span>
        <span class="count-pill pill pill-idle">{canonicalResources.length}</span>
      </div>
      {canonicalResources.length > 0 ? (
        <div class="tile-grid">
          {canonicalResources.map((r) => (
            <ResourceTile client:load resource={{ id: r.id, url: r.url, label: r.label, pinned: r.pinned }} />
          ))}
        </div>
      ) : (
        <p class="empty">No official materials posted for this course yet.</p>
      )}
    </section>

    <section class="resource-section">
      <div class="section-head">
        <span class="kicker">Feed</span>
        <span class="count-pill pill pill-idle">{feedResources.length}</span>
        {feedResources.length > 0 && <span class="section-desc">Community links shared for this course</span>}
      </div>
      {feedResources.length > 0 ? (
        <div class="resource-masonry">
          {feedResources.map((r) => (
            <ResourceCard
              client:load
              resource={{
                id: r.id,
                url: r.url,
                label: r.label,
                kind: r.kind,
                courseId: r.courseId,
                kcId: r.kcId,
                pinned: r.pinned,
                createdAt: r.createdAt ?? undefined,
              }}
              course={{ id: course.id, title: course.title, slug: course.slug, code: course.code, color: course.color }}
            />
          ))}
        </div>
      ) : (
        <p class="empty">No resources yet — share one from the Feed.</p>
      )}
    </section>

    <section class="resource-section">
      <div class="section-head">
        <span class="kicker">Shared by you</span>
        <span class="count-pill pill pill-idle">{userSharedResources.length}</span>
      </div>
      {userSharedResources.length > 0 ? (
        <div class="tile-grid">
          {userSharedResources.map((r) => (
            <ResourceTile
              client:load
              resource={{ id: r.id, url: r.url, label: r.label, pinned: r.pinned }}
              deletable
            />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing shared yet — save a link to this course from the Feed.</p>
      )}
    </section>
  </div>
</CourseLayout>

<style>
  .resources-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .summary-line {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .summary-line strong {
    color: var(--text);
  }

  .resource-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .count-pill {
    min-width: 20px;
    justify-content: center;
  }

  .section-desc {
    color: var(--muted);
    font-size: 0.8rem;
    margin-left: var(--space-1);
  }

  .tile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: var(--space-3);
  }

  .resource-masonry { columns: 2 240px; column-gap: var(--space-4); width: 100%; }
  .resource-masonry > * { break-inside: avoid; margin-bottom: var(--space-4); display: inline-block; width: 100%; }

  @container (max-width: 600px) {
    .resource-masonry { columns: 1; }
  }
</style>
