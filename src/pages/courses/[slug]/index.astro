---
// Course home (task-oriented overview): the server loads everything it
// already owns — course/branches/KCs for UnderstandNext + MasteryCard, the
// full task list to SSR-seed the shared store (dashboard.astro's idiom:
// sweep once explicitly, then fetch without re-sweeping) — and CourseHome
// composes the page client-side. Reference-only data (assessments, grade
// summary, events) stays client-fetched inside the island.
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { getCourseBySlug } from '../../../lib/services/courses';
import { listTasks } from '../../../lib/services/tasks';
import { sweepTasks } from '../../../lib/services/taskSweep';
import { getCourseReadiness } from '../../../lib/services/zpd';
import { toApi } from '../../../lib/serialize';
import { hueFor } from '../../../lib/courseHue';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import CourseHome from '../../../components/course/CourseHome.svelte';
import { getCourseDomain } from '../../../lib/services/courseDraft';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
let courseDomain = null;
try {
  course = await getCourseBySlug(db, userId, slug);
  if (course.domainVersion === 2) courseDomain = await getCourseDomain(db, userId, course.id);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}

await sweepTasks(db, userId);
const allTasks = await listTasks(db, userId, { sweep: false });

// ZPD readiness (src/lib/zpd.ts, one hop out for cross-course prereqs) —
// merged into each KC below so UnderstandNext.svelte stays fetch-free.
const readiness = await getCourseReadiness(db, userId, course.id);
const unreadyPrereqsByKc = new Map(readiness.map((r) => [r.id, r.unreadyPrereqs]));

// Slim island props: exactly what UnderstandNext/MasteryCard render, not
// the full DB rows.
const branches = course.branches.map((b) => ({
  id: b.id,
  name: b.name,
  kcs: b.kcs.map((kc) => ({
    id: kc.id,
    name: kc.name,
    mastery: kc.mastery ?? 0,
    status: kc.status ?? null,
    lastEventAt: kc.lastEventAt ?? null,
    unreadyPrereqs: unreadyPrereqsByKc.get(kc.id),
  })),
}));
---
<CourseLayout course={course} active="overview">
  {courseDomain && courseDomain.modules.length > 0 && (
    <section class="domain-modules" aria-labelledby="course-modules-heading">
      <p class="eyebrow">Your learning path</p>
      <h2 id="course-modules-heading">Course modules</h2>
      <ol>{courseDomain.modules.map((module) => <li><h3>{module.title}</h3></li>)}</ol>
    </section>
  )}
  <CourseHome
    client:load
    courseId={course.id}
    courseSlug={course.slug}
    courseCode={course.code}
    courseHue={hueFor(course)}
    meetingDays={course.meetingDays}
    overview={course.overview}
    {branches}
    initialTasks={toApi(allTasks)}
  />
</CourseLayout>

<style>
  .domain-modules { margin-bottom: 24px; padding: 20px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); }
  .domain-modules h2 { margin: 2px 0 14px; font-size: 18px; }
  .domain-modules ol { display: grid; gap: 8px; margin: 0; padding-left: 24px; }
  .domain-modules h3 { margin: 0; font-size: 15px; font-weight: 600; }
</style>

<script>
  // Legacy hash-tab redirects from the pre-subroute course page
  // (index.astro used to host all four tabs behind #hash routing).
  const HASH_ROUTES: Record<string, string> = {
    concepts: 'concepts',
    notes: 'notes',
    resources: 'resources',
  };
  const hash = location.hash.replace('#', '');
  const target = HASH_ROUTES[hash];
  if (target) {
    location.replace(`${location.pathname.replace(/\/$/, '')}/${target}`);
  } else if (hash) {
    // #standing (or anything else) just strips the hash — overview is home.
    // (#assessments is real again — UpNextCard/GradeStatCard link to the
    // in-page assessments slot — but that's an element id the browser
    // handles natively, and it only ever appears on same-page clicks, not
    // as a legacy inbound URL.)
    history.replaceState(null, '', location.pathname);
  }
</script>
