---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { getCourseBySlug } from '../../../lib/services/courses';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import StandingTab from '../../../components/standing/StandingTab.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
try {
  course = await getCourseBySlug(db, userId, slug);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}
---
<CourseLayout course={course} active="overview">
  {course.overview && <p class="overview">{course.overview}</p>}

  <StandingTab client:load courseId={course.id} courseSlug={course.slug} />
</CourseLayout>

<script>
  // Legacy hash-tab redirects from the pre-subroute course page
  // (index.astro used to host all four tabs behind #hash routing).
  const HASH_ROUTES: Record<string, string> = {
    concepts: 'concepts',
    notes: 'notes',
    resources: 'resources',
  };
  const hash = location.hash.replace('#', '');
  const target = HASH_ROUTES[hash];
  if (target) {
    location.replace(`${location.pathname.replace(/\/$/, '')}/${target}`);
  } else if (hash) {
    // #standing (or anything else) just strips the hash — overview is home.
    history.replaceState(null, '', location.pathname);
  }
</script>

<style>
  .overview { margin: 0 0 22px; color: var(--text); max-width: 700px; }
</style>
