---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { getCourseBySlug } from '../../../lib/services/courses';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import { getCourseMap } from '../../../lib/services/courseMap';
import { toApi } from '../../../lib/serialize';
import CourseMapManager from '../../../components/course/CourseMapManager.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
let courseMap;
try {
  course = await getCourseBySlug(db, userId, slug);
  courseMap = await getCourseMap(db, userId, course.id);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}
---
<CourseLayout course={course} active="concepts">
  <CourseMapManager client:load initialMap={toApi(courseMap)} courseSlug={course.slug} />
</CourseLayout>
