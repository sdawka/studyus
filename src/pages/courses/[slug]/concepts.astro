---
import CourseLayout from '../../../layouts/CourseLayout.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../../../db/client';
import { getCourseBySlug } from '../../../lib/services/courses';
import { NotFoundError, notFound } from '../../../lib/handleNotFound';
import { getCourseMap } from '../../../lib/services/courseMap';
import { toApi } from '../../../lib/serialize';
import CourseMapManager from '../../../components/course/CourseMapManager.svelte';
import { getCourseDomain } from '../../../lib/services/courseDraft';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;
const slug = Astro.params.slug!;

let course;
let courseMap;
let courseDomain = null;
try {
  course = await getCourseBySlug(db, userId, slug);
  if (course.domainVersion === 2) courseDomain = await getCourseDomain(db, userId, course.id);
  else courseMap = await getCourseMap(db, userId, course.id);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}
---
<CourseLayout course={course} active="concepts">
  {courseDomain ? (
    <section aria-labelledby="v2-concepts-heading">
      <p class="eyebrow">Course structure</p>
      <h2 id="v2-concepts-heading">Ideas and skills by module</h2>
      {courseDomain.modules.map((module) => (
        <article>
          <h3>{module.title}</h3>
          <ul>{module.kc_ids.map((id) => <li>{courseDomain.kcs.find((kc) => kc.id === id)?.name}</li>)}</ul>
        </article>
      ))}
    </section>
  ) : <CourseMapManager client:load initialMap={toApi(courseMap)} courseSlug={course.slug} />}
</CourseLayout>

<style>
  section { display: grid; gap: 12px; }
  section > h2 { margin: 0; font-size: 20px; }
  article { padding: 16px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); }
  article h3 { margin: 0 0 8px; font-size: 16px; }
  article ul { margin: 0; padding-left: 20px; color: var(--muted); }
</style>
