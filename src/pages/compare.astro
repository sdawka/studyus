---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import CompareHero from '../components/marketing/compare/CompareHero.astro';
import TwoLanesMap from '../components/marketing/compare/TwoLanesMap.astro';
import CompetitorField from '../components/marketing/compare/CompetitorField.astro';
import AtAGlanceTable from '../components/marketing/compare/AtAGlanceTable.astro';
import EvidenceStrip from '../components/marketing/compare/EvidenceStrip.astro';
import HonestExceptions from '../components/marketing/compare/HonestExceptions.astro';
import CompareCTA from '../components/marketing/compare/CompareCTA.astro';
---
<MarketingLayout
  title="studyus vs. everyone else — an honest comparison"
  description="Planners tell you when. Flashcard apps tell you how. Nobody tells you what to study next — here's how studyus compares to MyStudyLife, Shovel, Todoist, Notion, Motion, Anki, and Quizlet."
>
  <div class="rd rd-grain">
    <CompareHero />
    <TwoLanesMap />
    <CompetitorField />
    <EvidenceStrip />
    <AtAGlanceTable />
    <HonestExceptions />
    <CompareCTA />
  </div>
</MarketingLayout>
