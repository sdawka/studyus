---
import AppShell from '../layouts/AppShell.astro';
import TasksView from '../components/tasks/TasksView.svelte';
import { env } from 'cloudflare:workers';
import { getDb } from '../db/client';
import { listTasks } from '../lib/services/tasks';
import { listCourses } from '../lib/services/courses';
import { toApi } from '../lib/serialize';
import { hueFor } from '../lib/courseHue';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;

// listTasks sweeps (generates due system tasks) before returning, same as
// planner's getCalendar call.
const userTasks = await listTasks(db, userId);
const userCourses = await listCourses(db, userId);

// Deep-link support: /tasks?course=<slug> narrows the card grid to one
// course (or 'other'); TasksView validates the slug and falls back to "All".
const courseParam = Astro.url.searchParams.get('course');

const courseOptions = userCourses.map((c) => ({
  id: c.id,
  slug: c.slug,
  code: c.code,
  title: c.title,
  hue: hueFor(c),
}));

const initialTasks = toApi(userTasks);
---

<AppShell title="Tasks">
  <div class="tasks-layer" id="tasks-layer" slot="overlay">
    <div class="scrim" id="tasks-scrim"></div>
    <div class="panel" id="tasks-panel" role="dialog" aria-modal="true" aria-label="Tasks">
      <div class="panel-head">
        <h1>Tasks</h1>
        <button type="button" class="close-btn" id="tasks-close" aria-label="Close tasks">
          <span aria-hidden="true">×</span>
        </button>
      </div>
      <TasksView client:load initialTasks={initialTasks} courses={courseOptions} initialCourseFilter={courseParam} />
    </div>
  </div>
</AppShell>

<script>
  import { focusTrap } from '../lib/actions/focusTrap';
  import { scrollLock } from '../lib/actions/scrollLock';
  import type { ActionHandle } from '../lib/actions/focusTrap';

  declare global {
    interface Window {
      __tasksBlockEscape?: boolean;
    }
  }

  function closeTasks() {
    deactivateDesktopModal();
    if (history.length > 1) history.back();
    else window.location.assign('/dashboard');
  }
  document.getElementById('tasks-close')?.addEventListener('click', closeTasks);
  document.getElementById('tasks-scrim')?.addEventListener('click', closeTasks);
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    // On mobile this "modal" is a full page between the header and tab bar,
    // not an overlay (see the @media 767 block below) — there's no scrim
    // to dismiss, so Escape is a no-op there.
    if (matchMedia('(max-width: 767px)').matches) return;
    // TasksView sets this while an inline add form or subtask editor is
    // open, so a first Escape closes that instead of the whole modal.
    if (!window.__tasksBlockEscape) closeTasks();
  });

  // Desktop-only modal semantics (T4 a11y pass): on mobile this route layer
  // is a full page between header and tab bar — chrome stays interactive
  // and the page scrolls internally, so none of focus-trap, scroll-lock, or
  // background `inert` apply there (same matchMedia gate the Escape guard
  // above already uses). On desktop it behaves like a true modal: background
  // chrome (the .shell wrapper — Sidebar + Header + main; BottomNav is
  // already display:none above the mobile breakpoint) goes inert, focus is
  // trapped in the panel, and body scroll is locked.
  const mq = matchMedia('(max-width: 767px)');
  const shellEl = document.querySelector('.shell');
  const panelEl = document.getElementById('tasks-panel');
  let trapHandle: ActionHandle | null = null;
  let lockHandle: ActionHandle | null = null;

  function activateDesktopModal() {
    if (trapHandle || !panelEl) return;
    trapHandle = focusTrap(panelEl, { enabled: true });
    lockHandle = scrollLock(document.body, { enabled: true });
    shellEl?.setAttribute('inert', '');
  }
  function deactivateDesktopModal() {
    trapHandle?.destroy();
    trapHandle = null;
    lockHandle?.destroy();
    lockHandle = null;
    shellEl?.removeAttribute('inert');
  }

  if (!mq.matches) activateDesktopModal();
  mq.addEventListener('change', (e) => {
    if (e.matches) deactivateDesktopModal();
    else activateDesktopModal();
  });
  window.addEventListener('pagehide', deactivateDesktopModal);
</script>

<style>
  .tasks-layer {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: stretch;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklch, var(--text) 20%, transparent);
  }
  .panel {
    position: relative;
    margin: 20px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-pop);
    overflow: auto;
    padding: 24px 28px 32px;
    z-index: 1;
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .panel-head h1 {
    font-size: 20px;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .close-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--muted);
    font-size: 20px;
    line-height: 1;
  }
  .close-btn:hover {
    background: var(--hover);
  }

  /* Mobile: the route "modal" becomes a full page between the header and
     tab bar (a tab destination, not an overlay) — see
     docs/design/mobile-shell.md's "route modals → tab destinations"
     section. Desktop rules above are untouched. */
  @media (max-width: 767px) {
    .tasks-layer {
      top: calc(var(--header-h) + env(safe-area-inset-top));
      bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
      z-index: 10;
    }
    .scrim {
      display: none;
    }
    .panel {
      margin: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 16px 16px 24px;
      overscroll-behavior: contain;
    }
    .close-btn {
      display: none;
    }
  }
</style>
