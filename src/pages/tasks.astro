---
import AppShell from '../layouts/AppShell.astro';
import TasksView from '../components/tasks/TasksView.svelte';
import { env } from 'cloudflare:workers';
import { getDb } from '../db/client';
import { listTasks } from '../lib/services/tasks';
import { listCourses } from '../lib/services/courses';
import { toApi } from '../lib/serialize';
import { hueFor } from '../lib/courseHue';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;

// listTasks sweeps (generates due system tasks) before returning, same as
// planner's getCalendar call.
const userTasks = await listTasks(db, userId);
const userCourses = await listCourses(db, userId);

// Deep-link support: /tasks?course=<slug1>,<slug2> narrows the Open tab's
// card grid to a set of courses ('other' is the pseudo-slug for the
// courseless bucket); TasksView validates each slug and drops anything it
// doesn't recognize. /tasks?tab=tada opens straight to the Ta-Da tab.
const courseParam = Astro.url.searchParams.get('course');
const initialCourseFilters = courseParam ? courseParam.split(',').filter(Boolean) : [];
const initialTab = Astro.url.searchParams.get('tab') === 'tada' ? 'tada' : 'open';

const courseOptions = userCourses.map((c) => ({
  id: c.id,
  slug: c.slug,
  code: c.code,
  title: c.title,
  hue: hueFor(c),
}));

const initialTasks = toApi(userTasks);
---

<AppShell title="Tasks">
  <TasksView
    client:load
    initialTasks={initialTasks}
    courses={courseOptions}
    initialCourseFilters={initialCourseFilters}
    initialTab={initialTab}
  />
</AppShell>
