---
import { env } from 'cloudflare:workers';
import AppShell from '../layouts/AppShell.astro';
import { getDb } from '../db/client';
import { listTasks } from '../lib/services/tasks';
import { listCourses } from '../lib/services/courses';
import { toApi } from '../lib/serialize';
import TaskList from '../components/tasks/TaskList.svelte';

if (!Astro.locals.user) return Astro.redirect('/login');

const db = getDb(env.DB);
const tasks = await listTasks(db, Astro.locals.user.id);
const courses = await listCourses(db, Astro.locals.user.id);

const apiTasks = toApi(tasks);
const apiCourses = toApi(courses);
---

<AppShell title="Tasks">
  <h1>Tasks</h1>
  <TaskList client:load initialTasks={apiTasks} courses={apiCourses} />
</AppShell>
