---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Landing from '../components/marketing/landing/Landing.astro';

if (Astro.locals.user) {
  if (!Astro.locals.user.onboardedAt) {
    return Astro.redirect('/onboarding');
  }
  return Astro.redirect('/dashboard');
}
---
<MarketingLayout
  title="studyus — know what to study next"
  description="A study planner for university students that turns weak concepts, stale topics, and real deadlines into one clear next move."
>
  <Landing />
</MarketingLayout>
