---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Landing from '../components/marketing/landing/Landing.astro';

if (Astro.locals.user) {
  if (!Astro.locals.user.onboardedAt) {
    return Astro.redirect('/onboarding');
  }
  return Astro.redirect('/dashboard');
}
---
<MarketingLayout
  title="Studyus makes you studious"
  description="One clear next move for every class. Studyus weighs deadlines, mastery, prerequisites, and memory decay to show you where to start."
>
  <Landing />
</MarketingLayout>
