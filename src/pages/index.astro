---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Landing from '../components/marketing/landing/Landing.astro';

if (Astro.locals.user) {
  if (!Astro.locals.user.onboardedAt) {
    return Astro.redirect('/onboarding');
  }
  return Astro.redirect('/dashboard');
}
---
<MarketingLayout
  title="studyus — open the right thing next"
  description="A study planner for university students that ranks weak concepts, stale topics, and real deadlines so you always know what to open next."
>
  <Landing />
</MarketingLayout>
