---
import '../styles/tokens.css';
import '../styles/themes/compass.css';
import '../styles/themes/focus.css';
import '../styles/themes/campus.css';
import '../styles/base.css';
import LoginForm from '../components/LoginForm.svelte';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Sign in · studyus</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#f6f9fb" media="(prefers-color-scheme: light)" id="theme-color-light" />
    <meta name="theme-color" content="#0b0e10" media="(prefers-color-scheme: dark)" id="theme-color-dark" />
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh; /* two-line fallback: dvh wins where supported */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        padding: 0 1rem;
      }
      .wordmark {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
      .wordmark .mark { font-weight: 600; font-size: 1.5rem; }
      .wordmark .tag { font-size: 0.85rem; color: var(--muted); font-style: italic; }
      .card {
        background: var(--surface);
        border: 1px solid var(--hairline);
        border-radius: 3px;
        padding: clamp(1.25rem, 6vw, 2.5rem);
        min-width: min(320px, calc(100vw - 2rem));
      }
      h1 { margin-top: 0; font-size: 1.2rem; }
    </style>
  </head>
  <body>
    <div class="wordmark"><span class="mark">studyus</span><span class="tag">a notebook for the semester</span></div>
    <div class="card">
      <h1>Sign in</h1>
      <LoginForm client:load />
    </div>
  </body>
</html>
