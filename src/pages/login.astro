---
import '../styles/notebook.css';
import LoginForm from '../components/LoginForm.svelte';

if (Astro.locals.user) {
  return Astro.redirect('/dashboard');
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in · StudyBuddy</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
      }
      .wordmark {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
      }
      .wordmark .mark { font-weight: 600; font-size: 1.5rem; }
      .wordmark .tag { font-size: 0.85rem; color: var(--muted); font-style: italic; }
      .card {
        background: var(--panel);
        border: 1px solid var(--hairline);
        border-radius: 3px;
        padding: 2.25rem 2.5rem;
        min-width: 320px;
      }
      h1 { margin-top: 0; font-size: 1.2rem; }
    </style>
  </head>
  <body>
    <div class="wordmark"><span class="mark">StudyBuddy</span><span class="tag">a notebook for the semester</span></div>
    <div class="card">
      <h1>Sign in</h1>
      <LoginForm client:load />
    </div>
  </body>
</html>
