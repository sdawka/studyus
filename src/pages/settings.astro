---
import AppShell from '../layouts/AppShell.astro';
import AppearanceSettings from '../components/settings/AppearanceSettings.svelte';
import TaskGeneratorSettings from '../components/settings/TaskGeneratorSettings.svelte';
import CalendarIntegrationSettings from '../components/settings/CalendarIntegrationSettings.svelte';
import AnalyticsPrivacySettings from '../components/settings/AnalyticsPrivacySettings.svelte';
import { resolveSettings } from '../lib/services/user';

const user = Astro.locals.user!;
const settings = resolveSettings(user.settings);
---
<AppShell title="Settings">
  <h1>Settings</h1>

  <section class="card settings-section">
    <div class="card-head"><h2>Privacy</h2></div>
    <AnalyticsPrivacySettings client:load optedOut={settings.analytics_opt_out} />
  </section>

  <section class="card settings-section">
    <div class="card-head"><h2>Calendar</h2></div>
    <p class="section-hint">Use outside calendars as constraints and keep Studyus blocks in their own calendar.</p>
    <CalendarIntegrationSettings client:load />
  </section>

  <section class="card settings-section">
    <div class="card-head"><h2>Appearance</h2></div>
    <AppearanceSettings client:load settings={settings} />
  </section>

  <section class="card settings-section">
    <div class="card-head"><h2>Automatic tasks</h2></div>
    <p class="section-hint">Choose which of these studyus generates for you automatically.</p>
    <TaskGeneratorSettings client:load generators={settings.task_generators} />
  </section>

  <section class="card settings-section">
    <div class="card-head"><h2>Profile</h2></div>
    <form id="profile-form" class="profile-form">
      <label>
        Name
        <input type="text" name="name" value={user.name ?? ''} />
      </label>
      <label>
        Current term
        <input type="text" name="current_term" value={user.currentTerm ?? ''} placeholder="e.g. Fall 2026" />
      </label>
      <label>
        Timezone
        <input id="timezone-input" type="text" name="timezone" value={user.timezone} placeholder="America/Toronto" />
      </label>
      <button type="submit" class="btn btn-primary">Save</button>
      <span id="profile-saved" class="saved-msg" hidden>Saved</span>
    </form>
  </section>

  <section class="card settings-section">
    <div class="card-head"><h2>Account</h2></div>
    <p class="account-email">{user.email}</p>
    <button type="button" id="logout-btn" class="btn btn-secondary">Log out</button>
  </section>
</AppShell>

<script>
  import { apiFetch } from '../lib/apiClient';
  import { pushToast } from '../lib/stores/toast';
  import { resetAnalytics } from '../lib/analytics/client';

  const form = document.getElementById('profile-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const body: Record<string, string | null> = {
      name: String(data.get('name') || ''),
      current_term: String(data.get('current_term') || '') || null,
      timezone: String(data.get('timezone') || Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'),
    };
    const result = await apiFetch(
      '/api/v1/user',
      { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) },
      'Could not save profile',
      'Network error — could not save profile',
    );
    if (!result.ok) {
      pushToast(result.error, 'error');
      return;
    }
    const savedMsg = document.getElementById('profile-saved');
    if (savedMsg) {
      savedMsg.hidden = false;
      setTimeout(() => { savedMsg.hidden = true; }, 2000);
    }
  });

  const timezoneInput = document.getElementById('timezone-input') as HTMLInputElement | null;
  const detectedTimezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
  if (timezoneInput && timezoneInput.value === 'UTC' && detectedTimezone && detectedTimezone !== 'UTC') {
    timezoneInput.value = detectedTimezone;
  }

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    resetAnalytics();
    const clerk = (window as Window & {
      Clerk?: { signOut: (options?: { redirectUrl?: string }) => Promise<void> | void };
    }).Clerk;
    if (clerk) {
      clerk.signOut({ redirectUrl: '/sign-in' });
      return;
    }
    window.location.href = '/sign-in';
  });
</script>

<style>
  h1 { margin-bottom: 20px; }
  .settings-section { margin-bottom: 18px; max-width: 560px; }
  .profile-form { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .profile-form label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--muted); width: 100%; }
  .profile-form input {
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
  }
  .saved-msg { font-size: 12.5px; color: var(--good-ink); }
  .account-email { color: var(--muted); font-size: 14px; margin-bottom: 12px; }
  .section-hint { color: var(--muted); font-size: 12.5px; margin: 0 0 var(--space-4); }
</style>
