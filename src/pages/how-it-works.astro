---
import MarketingLayout from '../layouts/MarketingLayout.astro';

const steps = [
  {
    number: '01',
    eyebrow: 'Map the work',
    title: 'Your semester becomes a learning map.',
    body: 'Courses, deadlines, and assessments are connected to the concepts they depend on. Studyus can then reason about the work—not just store a longer list of it.',
    points: ['Course concepts and prerequisite links', 'Assessment coverage and due dates', 'One event history for every concept'],
    visual: 'map',
  },
  {
    number: '02',
    eyebrow: 'Do the thinking',
    title: 'Study actively, with the right kind of practice.',
    body: 'A fact calls for recall. A procedure may need a worked example. A principle needs explanation and transfer. Practice changes with the kind of knowledge you are building.',
    points: ['Quick retrieval with feedback', 'Worked examples with fading support', 'Self-explanation and misconception checks'],
    visual: 'practice',
  },
  {
    number: '03',
    eyebrow: 'Use the evidence',
    title: 'Every attempt updates what comes next.',
    body: 'Studyus combines demonstrated performance, learning activity, recency, prerequisites, and deadlines. The result is a defensible next move—not a confidence colour you have to guess.',
    points: ['Mastery derived from learning events', 'Weak prerequisites surfaced before new work', 'Stale concepts return to the task list'],
    visual: 'decision',
  },
];

const principles = [
  {
    id: 'retrieval',
    number: '01',
    title: 'Retrieval before recognition',
    summary: 'Trying to produce an answer from memory makes learning more durable than another pass through the same material.',
    action: 'Answer before revealing the solution, then correct the response immediately.',
    product: 'Quick Quiz and per-concept exercises collect an answer before showing feedback. Attempts become evidence on the linked concept.',
    where: ['Practice', 'Exercises', 'Tutor'],
    status: 'implemented',
    statusLabel: 'Implemented',
  },
  {
    id: 'spacing',
    number: '02',
    title: 'Distributed review',
    summary: 'Returning after some forgetting is more useful than massing the same practice into one sitting.',
    action: 'Revisit a concept across separate days instead of cramming repetitions together.',
    product: 'Mastery decays with inactivity and stale-concept tasks bring neglected material back. A fully personalized interval scheduler is still planned.',
    where: ['Tasks', 'Mastery', 'Profile'],
    status: 'partial',
    statusLabel: 'Live, still evolving',
  },
  {
    id: 'matching',
    number: '03',
    title: 'Match practice to the knowledge',
    summary: 'Facts, concepts, rules, procedures, and principles do not all improve through the same activity.',
    action: 'Use recall for facts, classification for concepts, and explanation or modelling for principles.',
    product: 'Each concept has a knowledge type. The tutor and scaffold system use it to select the form of instruction—not merely the difficulty.',
    where: ['Understand', 'Tutor', 'Play'],
    status: 'implemented',
    statusLabel: 'Implemented',
  },
  {
    id: 'scaffolding',
    number: '04',
    title: 'Prerequisites and fading support',
    summary: 'New learning is more manageable when missing foundations are found and guidance recedes as competence grows.',
    action: 'Check the prerequisite, study a worked path, then take over more of the solution.',
    product: 'Understand maps prerequisite chains, verifies weak foundations, and can teach through scaffolded examples with support levels.',
    where: ['Understand', 'Frontier', 'Concept map'],
    status: 'implemented',
    statusLabel: 'Implemented',
  },
  {
    id: 'explanation',
    number: '05',
    title: 'Self-explanation and error correction',
    summary: 'Explaining why a step works—and confronting a precise wrong belief—can reveal gaps that a correct-looking answer hides.',
    action: 'Explain the reasoning, inspect the feedback, and preserve useful corrections.',
    product: 'Tutor prompts can elicit explanation, detect documented misconceptions, and save accepted corrections to a revisitable ledger.',
    where: ['Tutor', 'Corrections', 'Profile'],
    status: 'implemented',
    statusLabel: 'Implemented',
  },
  {
    id: 'calibration',
    number: '06',
    title: 'Evidence over confidence',
    summary: 'Familiarity can feel like mastery. A low-stakes attempt provides a better signal than “this looks familiar.”',
    action: 'Use a quiz, exercise, or explanation to test the feeling of knowing.',
    product: 'Mastery is folded from recorded instructional and assessment events. Coverage stays visible so untouched material cannot look mastered by averaging.',
    where: ['Concepts', 'Standing', 'Profile'],
    status: 'implemented',
    statusLabel: 'Implemented',
  },
  {
    id: 'interleaving',
    number: '07',
    title: 'Varied and interleaved practice',
    summary: 'Mixing related problem types can train the harder skill of deciding which method applies, not just repeating a method you were handed.',
    action: 'Mix related concepts after the basics are understood; do not randomize material blindly.',
    product: 'Quick Quiz can mix multiple concepts and the planner can distribute different kinds of work. Deliberate similarity-based interleaving is not yet automated.',
    where: ['Quick Quiz', 'Planner'],
    status: 'partial',
    statusLabel: 'Partly implemented',
  },
  {
    id: 'safeguards',
    number: '08',
    title: 'Sustainable study conditions',
    summary: 'Short starts, protected rest, sleep, and a reliable study cue help make effective practice possible in the first place.',
    action: 'Plan a small start, work near your better focus hours, and protect breaks and sleep.',
    product: 'Sessions, calendar blocks, and optional rituals support the plan. Studyus does not score sleep, police breaks, or pretend to know your circadian rhythm.',
    where: ['Planner', 'Sessions', 'Rituals'],
    status: 'guided',
    statusLabel: 'Student-controlled',
  },
];

const boundaries = [
  {
    number: '01',
    title: 'Note reduction',
    practice: 'Condense source material into a hierarchy of ideas in your own words—whether you call the results essentials cards, nub cards, or something else.',
    boundary: 'Studyus keeps notes beside courses and concepts. It does not automatically reduce your notes or pretend that generated summaries replace the thinking involved.',
  },
  {
    number: '02',
    title: 'Essay planning',
    practice: 'Use short, timed plans to identify command words, retrieve relevant ideas, choose a position, and sequence the argument before drafting.',
    boundary: 'Studyus can schedule the session and connect it to an assessment. It does not choose the thesis, build the plan, or write the essay for you.',
  },
  {
    number: '03',
    title: 'Academic argument and voice',
    practice: 'Give each paragraph one argumentative job, support it with checkable evidence, and qualify claims precisely instead of hiding behind vague hedging.',
    boundary: 'Studyus is not an academic-writing editor. It does not rewrite your argument, remove hedges, or judge whether your evidence supports your thesis.',
  },
  {
    number: '04',
    title: 'Micro-blocks and energy timing',
    practice: 'Use a small start when a task feels too large, and place demanding work near the hours when you tend to think most clearly.',
    boundary: 'The planner supports short sessions and learner-chosen times. Studyus does not infer your chronotype, measure your energy, or claim to know your ideal hour.',
  },
  {
    number: '05',
    title: 'Study environment',
    practice: 'Use a reliable place and repeatable cues to make focused work easier to enter. Reduce noise and distractions when the task needs depth.',
    boundary: 'Studyus cannot make a room distraction-free, monitor your surroundings, block other apps, or know whether headphones help you focus.',
  },
  {
    number: '06',
    title: 'Rest, breaks, and sleep',
    practice: 'Treat recovery as part of performance: protect breaks, days off, and enough sleep for the work you are asking your brain to do.',
    boundary: 'Sessions and rituals can include breaks. Studyus deliberately does not track sleep, score rest, preserve streaks, or turn recovery into another compliance metric.',
  },
];

const references = [
  {
    title: 'Improving Students’ Learning With Effective Learning Techniques',
    authors: 'Dunlosky et al., 2013',
    note: 'Broad review of ten commonly used techniques; practice testing and distributed practice received the strongest overall utility ratings.',
    href: 'https://doi.org/10.1177/1529100612453266',
  },
  {
    title: 'The effect of testing versus restudy on retention',
    authors: 'Rowland, 2014',
    note: 'Meta-analytic review of the testing effect. Retrieval is a learning event, not only a way to measure learning.',
    href: 'https://doi.org/10.1037/a0037559',
  },
  {
    title: 'Distributed practice in verbal recall tasks',
    authors: 'Cepeda et al., 2006',
    note: 'Quantitative synthesis showing that useful spacing depends on how long the learner needs to retain the material.',
    href: 'https://doi.org/10.1037/0033-2909.132.3.354',
  },
  {
    title: 'The Knowledge–Learning–Instruction framework',
    authors: 'Koedinger, Corbett & Perfetti, 2012',
    note: 'The framework behind Studyus’s typed knowledge components and its separation of learning, instruction, and assessment evidence.',
    href: 'https://doi.org/10.1111/j.1551-6709.2012.01245.x',
  },
  {
    title: 'Similarity matters: a meta-analysis of interleaved learning',
    authors: 'Brunmair & Richter, 2019',
    note: 'Interleaving can help, but the benefit varies by material; it is not a rule to shuffle everything indiscriminately.',
    href: 'https://doi.org/10.1037/bul0000209',
  },
  {
    title: 'Eliciting explanations: constraints on when self-explanation aids learning',
    authors: 'Rittle-Johnson & Loehr, 2017',
    note: 'Self-explanation can support learning, with important limits around the prompt, domain, and learning goal.',
    href: 'https://doi.org/10.1080/00461520.2016.1196458',
  },
];
---

<MarketingLayout
  title="How Studyus works — learning science, made actionable"
  description="See how Studyus turns courses, deadlines, retrieval practice, mastery evidence, prerequisites, and memory decay into one clear next study move."
>
  <div class="rd rd-grain how-page">
    <section class="how-hero" aria-labelledby="how-title">
      <div class="rd-container hero-grid">
        <div class="hero-copy reveal">
          <p class="rd-kicker"><span class="kdot"></span>How Studyus works</p>
          <h1 id="how-title">Turn a semester of material into the <em class="rd-em">right next move.</em></h1>
          <p class="hero-lead">
            Studyus connects what you need to learn, what you have actually practised,
            and what is due next—then turns that evidence into a focused study decision.
          </p>
          <div class="hero-actions">
            <a class="rd-btn rd-btn-primary" href="/try">See it with a sample semester</a>
            <a class="rd-btn rd-btn-ghost" href="#principles">Audit the principles <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <aside class="decision-card reveal" style="--reveal-delay: 120ms" aria-label="Example Studyus recommendation">
          <div class="decision-top">
            <span class="decision-label">Open next</span>
            <span class="decision-time">18 min</span>
          </div>
          <p class="decision-course">CHEE 315 · Heat transfer</p>
          <h2>Convective heat-transfer coefficient</h2>
          <div class="reason-stack" aria-label="Why this concept comes next">
            <span><i class="reason-icon reason-icon--rose"></i><b>Mastery</b><small>42% · still shaky</small></span>
            <span><i class="reason-icon reason-icon--grape"></i><b>Deadline</b><small>midterm in 6 days</small></span>
            <span><i class="reason-icon reason-icon--mint"></i><b>Prerequisites</b><small>ready to build on</small></span>
            <span><i class="reason-icon reason-icon--orange"></i><b>Recency</b><small>last practised 9 days ago</small></span>
          </div>
          <div class="decision-footer">
            <span>Recommended move</span>
            <strong>Worked example → quick recall</strong>
          </div>
        </aside>
      </div>
      <div class="rd-container">
        <nav class="page-index reveal" aria-label="On this page">
          <a href="#loop">The learning loop</a>
          <a href="#principles">Principles</a>
          <a href="#checklist">Implementation checklist</a>
          <a href="#boundaries">What we leave to you</a>
          <a href="#evidence">Evidence & limits</a>
        </nav>
      </div>
    </section>

    <section class="thesis" aria-label="The Studyus position">
      <div class="rd-container thesis-inner reveal">
        <span class="thesis-mark" aria-hidden="true">↳</span>
        <p><strong>Highlighting is not the enemy.</strong> Mistaking activity for learning is. Studyus is designed to move you from seeing the material to trying, checking, explaining, and returning.</p>
      </div>
    </section>

    <section class="loop rd-section" id="loop" aria-labelledby="loop-title">
      <div class="rd-container">
        <div class="section-head reveal">
          <div>
            <p class="rd-kicker"><span class="kdot kdot--grape"></span>The learning loop</p>
            <h2 class="rd-h2" id="loop-title">Three steps. One continuous record of learning.</h2>
          </div>
          <p>The interface stays simple because the model underneath keeps the context.</p>
        </div>

        <ol class="steps">
          {steps.map((step, index) => (
            <li class="step reveal" style={`--reveal-delay: ${index * 70}ms`}>
              <div class="step-copy">
                <span class="step-number">{step.number}</span>
                <p class="step-eyebrow">{step.eyebrow}</p>
                <h3>{step.title}</h3>
                <p class="step-body">{step.body}</p>
                <ul>
                  {step.points.map((point) => <li><span aria-hidden="true">✓</span>{point}</li>)}
                </ul>
              </div>

              <div class:list={['step-visual', `step-visual--${step.visual}`]} aria-hidden="true">
                {step.visual === 'map' && (
                  <>
                    <div class="map-course"><span>CHEE 315</span><strong>Heat & mass transfer</strong><small>12 concepts</small></div>
                    <svg class="map-lines" viewBox="0 0 460 250"><path d="M120 58C180 58 170 126 230 126S285 58 344 58M230 126C230 176 278 188 336 188" /><path d="M230 126C186 126 170 188 116 188" /></svg>
                    <span class="map-node map-node--one">Conduction</span>
                    <span class="map-node map-node--two">Boundary layers</span>
                    <span class="map-node map-node--three">Convection</span>
                    <span class="map-node map-node--four">Dimensionless groups</span>
                  </>
                )}
                {step.visual === 'practice' && (
                  <div class="practice-card">
                    <div class="practice-meta"><span>Quick recall</span><small>1 of 4</small></div>
                    <p>When does the lumped-capacitance model apply?</p>
                    <div class="answer-line"><span>Bi &lt; 0.1</span><b>✓</b></div>
                    <div class="feedback"><strong>Correct.</strong> A small Biot number means internal temperature gradients are negligible.</div>
                  </div>
                )}
                {step.visual === 'decision' && (
                  <div class="mastery-card">
                    <div class="mastery-head"><span>Learning evidence</span><strong>68%</strong></div>
                    <div class="mastery-track"><i></i></div>
                    <div class="event-list">
                      <span><b>Today</b><small>retrieval · correct</small><em>+ evidence</em></span>
                      <span><b>4d ago</b><small>worked example</small><em>instruction</em></span>
                      <span><b>11d ago</b><small>quiz · unsure</small><em>needs review</em></span>
                    </div>
                    <div class="next-chip">Next check · Friday</div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="principles rd-section" id="principles" aria-labelledby="principles-title">
      <div class="rd-container">
        <div class="section-head section-head--light reveal">
          <div>
            <p class="rd-kicker"><span class="kdot"></span>The principles</p>
            <h2 class="rd-h2" id="principles-title">The science is a design constraint, not a slogan.</h2>
          </div>
          <p>Open any principle to see the learner behaviour, the product behaviour, and the implementation status.</p>
        </div>

        <div class="principle-list">
          {principles.map((principle, index) => (
            <details class="principle reveal" id={principle.id} style={`--reveal-delay: ${(index % 4) * 55}ms`} open={index === 0}>
              <summary>
                <span class="principle-number">{principle.number}</span>
                <span class="principle-name">
                  <strong>{principle.title}</strong>
                  <small>{principle.summary}</small>
                </span>
                <span class:list={['status', `status--${principle.status}`]}>{principle.statusLabel}</span>
                <span class="summary-plus" aria-hidden="true">+</span>
              </summary>
              <div class="principle-detail">
                <div><span class="detail-label">What you do</span><p>{principle.action}</p></div>
                <div><span class="detail-label">What Studyus does</span><p>{principle.product}</p></div>
                <div class="surface-list"><span class="detail-label">Where it appears</span><p>{principle.where.map((item) => <span>{item}</span>)}</p></div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="checklist rd-section" id="checklist" aria-labelledby="checklist-title">
      <div class="rd-container">
        <div class="section-head reveal">
          <div>
            <p class="rd-kicker"><span class="kdot kdot--mint"></span>Implementation checklist</p>
            <h2 class="rd-h2" id="checklist-title">Exactly where each promise shows up.</h2>
          </div>
          <p>No “AI-powered learning” fog. This is the product audit.</p>
        </div>

        <div class="audit-wrap reveal" role="region" aria-label="Learning science implementation checklist" tabindex="0">
          <table>
            <thead><tr><th>Principle</th><th>In the study flow</th><th>In the model</th><th>Status</th></tr></thead>
            <tbody>
              {principles.map((principle) => (
                <tr>
                  <th scope="row"><a href={`#${principle.id}`}>{principle.title}</a></th>
                  <td>{principle.where.join(' · ')}</td>
                  <td>{principle.product}</td>
                  <td><span class:list={['status', `status--${principle.status}`]}>{principle.statusLabel}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

      </div>
    </section>

    <section class="boundaries rd-section" id="boundaries" aria-labelledby="boundaries-title">
      <div class="rd-container">
        <div class="section-head reveal">
          <div>
            <p class="rd-kicker"><span class="kdot"></span>Deliberately outside the product</p>
            <h2 class="rd-h2" id="boundaries-title">What we leave to <span class="rd-em">you</span> on purpose.</h2>
          </div>
          <p>Good study practice is wider than software. These ideas still matter; Studyus simply does not claim to automate the judgment, environment, or recovery they require.</p>
        </div>

        <div class="boundary-note reveal">
          <span aria-hidden="true">↳</span>
          <p><strong>Not ignored because they are unimportant.</strong> Left outside because turning them into a score, shortcut, or AI-generated answer could remove the very thinking—or autonomy—that makes them useful.</p>
        </div>

        <ol class="boundary-grid">
          {boundaries.map((boundary, index) => (
            <li class="boundary-card reveal" style={`--reveal-delay: ${(index % 3) * 55}ms`}>
              <div class="boundary-topline">
                <span>{boundary.number}</span>
                <small>Student-owned</small>
              </div>
              <h3>{boundary.title}</h3>
              <div class="boundary-copy">
                <div>
                  <span class="boundary-label">Useful practice</span>
                  <p>{boundary.practice}</p>
                </div>
                <div>
                  <span class="boundary-label boundary-label--limit">Studyus boundary</span>
                  <p>{boundary.boundary}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="evidence rd-section" id="evidence" aria-labelledby="evidence-title">
      <div class="rd-container">
        <div class="evidence-intro reveal">
          <p class="rd-kicker"><span class="kdot kdot--orange"></span>Evidence & limits</p>
          <h2 class="rd-h2" id="evidence-title">Built from findings, not miracle claims.</h2>
          <p>Learning research describes tendencies across people and contexts. It does not guarantee an outcome for one student, and implementation details matter. These are the core sources behind the design.</p>
        </div>

        <ol class="references">
          {references.map((reference, index) => (
            <li class="reference reveal" style={`--reveal-delay: ${(index % 3) * 60}ms`}>
              <span class="reference-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{reference.title}</h3>
                <p class="reference-authors">{reference.authors}</p>
                <p>{reference.note}</p>
                <a href={reference.href} target="_blank" rel="noreferrer">Read the source <span aria-hidden="true">↗</span></a>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="final-cta">
      <div class="rd-container final-inner reveal">
        <p class="rd-kicker">From principle to practice</p>
        <h2>Spend less time managing study. Spend more time <em class="rd-em">actually learning.</em></h2>
        <p>Try the full loop with a ready-made sample semester. No account or credit card required.</p>
        <div class="final-actions">
          <a class="rd-btn rd-btn-primary" href="/try">Try the sample semester</a>
          <a class="rd-btn rd-btn-ghost" href="/sign-up">Create your Studyus account</a>
        </div>
      </div>
    </section>
  </div>
</MarketingLayout>

<script>
  function openLinkedPrinciple() {
    const id = decodeURIComponent(window.location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) target.open = true;
  }

  openLinkedPrinciple();
  window.addEventListener('hashchange', openLinkedPrinciple);
</script>

<style>
  .how-page { overflow: clip; }
  .loop, .principles, .checklist, .boundaries, .evidence { scroll-margin-top: 64px; }
  .how-hero { position: relative; z-index: 2; padding-block: clamp(72px, 10vw, 124px) 42px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, .94fr) minmax(400px, .72fr); gap: clamp(44px, 8vw, 108px); align-items: center; }
  .kdot { width: 8px; height: 8px; border-radius: 50%; background: var(--rd-accent); box-shadow: 0 0 0 4px oklch(65% .2 2 / .16); }
  .kdot--grape { background: var(--rd-grape); box-shadow: 0 0 0 4px oklch(58% .19 300 / .14); }
  .kdot--mint { background: oklch(62% .14 155); box-shadow: 0 0 0 4px oklch(62% .14 155 / .14); }
  .kdot--orange { background: oklch(68% .16 55); box-shadow: 0 0 0 4px oklch(68% .16 55 / .14); }
  .hero-copy h1 { margin-top: 22px; max-width: 12ch; font-size: clamp(43px, 6.8vw, 78px); line-height: .98; text-wrap: balance; }
  .hero-lead { max-width: 55ch; margin-top: 28px; color: var(--rd-ink-soft); font-size: clamp(17px, 1.75vw, 20px); font-weight: 650; line-height: 1.6; }
  .hero-actions, .final-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .decision-card { position: relative; padding: clamp(24px, 3vw, 34px); border: 1.5px solid oklch(52% .06 305 / .18); border-radius: 30px; background: oklch(100% 0 0 / .72); box-shadow: 0 30px 70px -35px oklch(40% .12 305 / .55); backdrop-filter: blur(16px); transform: rotate(1deg); }
  .decision-card::before { content: ''; position: absolute; inset: 10px -12px -14px 16px; z-index: -1; border: 1.5px solid oklch(65% .2 2 / .22); border-radius: inherit; background: oklch(93% .055 12 / .62); transform: rotate(-3deg); }
  .decision-top, .decision-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .decision-label { padding: 7px 12px; border-radius: 999px; color: var(--rd-on-accent); background: var(--rd-accent); font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .decision-time, .decision-course { color: var(--rd-ink-faint); font-size: 11px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .decision-course { margin-top: 26px; color: var(--rd-grape); }
  .decision-card h2 { margin-top: 6px; font-size: clamp(27px, 3.3vw, 38px); line-height: 1.04; }
  .reason-stack { display: grid; gap: 0; margin-top: 26px; border-block: 1px solid oklch(52% .06 305 / .13); }
  .reason-stack > span { display: grid; grid-template-columns: 10px 96px 1fr; align-items: center; gap: 9px; padding-block: 11px; border-bottom: 1px solid oklch(52% .06 305 / .09); }
  .reason-stack > span:last-child { border-bottom: 0; }
  .reason-icon { width: 8px; height: 8px; border-radius: 50%; }
  .reason-icon--rose { background: var(--rd-accent); } .reason-icon--grape { background: var(--rd-grape); } .reason-icon--mint { background: oklch(62% .14 155); } .reason-icon--orange { background: oklch(68% .16 55); }
  .reason-stack b { font-size: 12px; } .reason-stack small { color: var(--rd-ink-soft); font-size: 12px; font-weight: 700; }
  .decision-footer { align-items: flex-end; margin-top: 20px; }
  .decision-footer span { color: var(--rd-ink-faint); font-size: 10px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .decision-footer strong { max-width: 19ch; color: var(--rd-accent-deep); font-size: 12px; text-align: right; }

