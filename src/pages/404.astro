---
import AppShell from '../layouts/AppShell.astro';

Astro.response.status = 404;
---
<AppShell title="Not found">
  <div class="not-found-wrap">
    <div class="card not-found">
      <p class="eyebrow" aria-hidden="true">404</p>
      <h1>Not on the syllabus.</h1>
      <p>Whatever this pointed to — a course, a concept, a note — doesn't exist, or isn't yours. Nothing to fix here, just a wrong turn.</p>
      <a class="btn-cta" href="/dashboard">Back to dashboard</a>
    </div>
  </div>
</AppShell>

<style>
  .not-found-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(60vh, 480px);
    padding: 2rem 0;
  }
  .not-found {
    max-width: 440px;
    text-align: center;
    animation: card-enter 420ms var(--ease) both;
  }
  .eyebrow {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 1.1rem;
    color: var(--accent-ink);
    margin: 0 0 0.6rem;
  }
  .not-found h1 {
    font-size: 1.6rem;
    letter-spacing: -0.015em;
    margin: 0 0 0.6rem;
  }
  .not-found p:not(.eyebrow) { color: var(--muted); margin: 0 0 1.6rem; }
  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.92rem;
    font-weight: var(--weight-semi);
    color: var(--accent-contrast, var(--surface));
    background: var(--accent);
    text-decoration: none;
    border-radius: 999px;
    padding: 0.7rem 1.6rem;
    box-shadow: var(--accent-glow, none);
    transition: transform var(--motion-fast) var(--ease-bounce, var(--ease)), filter var(--motion-base) var(--ease);
  }
  .btn-cta:hover { filter: brightness(0.96); transform: translateY(-1px); }
  .btn-cta:active { transform: translateY(1px); }

  @media (prefers-reduced-motion: reduce) {
    .not-found { animation: none; }
  }
  @keyframes card-enter {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
