---
import AppShell from '../layouts/AppShell.astro';
import { env } from 'cloudflare:workers';
import { getDb } from '../db/client';
import { eq, inArray } from 'drizzle-orm';
import { courses, kcs } from '../db/schema';
import { getProfile } from '../lib/services/profile';
import { getGlobalFrontier } from '../lib/services/zpd';
import { listCapabilities, getMetaSkills } from '../lib/services/capabilities';
import { toApi } from '../lib/serialize';
import StandingCard from '../components/profile/StandingCard.astro';
import MasteryByCourse from '../components/profile/MasteryByCourse.astro';
import ConceptsByStatus from '../components/profile/ConceptsByStatus.astro';
import RecentActivitySection from '../components/profile/RecentActivitySection.astro';
import CapabilitiesPanel from '../components/profile/CapabilitiesPanel.svelte';
import FrontierPanel from '../components/profile/FrontierPanel.svelte';
import RitualsPanel from '../components/profile/RitualsPanel.svelte';
import type { CapabilityResponse, MetaSkill } from '../lib/schemas/capabilities';
import type { FrontierResponse } from '../lib/schemas/zpd';
import type { RitualResponse } from '../lib/schemas/rituals';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;

const profile = await getProfile(db, userId);

const userCourses = await db.select({ id: courses.id, slug: courses.slug }).from(courses).where(eq(courses.userId, userId));
const courseIds = userCourses.map((c) => c.id);
const slugByCourse = new Map(userCourses.map((c) => [c.id, c.slug]));

const statusCounts: Record<string, number> = { 'not-started': 0, learning: 0, review: 0, mastered: 0 };
if (courseIds.length > 0) {
  const allKcs = await db.select({ status: kcs.status }).from(kcs).where(inArray(kcs.courseId, courseIds));
  for (const kc of allKcs) {
    statusCounts[kc.status] = (statusCounts[kc.status] ?? 0) + 1;
  }
}
const totalKcs = Object.values(statusCounts).reduce((a, b) => a + b, 0);

// toApi converts service rows (camelCase) to the wire shape the panel's
// CapabilityResponse props are typed against (kc_id/course_id members).
const capabilities: CapabilityResponse[] = toApi(await listCapabilities(db, userId)) as unknown as CapabilityResponse[];
const metaSkills: MetaSkill[] = await getMetaSkills(db, userId);
const frontier: FrontierResponse = await getGlobalFrontier(db, userId);
// TODO(track-c): wire listRitualsWithAdherence (src/lib/services/rituals.ts).
const rituals: RitualResponse[] | null = null;
---
<AppShell title="Profile">
  <h1>Profile</h1>

  <StandingCard overallMastery={profile.overall_mastery} currentStreak={profile.current_streak} longestStreak={profile.longest_streak} />

  <CapabilitiesPanel client:visible capabilities={capabilities} metaSkills={metaSkills} />

  <FrontierPanel client:visible frontier={frontier} />

  <RitualsPanel client:visible rituals={rituals} />

  <div class="cols">
    <MasteryByCourse byCourse={profile.by_course} slugByCourse={slugByCourse} />
    <ConceptsByStatus statusCounts={statusCounts} totalKcs={totalKcs} />
  </div>

  <RecentActivitySection />
</AppShell>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1.5rem; }
  @media (max-width: 860px) { .cols { grid-template-columns: minmax(0, 1fr); } }
</style>
