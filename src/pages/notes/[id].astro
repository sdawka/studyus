---
import { env } from 'cloudflare:workers';
import AppShell from '../../layouts/AppShell.astro';
import { getDb } from '../../db/client';
import { getNote } from '../../lib/services/notes';
import { getCourseBySlug, listCourses } from '../../lib/services/courses';
import { toApi } from '../../lib/serialize';
import { NotFoundError, notFound } from '../../lib/handleNotFound';
import NoteEditor from '../../components/notes/NoteEditor.svelte';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const db = getDb(env.DB);
const { id } = Astro.params;

if (!id) return notFound(Astro);

let note;
try {
  note = await getNote(db, user.id, id);
} catch (err) {
  if (err instanceof NotFoundError) return notFound(Astro);
  throw err;
}

const courses = await listCourses(db, user.id);

// Get KCs for each course
const coursesWithKcs = await Promise.all(
  courses.map(async (course) => {
    const courseDetail = await getCourseBySlug(db, user.id, course.slug);
    return {
      id: course.id,
      code: course.code,
      title: course.title,
      kcs: courseDetail.branches.flatMap((b) => b.kcs),
    };
  }),
);

const apiNote = toApi(note);
---

<AppShell title={`${note.title}`}>
  <h1>{note.title}</h1>
  <NoteEditor client:load note={apiNote} coursesWithKcs={coursesWithKcs} noteId={id} />
</AppShell>
