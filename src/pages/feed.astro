---
import { env } from 'cloudflare:workers';
import AppShell from '../layouts/AppShell.astro';
import { getDb } from '../db/client';
import { listResources } from '../lib/services/resources';
import { listCourses } from '../lib/services/courses';
import ShareResourceForm from '../components/feed/ShareResourceForm.svelte';
import StudySessionStub from '../components/feed/StudySessionStub.svelte';
import ResourceCard from '../components/feed/ResourceCard.svelte';

const db = getDb(env.DB);
const userId = Astro.locals.user!.id;

const courses = await listCourses(db, userId);
const allResources = await listResources(db, userId, {});

// Separate by kind and sort pinned first
const feedResources = allResources
  .filter((r) => r.kind === 'feed' || r.kind === 'user_shared')
  .sort((a, b) => {
    if (a.pinned && !b.pinned) return -1;
    if (!a.pinned && b.pinned) return 1;
    return (b.createdAt ?? 0) - (a.createdAt ?? 0);
  });

const canonicalResources = allResources
  .filter((r) => r.kind === 'canonical')
  .sort((a, b) => {
    if (a.pinned && !b.pinned) return -1;
    if (!a.pinned && b.pinned) return 1;
    return (b.createdAt ?? 0) - (a.createdAt ?? 0);
  });

---

<AppShell title="Feed">
  <div class="feed-container">
    <div class="feed-header">
      <h1>Feed</h1>
      <p class="feed-purpose">
        Browse curated learning resources and links shared by your community. Low-key learning at your own pace.
      </p>
    </div>

    <div class="feed-content">
      <div class="feed-main">
        <div class="share-section">
          <ShareResourceForm courses={courses} client:load />
        </div>

        <div class="resources-section">
          <div class="filter-bar" id="filter-bar" role="group" aria-label="Filter by course">
            <button type="button" class="chip" data-course-filter="" aria-pressed="true">All</button>
            {courses.map((course) => (
              <button
                type="button"
                class="chip chip-course"
                data-course-filter={course.id}
                aria-pressed="false"
                style={`--course-h:${course.color ?? 220}`}
              >
                {course.code || course.title}
              </button>
            ))}
          </div>

          <div class="resource-masonry" id="resource-stream">
            {feedResources.map((resource) => (
              <ResourceCard resource={resource} course={courses.find((c) => c.id === resource.courseId)} client:load />
            ))}
          </div>

          {canonicalResources.length > 0 && (
            <details class="canonical-section" open={false}>
              <summary>Course materials ({canonicalResources.length})</summary>
              <div class="resource-masonry">
                {canonicalResources.map((resource) => (
                  <ResourceCard resource={resource} course={courses.find((c) => c.id === resource.courseId)} client:load />
                ))}
              </div>
            </details>
          )}
        </div>

        <div class="study-session-section">
          <StudySessionStub />
        </div>
      </div>
    </div>
  </div>
</AppShell>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBar = document.getElementById('filter-bar');
    const stream = document.getElementById('resource-stream');
    const chips = filterBar ? Array.from(filterBar.querySelectorAll<HTMLElement>('[data-course-filter]')) : [];

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const selectedCourse = chip.dataset.courseFilter || '';

        chips.forEach((c) => c.setAttribute('aria-pressed', c === chip ? 'true' : 'false'));

        const cards = stream?.querySelectorAll<HTMLElement>('[data-resource-id]');
        cards?.forEach((card) => {
          const cardCourse = card.dataset.courseId || '';
          card.style.display = !selectedCourse || cardCourse === selectedCourse ? '' : 'none';
        });
      });
    });
  });
</script>

<style>
  .feed-container {
    width: 100%;
  }

  .feed-header {
    margin-bottom: 2rem;
  }

  .feed-header h1 {
    margin: 0 0 0.5rem 0;
  }

  .feed-purpose {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .feed-main {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .share-section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .resources-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-bar .chip-course[aria-pressed='true'] {
    background: var(--course);
    border-color: var(--course);
    color: var(--surface);
  }

  .resource-masonry {
    columns: 5 240px;
    column-gap: 16px;
    width: 100%;
  }

  .resource-masonry > * {
    break-inside: avoid;
    margin-bottom: 16px;
    display: inline-block;
    width: 100%;
  }

  /* Queries the AppShell <main> content container, not the viewport,
     so this fires based on actual available width in both sidebar
     states rather than the raw window size. 540px minus main's 64px
     horizontal padding — @container measures content-box, so the
     written value must subtract that padding to land the breakpoint
     where main's own rendered width actually crosses 540px. */
  @container (max-width: 476px) {
    .resource-masonry {
      columns: 1;
    }
  }

  .canonical-section {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .canonical-section summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--accent);
    padding: 0.5rem;
    margin-left: -0.5rem;
  }

  .canonical-section summary:hover {
    text-decoration: underline;
  }

  .study-session-section {
    margin-top: 1rem;
  }
</style>
