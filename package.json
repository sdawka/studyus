{
  "name": "studyus",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "deploy:demo": "PUBLIC_DOCS_OVERLAY=true astro build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply studyus --local",
    "db:migrate:remote": "wrangler d1 migrations apply studyus --remote",
    "db:seed": "tsx scripts/seed.ts",
    "test:e2e:auth": "playwright test --project=setup",
    "test:e2e": "playwright test --project=authenticated",
    "test:e2e:visual": "playwright test --project=visual",
    "test": "vitest run",
    "check:types": "wrangler types && astro check",
    "check:layout": "node scripts/layout-check.cjs",
    "check:annotations": "node scripts/annotations-check.cjs",
    "check": "npm run check:types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "~14.2.0",
    "@astrojs/svelte": "~9.0.0",
    "@clerk/astro": "^4.0.17",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "~7.2.0",
    "drizzle-orm": "0.45.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "mammoth": "^1.12.1",
    "nanostores": "^1.4.2",
    "pdfjs-dist": "^6.2.108",
    "svelte": "~5.56.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@clerk/backend": "^3.16.10",
    "@clerk/testing": "^2.2.23",
    "@cloudflare/vitest-pool-workers": "~0.21.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.2.2",
    "drizzle-kit": "0.31.1",
    "svelte-check": "^4.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.83.0"
  }
}
